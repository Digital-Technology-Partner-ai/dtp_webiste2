#!/usr/bin/env python3
"""
Prepare a newsroom article for publish:
- remove draft boilerplate
- ensure description is not the default draft text
- ensure the article has a practical ending section, not a DTP-centred sales section

This script must not inject a stock closing CTA. The article ending should stay specific to
the story being reviewed.
"""

from __future__ import annotations

import argparse
import re
from pathlib import Path

DEFAULT_DESCRIPTION = "Draft generated from newsroom shortlist."
PRACTICAL_SECTION_TITLE = "## Why this matters in practice"
PRACTICAL_SECTION_BODY = (
    "The practical question is whether the business process still knows what to do "
    "if the preferred model, provider, or workflow becomes unavailable."
)
DRAFT_FOOTER = "*AI-assisted draft. Human review and approval required before publish.*"
APPROVAL_LINE_PATTERN = r"^\s*Human-?approved by .*?$"
STOCK_CTA_TITLE = "## Pressure-test your AI dependencies"
STOCK_CTA_BODY = (
    "If AI is becoming part of your operating stack, let’s pressure-test the risks, "
    "dependencies and fallback options."
)


def load_frontmatter(text: str) -> dict[str, str]:
    m = re.search(r"^---\n(.*?)\n---\n", text, re.DOTALL)
    if not m:
        return {}
    fm = m.group(1)
    out: dict[str, str] = {}
    for line in fm.splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        out[key.strip()] = value.strip().strip('"')
    return out


def replace_description(text: str, title: str) -> str:
    replacement = f"{title} — practical guidance for technology leaders in 2026."
    pattern = r'^description:\s*"[^"]*"'
    return re.sub(pattern, f'description: "{replacement}"', text, flags=re.MULTILINE)


def remove_draft_footer(text: str) -> str:
    # remove trailing footer block if present
    text = re.sub(r"\n---\n\n\*AI-assisted draft\. Human review and approval required before publish\.\*\n?", "\n", text)
    # also remove standalone footer if present
    text = text.replace(DRAFT_FOOTER, "")
    # remove any approval line accidentally left in body text
    text = re.sub(APPROVAL_LINE_PATTERN, "", text, flags=re.MULTILINE)
    return text.strip() + "\n"


def ensure_practical_section(text: str) -> str:
    text = text.replace("## Why this matters to Digital Technology Partner", PRACTICAL_SECTION_TITLE)
    if PRACTICAL_SECTION_TITLE not in text:
        text = text.rstrip() + f"\n\n{PRACTICAL_SECTION_TITLE}\n\n{PRACTICAL_SECTION_BODY}\n"
    return text


def remove_stock_cta(text: str) -> str:
    pattern = re.escape(STOCK_CTA_TITLE) + r"\n\n" + re.escape(STOCK_CTA_BODY) + r"\n?"
    return re.sub(pattern, "", text).rstrip() + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description="Prepare newsroom article for publish")
    parser.add_argument("--file", required=True, help="Path to article markdown")
    args = parser.parse_args()

    path = Path(args.file)
    if not path.exists():
        raise SystemExit(f"File not found: {path}")

    text = path.read_text(encoding="utf-8")
    fm = load_frontmatter(text)
    title = fm.get("title", path.stem)

    if DEFAULT_DESCRIPTION in text:
        text = replace_description(text, title)

    text = remove_draft_footer(text)
    text = ensure_practical_section(text)
    text = remove_stock_cta(text)

    path.write_text(text, encoding="utf-8")
    print(f"Prepared for publish: {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

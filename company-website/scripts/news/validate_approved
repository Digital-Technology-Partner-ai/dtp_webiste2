#!/usr/bin/env python3
"""
Validate approved newsroom articles have required governance metadata.
"""

from __future__ import annotations

from pathlib import Path
import re

PLACEHOLDER_MARKERS = [
    'Add practical context for operators and decision-makers.',
    '- Change 1',
    '- Change 2',
    '- Change 3',
    '1. Action one',
    '2. Action two',
    '3. Action three',
]


def field(text: str, name: str) -> str | None:
    m = re.search(rf'^{name}:\s*(.+)$', text, re.MULTILINE)
    return m.group(1).strip() if m else None


def has_placeholder_scaffold(text: str) -> bool:
    return any(marker in text for marker in PLACEHOLDER_MARKERS)


def main() -> int:
    news_dir = Path('src/content/news')
    problems: list[str] = []

    for md in sorted(news_dir.glob('*.md')):
        text = md.read_text(encoding='utf-8')
        approved = field(text, 'approved')
        if approved != 'true':
            continue

        for required in ['source', 'approvedBy', 'approvedAt', 'description']:
            if not field(text, required):
                problems.append(f'{md.name}: missing {required}')

        if 'Draft generated from newsroom shortlist.' in text:
            problems.append(f'{md.name}: default draft description still present')

        if '*AI-assisted draft. Human review and approval required before publish.*' in text:
            problems.append(f'{md.name}: draft footer still present')

        if '## Why this matters to Digital Technology Partner' not in text:
            problems.append(f'{md.name}: missing DTP context section')

        if has_placeholder_scaffold(text):
            problems.append(f'{md.name}: placeholder scaffold text still present')

    if problems:
        print('Approved article validation FAILED:')
        for p in problems:
            print('-', p)
        return 1

    print('Approved article validation PASSED')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

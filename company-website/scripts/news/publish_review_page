def credentials_path() -> Path:
    override = os.environ.get("HERENOW_CREDENTIALS_PATH")
    return Path(override) if override else DEFAULT_CREDENTIALS_PATH


def read_api_key(path: Path) -> str:
    if not path.exists():
        raise FileNotFoundError(f"here.now credentials file not found: {path}")
    text = path.read_text(encoding="utf-8").strip()
    if not text:
        raise ValueError(f"here.now credentials file is empty: {path}")
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        if "=" in line:
            key, value = line.split("=", 1)
            if "key" in key.lower() or "token" in key.lower():
                return value.strip()
        if ":" in line:
            key, value = line.split(":", 1)
            if "key" in key.lower() or "token" in key.lower():
                return value.strip()
    return text.splitlines()[-1].strip()


def http_json(url: str, *, method: str, headers: dict[str, str], data: dict[str, Any]) -> dict[str, Any]:
    req = request.Request(
        url,
        data=json.dumps(data).encode("utf-8"),
        method=method,
        headers=headers,
    )
    with request.urlopen(req, timeout=120) as response:
        return json.loads(response.read().decode("utf-8"))


def load_publish_state(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    return json.loads(path.read_text(encoding="utf-8"))


def save_publish_state(path: Path, payload: dict[str, Any]) -> None:
    path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")


def publish_html(slug_hint: str, html_path: Path, api_key: str, state_path: Path) -> tuple[str, str]:
    content = html_path.read_bytes()
    content_type = mimetypes.guess_type(html_path.name)[0] or "text/html"
    if "charset=" not in content_type:
        content_type = f"{content_type}; charset=utf-8"
    headers = {
        "Authorization": f"Bearer {api_key}",
        "X-HereNow-Client": CLIENT_HEADER,
        "Content-Type": "application/json",
        "User-Agent": CLIENT_HEADER,
    }
    state = load_publish_state(state_path)
    live_slug = str(state.get("live_slug") or "").strip()
    payload = {
        "files": [
            {
                "path": html_path.name,
                "size": len(content),
                "contentType": content_type,
                "hash": hashlib.sha256(content).hexdigest(),
            }
        ]
    }
    if live_slug:
        publish = http_json(
            f"https://here.now/api/v1/publish/{live_slug}",
            method="PUT",
            headers=headers,
            data=payload,
        )
    else:
        publish = http_json(
            "https://here.now/api/v1/publish",
            method="POST",
            headers=headers,
            data={**payload, "slug": slug_hint},
        )
        live_slug = str(publish.get("slug") or "").strip()
        if not live_slug:
            raise RuntimeError("here.now create response did not include a slug")
    upload = publish.get("upload") or {}
    uploads = upload.get("uploads") or []
    skipped = upload.get("skipped") or []
    if not uploads and not skipped:
        raise RuntimeError("here.now publish response did not include upload instructions")
    for item in uploads:
        upload_headers = dict(item.get("headers") or {})
        upload_headers.setdefault("Content-Type", content_type)
        upload_request = request.Request(
            item["url"],
            data=content,
            method=item.get("method", "PUT"),
            headers=upload_headers,
        )
        with request.urlopen(upload_request, timeout=120) as response:
            response.read()
    finalize_url = upload.get("finalizeUrl")
    version_id = upload.get("versionId")
    if not finalize_url or not version_id:
        raise RuntimeError("here.now publish response missing finalizeUrl or versionId")
    finalized = http_json(
        finalize_url,
        method="POST",
        headers=headers,
        data={"versionId": version_id},
    )
    site_url = finalized.get("siteUrl") or publish.get("siteUrl") or f"https://{live_slug}.here.now/"
    verify_request = request.Request(site_url, headers={"User-Agent": CLIENT_HEADER})
    with request.urlopen(verify_request, timeout=120) as response:
        if response.status != 200:
            raise RuntimeError(f"Review page verification returned HTTP {response.status}")
        response.read()
    save_publish_state(
        state_path,
        {
            "slug_hint": slug_hint,
            "live_slug": live_slug,
            "site_url": site_url,
            "article_stem": html_path.parent.name,
        },
    )
    return site_url, live_slug


def run_guard(slug: str) -> None:
    result = subprocess.run(
        [
            sys.executable,
            str(GUARD_SCRIPT),
            "--root",
            str(WORK_ROOT),
            "--check-text",
            f"publish standalone here.now review slug {slug}",
        ],
        cwd=WORK_ROOT,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout).strip() or "Production-domain guard failed")


def main() -> int:
    parser = argparse.ArgumentParser(description="Publish standalone here.now review page for newsroom article")
    parser.add_argument("--file", required=True, help="Path to article markdown")
    parser.add_argument("--dry-run", action="store_true", help="Render and stage review page locally without calling here.now API")
    args = parser.parse_args()

    article_path = Path(args.file)
    if not article_path.is_absolute():
        article_path = (Path.cwd() / article_path).resolve()
    if not article_path.exists():
        print(f"File not found: {article_path}", file=sys.stderr)
        return 1

    try:
        raw_text = article_path.read_text(encoding="utf-8")
        frontmatter_block, body = split_frontmatter(raw_text)
        frontmatter = parse_frontmatter(frontmatter_block)
        slug = derive_review_slug(article_path)
        run_guard(slug)
        output_dir = OUTPUT_ROOT / article_path.stem
        output_dir.mkdir(parents=True, exist_ok=True)
        html_path = output_dir / "index.html"
        state_path = output_dir / "publish-state.json"
        review_html = build_review_html(article_path, frontmatter, body)
        html_path.write_text(review_html, encoding="utf-8")
        print(f"Review HTML: {html_path}")
        if args.dry_run:
            print(f"Review dry run URL: https://{slug}.here.now/")
            return 0
        api_key = read_api_key(credentials_path())
        site_url, live_slug = publish_html(slug, html_path, api_key, state_path)
        print(f"Review slug: {live_slug}")
        print(f"Review live: {site_url}")
        return 0
    except (ValueError, FileNotFoundError, RuntimeError, error.HTTPError, error.URLError) as exc:
        print(f"Review publish failed: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

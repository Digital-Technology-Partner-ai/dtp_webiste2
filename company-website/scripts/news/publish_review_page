CTA_SECTION_TITLE = "Pressure-test your AI dependencies"


def slugify(text: str) -> str:
    text = text.lower()
    text = re.sub(r"[^a-z0-9]+", "-", text)
    return re.sub(r"-+", "-", text).strip("-")


def derive_review_slug(article_path: Path) -> str:
    stem = article_path.stem
    stem_slug = slugify(stem)
    hash_suffix = hashlib.sha1(stem.encode("utf-8")).hexdigest()[:8]
    trimmed = stem_slug[:44].rstrip("-")
    return f"review-{trimmed}-{hash_suffix}"


def split_frontmatter(text: str) -> tuple[str, str]:
    match = re.match(r"^---\n(.*?)\n---\n\n?(.*)\Z", text, re.DOTALL)
    if not match:
        raise ValueError("Article is missing valid frontmatter block")
    return match.group(1), match.group(2).strip()


def parse_frontmatter(block: str) -> dict[str, Any]:
    data: dict[str, Any] = {}
    current_key: str | None = None
    for raw_line in block.splitlines():
        line = raw_line.rstrip()
        if not line.strip():
            continue
        if re.match(r"^\s+-\s+", line) and current_key:
            data.setdefault(current_key, []).append(re.sub(r"^\s+-\s+", "", line).strip().strip('"'))
            continue
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        current_key = key.strip()
        value = value.strip()
        if not value:
            data[current_key] = []
        elif value in {"true", "false"}:
            data[current_key] = value == "true"
        else:
            data[current_key] = value.strip('"')
    return data


def inline_markdown(text: str) -> str:
    escaped = html.escape(text)
    escaped = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", escaped)
    escaped = re.sub(r"`([^`]+)`", r"<code>\1</code>", escaped)
    return escaped


def render_body_sections(body: str) -> tuple[str, str]:
    lines = body.splitlines()
    main_lines: list[str] = []
    cta_heading: str | None = None
    cta_lines: list[str] = []
    in_cta = False

    for raw_line in lines:
        if raw_line.startswith("## ") and raw_line[3:].strip() == CTA_SECTION_TITLE:
            in_cta = True
            cta_heading = raw_line[3:].strip()
            continue
        if in_cta:
            cta_lines.append(raw_line)
        else:
            main_lines.append(raw_line)

    def markdown_lines_to_html(source_lines: list[str]) -> str:
        parts: list[str] = []
        in_ul = False
        in_ol = False
        for raw in source_lines:
            line = raw.rstrip()
            if not line.strip():
                if in_ul:
                    parts.append("</ul>")
                    in_ul = False
                if in_ol:
                    parts.append("</ol>")
                    in_ol = False
                continue
            if line.startswith("## "):
                if in_ul:
                    parts.append("</ul>")
                    in_ul = False
                if in_ol:
                    parts.append("</ol>")
                    in_ol = False
                parts.append(f"<h2>{inline_markdown(line[3:].strip())}</h2>")
            elif re.match(r"^-\s+", line):
                item = re.sub(r"^-\s+", "", line)
                if in_ol:
                    parts.append("</ol>")
                    in_ol = False
                if not in_ul:
                    parts.append("<ul>")
                    in_ul = True
                parts.append(f"<li>{inline_markdown(item)}</li>")
            elif re.match(r"^\d+\.\s+", line):
                item = re.sub(r"^\d+\.\s+", "", line)
                if in_ul:
                    parts.append("</ul>")
                    in_ul = False
                if not in_ol:
                    parts.append("<ol>")
                    in_ol = True
                parts.append(f"<li>{inline_markdown(item)}</li>")
            else:
                if in_ul:
                    parts.append("</ul>")
                    in_ul = False
                if in_ol:
                    parts.append("</ol>")
                    in_ol = False
                parts.append(f"<p>{inline_markdown(line)}</p>")
        if in_ul:
            parts.append("</ul>")
        if in_ol:
            parts.append("</ol>")
        return "".join(parts)

    body_html = markdown_lines_to_html(main_lines)
    cta_html = ""
    if cta_heading:
        cta_paragraphs = "".join(
            f"<p>{inline_markdown(line)}</p>" for line in cta_lines if line.strip()
        )
        cta_html = (
            '<section class="cta-panel" aria-label="Article call to action">'
            f"<div><h2>{inline_markdown(cta_heading)}</h2>{cta_paragraphs}</div>"
            "</section>"
        )
    return body_html, cta_html


def build_review_html(article_path: Path, frontmatter: dict[str, Any], body: str) -> str:

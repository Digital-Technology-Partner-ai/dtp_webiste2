#!/usr/bin/env python3
"""
Generate a newsroom draft markdown file from a shortlisted topic id.
"""

from __future__ import annotations

import argparse
import json
import re
import secrets
from pathlib import Path

ALLOWED_CATEGORIES = {
    'AI',
    'Digital Transformation',
    'Automation',
    'Operations',
    'Strategy',
}
CATEGORY_MAP = {
    'Security': 'Strategy',
}
CATEGORY_LENSES = {
    'AI': 'AI delivery, governance and operating-model decisions',
    'Automation': 'automation priorities, handoffs and delivery risk',
    'Operations': 'operating resilience, workflow design and execution pressure',
    'Strategy': 'governance, supplier dependence and leadership decision-making',
    'Digital Transformation': 'change sequencing, ownership and adoption choices',
}


def slugify(value: str) -> str:
    value = value.lower().strip()
    value = re.sub(r"[^a-z0-9\s-]", "", value)
    value = re.sub(r"\s+", "-", value)
    return re.sub(r"-+", "-", value)


def existing_titles(news_dir: Path) -> set[str]:
    titles: set[str] = set()
    for md in news_dir.glob('*.md'):
        text = md.read_text(encoding='utf-8')
        m = re.search(r'^title:\s*"([^"]+)"', text, re.MULTILINE)
        if m:
            titles.add(m.group(1).strip().lower())
    return titles


def normalise_category(raw_category: str) -> str:
    category = CATEGORY_MAP.get(raw_category, raw_category)
    if category not in ALLOWED_CATEGORIES:
        return 'AI'
    return category


def clean_topic_title(raw_title: str) -> str:
    title = re.sub(r"\s+", " ", raw_title.strip())
    if ' - ' in title:
        parts = [part.strip() for part in title.split(' - ') if part.strip()]
        if len(parts) >= 2:
            trailing = parts[-1]
            has_truncation = '…' in title or '...' in title
            if '…' in trailing or '...' in trailing or (len(trailing.split()) <= 4 and has_truncation):
                title = ' - '.join(parts[:-1]).strip()
    title = title.rstrip(' .…')
    return title


def build_description(title: str, category: str) -> str:
    lens = CATEGORY_LENSES.get(category, CATEGORY_LENSES['AI'])
    return f"{title} highlights fresh questions about {lens} for technology leaders."


def build_body(title: str, category: str) -> str:
    lens = CATEGORY_LENSES.get(category, CATEGORY_LENSES['AI'])
    return f"""## Why this story matters

{title} is not just another AI headline. It is an early signal about how quickly questions around {lens} are moving into ordinary business decisions.

Leaders do not need every market update. They do need the ones that show where delivery risk, supplier dependence, control, or governance pressure is becoming more concrete. This is one of those stories.

## What stands out

The important point is not the headline on its own. It is what the headline suggests about the next layer of operational reality. When a story points directly at {lens}, it usually means the market is starting to spend money, assign ownership, and expose weaknesses that were easier to ignore while AI stayed in pilot mode.

That is why this belongs on a leadership agenda. It is not mainly a technology novelty story. It is a signal that operating choices around tooling, workflow design, access control, fallback planning, and supplier exposure are getting more real.

## What leaders should take from this

The practical response is not to lurch into a new buying cycle every time the market moves. It is to ask where the same pressure could show up inside your own stack, partner set, or delivery model.

For some teams, that may mean tightening governance before agentic or automated workflows spread further. For others, it may mean clarifying ownership, defining fallback routes, or deciding which risks are acceptable before a tool or vendor becomes embedded in day-to-day work.

## Why this matters in practice

The useful question is simple: if this market signal became a real operational issue inside your business, would the process still know what to do? If the answer is unclear, the work is not mature yet.

## Pressure-test your AI dependencies

If AI is becoming part of your operating stack, let’s pressure-test the risks, dependencies and fallback options.
"""


def load_shortlist(path: Path) -> dict:
    payload = json.loads(path.read_text(encoding="utf-8"))
    topics = payload.get("topics")
    if not isinstance(topics, list) or not topics:
        raise SystemExit(f"Malformed shortlist: {path}")

    for topic in topics:
        if not all(key in topic for key in ("id", "title", "category", "source")):
            raise SystemExit(f"Malformed shortlist topic in: {path}")

    if "date" not in payload:
        raise SystemExit(f"Malformed shortlist: missing date in {path}")

    return payload


def atomic_write_text(path: Path, content: str) -> None:
    tmp_path = path.with_suffix(path.suffix + '.tmp')
    tmp_path.write_text(content, encoding="utf-8")
    tmp_path.replace(path)


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate draft article from shortlist topic")
    parser.add_argument("--shortlist", required=True, help="Path to shortlist JSON")
    parser.add_argument("--topic-id", required=True, help="Topic id, e.g. topic-01")
    parser.add_argument("--author", default="Digital Technology Partner")
    parser.add_argument("--allow-duplicate", action="store_true", help="Allow duplicate title generation")
    args = parser.parse_args()

    shortlist_path = Path(args.shortlist)
    if not shortlist_path.exists():
        raise SystemExit(f"Shortlist not found: {shortlist_path}")

    payload = load_shortlist(shortlist_path)
    topic = next((t for t in payload.get("topics", []) if t.get("id") == args.topic_id), None)

    if topic is None:
        raise SystemExit(f"Topic id not found: {args.topic_id}")

    article_date = payload["date"]
    topic_title = clean_topic_title(topic['title'])
    slug = f"{article_date}-{slugify(topic_title)[:72]}"
    review_token = f"rvw-{secrets.token_hex(6)}"

    out_dir = Path("src/content/news")
    out_dir.mkdir(parents=True, exist_ok=True)

    titles = existing_titles(out_dir)
    article_category = normalise_category(str(topic['category']))
    if topic_title.lower() in titles and not args.allow_duplicate:
        raise SystemExit(
            f"Duplicate title blocked: '{topic_title}'. Use --allow-duplicate to override."
        )

    out_file = out_dir / f"{slug}.md"
    if out_file.exists() and not args.allow_duplicate:
        raise SystemExit(
            f"Duplicate slug blocked: {out_file.name}. Use --allow-duplicate to override."
        )

    markdown = f"""---
title: \"{topic_title}\"
description: \"{build_description(topic_title, article_category)}\"
pubDate: {article_date}
author: \"{args.author}\"
category: \"{article_category}\"
tags:
  - newsroom
  - ai-assisted
approved: false
reviewToken: \"{review_token}\"
source: \"{topic['source']}\"
---

{build_body(topic_title, article_category)}"""

    atomic_write_text(out_file, markdown)
    print(f"Draft created: {out_file}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

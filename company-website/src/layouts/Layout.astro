---
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import StudioFrame from '../components/studio/StudioFrame.astro';
import '../styles/v2-design-system.css';
import '../styles/studio.css';

export interface Props {
	title: string;
	description?: string;
	image?: string;
}

const DEFAULT_DESC = 'Digital Technology Partner (DTP) helps founders and teams turn ideas into products: Discovery → PoC → MVP → Pilot → Full Launch.';
const DEFAULT_IMAGE = '/images/og-default.jpg';

const { title, description = DEFAULT_DESC, image = DEFAULT_IMAGE } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="shortcut icon" href="/favicon-32x32.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			(() => {
				try {
					if (window.sessionStorage.getItem('dtpDepthTunnelArrival') === '1') {
						document.documentElement.classList.add('dtp-depth-tunnel-arrival', 'dtp-depth-tunnel-preload');
					}
				} catch {}
			})();
		</script>
		<style>
			html.dtp-depth-tunnel-preload::before {
				content: "";
				position: fixed;
				inset: 0;
				z-index: 2147482999;
				background: #000;
				pointer-events: none;
			}
		</style>

		<!-- V2: Midnight Authority Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="/route-depth-tunnel.css?v=20260614-all-equator" />
		<style>
			@media (hover: hover) and (pointer: fine) {
				body.site-cursor-ready,
				body.site-cursor-ready a,
				body.site-cursor-ready button,
				body.site-cursor-ready [role='button'],
				body.site-cursor-ready input,
				body.site-cursor-ready textarea,
				body.site-cursor-ready select {
					cursor: none !important;
				}

				.site-cursor,
				.site-cursor-ring {
					position: fixed;
					top: 0;
					left: 0;
					z-index: 99999;
					border-radius: 50%;
					pointer-events: none;
					opacity: 0;
					mix-blend-mode: difference;
				}

				.site-cursor {
					width: 6px;
					height: 6px;
					margin: -3px 0 0 -3px;
					background: #f2f1ec;
				}

				.site-cursor-ring {
					width: 34px;
					height: 34px;
					margin: -17px 0 0 -17px;
					border: 1px solid rgba(242, 241, 236, 0.5);
					transition:
						width 220ms ease,
						height 220ms ease,
						margin 220ms ease,
						border-color 220ms ease;
				}

				.site-cursor-ring.is-hover {
					width: 56px;
					height: 56px;
					margin: -28px 0 0 -28px;
					border-color: rgba(5, 204, 144, 0.9);
				}
			}
		</style>

		{/* Canonical URL */}
		{(() => {
		  const canonical = new URL(Astro.url.pathname, Astro.site).toString();
		  return <link rel="canonical" href={canonical} />
		})()}

		{/* Open Graph (WhatsApp/LinkedIn/Slack) */}
		{(() => {
		  const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
		  const img = image.startsWith('http') ? image : new URL(image, Astro.site).toString();
		  const desc = description;
		  return (
		    <fragment>
		      <meta property="og:type" content="website" />
		      <meta property="og:title" content={title} />
		      <meta property="og:description" content={desc} />
		      <meta property="og:url" content={pageUrl} />
		      <meta property="og:image" content={img} />
		      <meta property="og:site_name" content="Digital Technology Partner" />
		      <meta property="og:image:width" content="1200" />
		      <meta property="og:image:height" content="630" />
		      <meta property="og:image:alt" content="Digital Technology Partner (DTP)" />
		    </fragment>
		  );
		})()}

		{/* Twitter Cards */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{(() => {
		  const img = image.startsWith('http') ? image : new URL(image, Astro.site).toString();
		  return <meta name="twitter:image" content={img} />
		})()}
	</head>
	<body>
		<StudioFrame />
		<slot />
    <Footer />
    <CommandPalette />
		<script src="/route-depth-tunnel.js?v=20260614-no-arrival-flash" defer></script>
		<div class="site-cursor" id="siteCursor" aria-hidden="true"></div>
		<div class="site-cursor-ring" id="siteCursorRing" aria-hidden="true"></div>
		<script is:inline>
			(() => {
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
				const hasPageCursor = document.querySelector('.news-v2-page');
				if (reduceMotion || !finePointer || hasPageCursor) return;

				const dot = document.getElementById('siteCursor');
				const ring = document.getElementById('siteCursorRing');
				if (!dot || !ring) return;

				document.body.classList.add('site-cursor-ready');

				let mouseX = window.innerWidth / 2;
				let mouseY = window.innerHeight / 2;
				let ringX = mouseX;
				let ringY = mouseY;

				const setTransform = (element, x, y) => {
					element.style.transform = `translate3d(${x}px, ${y}px, 0)`;
				};

				document.addEventListener('mousemove', (event) => {
					mouseX = event.clientX;
					mouseY = event.clientY;
					dot.style.opacity = '1';
					ring.style.opacity = '1';
					setTransform(dot, mouseX, mouseY);
				});

				const interactiveSelector = [
					'a',
					'button',
					'input',
					'textarea',
					'select',
					'.ma-btn',
					'.ma-benefit-card',
					'.ma-case',
					'[role="button"]',
					'[data-st-index-open]',
				].join(',');

				document.addEventListener('mouseover', (event) => {
					if (event.target instanceof Element && event.target.closest(interactiveSelector)) {
						ring.classList.add('is-hover');
					}
				});

				document.addEventListener('mouseout', (event) => {
					if (event.target instanceof Element && event.target.closest(interactiveSelector)) {
						ring.classList.remove('is-hover');
					}
				});

				document.addEventListener('mouseleave', () => {
					dot.style.opacity = '0';
					ring.style.opacity = '0';
				});

				document.addEventListener('mouseenter', () => {
					dot.style.opacity = '1';
					ring.style.opacity = '1';
				});

				const tick = () => {
					ringX += (mouseX - ringX) * 0.18;
					ringY += (mouseY - ringY) * 0.18;
					setTransform(ring, ringX, ringY);
					requestAnimationFrame(tick);
				};

				tick();
			})();
		</script>
	</body>
</html>

---
// STUDIO: ecosystem chrome — gallery-consistent navigation

const currentPath = Astro.url.pathname;
type NavItem = {
  href: string;
  label: string;
  children?: Array<{ href: string; label: string; description: string }>;
};

const navItems: NavItem[] = [
  { href: '/why-dtp', label: 'Why DTP' },
  {
    href: '/programmes',
    label: 'Programmes',
    children: [
      {
        href: '/programmes/ai-adoption-readiness/',
        label: 'AI Readiness',
        description: 'See what is happening before deciding what to do.',
      },
      {
        href: '/programmes/ai-foundry/',
        label: 'AI Foundry',
        description: 'Turn real work into tested AI opportunities.',
      },
    ],
  },
  { href: '/solutions', label: 'Solutions' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/insights', label: 'Insights' },
  { href: '/contact', label: 'Contact' },
];

const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="ma-header">
  <nav class="ma-container ma-nav-inner">
    <a href="/" class="ma-nav-logo" aria-label="Digital Technology Partner — return to ecosystem">
      <img src="/images/DTP logo - White-2.png" alt="" class="ma-logo-img" />
      <span class="ma-logo-wordmark">Digital Technology Partner</span>
    </a>

    <ul class="ma-nav-links" id="desktop-nav">
      {navItems.map((item) => (
        <li class:list={{ 'ma-nav-has-submenu': item.children }}>
          <a
            href={item.href}
            class:list={{ active: isActive(item.href) }}
            aria-current={isActive(item.href) ? 'page' : undefined}
            aria-haspopup={item.children ? 'true' : undefined}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="ma-nav-submenu" aria-label="Programme pages">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class:list={{ active: isActive(child.href) }}
                  aria-current={isActive(child.href) ? 'page' : undefined}
                >
                  <strong>{child.label}</strong>
                  <span>{child.description}</span>
                </a>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>

    <div class="ma-nav-right">
      <a class="ma-nav-gallery-return" href="/" aria-label="Return to gallery" data-news-v2-cursor>
        <span>GALLERY</span>
        <span class="ma-nav-cube-mark" aria-hidden="true">
          <span class="ma-nav-cube"></span>
          <span class="ma-nav-cube"></span>
          <span class="ma-nav-cube"></span>
          <span class="ma-nav-cube"></span>
          <span class="ma-nav-cube"></span>
          <span class="ma-nav-cube"></span>
        </span>
      </a>
      <a href="https://outlook.office.com/bookwithme/user/f0762b9af6a94ed2add9818a4f3ca4e5@digitaltechnologypartner.ai/meetingtype/qc2lOXjEdkO6GkMS_jZJrQ2?anonymous" target="_blank" rel="noopener noreferrer" class="ma-btn ma-btn-mint ma-nav-cta">Book a Call</a>
      <button class="ma-nav-index" data-st-index-open aria-label="Open ecosystem index" aria-expanded="false">
        <span>INDEX</span>
        <span class="ma-nav-index-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .ma-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: linear-gradient(180deg, rgba(7, 9, 13, 0.82), rgba(7, 9, 13, 0));
    border-bottom: 1px solid transparent;
    transition:
      background 320ms ease,
      border-color 320ms ease,
      backdrop-filter 320ms ease;
  }

  .ma-header.st-scrolled {
    background: rgba(7, 9, 13, 0.86);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--ma-border);
  }

  .ma-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 76px;
    max-width: none;
    padding: 0 36px;
  }

  .ma-nav-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #f2f1ec;
    text-decoration: none;
    flex-shrink: 0;
  }

  .ma-nav-logo:link,
  .ma-nav-logo:visited,
  .ma-nav-logo:hover,
  .ma-nav-logo:active {
    color: #f2f1ec;
    text-decoration: none;
  }

  .ma-logo-img {
    height: 30px;
    width: auto;
  }

  .ma-logo-wordmark {
    color: #f2f1ec;
    font-family: var(--ma-font-display);
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .ma-nav-links {
    display: flex;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ma-nav-links a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    font-family: var(--ma-font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ma-text-dim);
    border: 1px solid transparent;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 250ms ease,
      border-color 250ms ease;
  }

  .ma-nav-links a::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ma-mint);
    opacity: 0.55;
    transition: opacity 250ms ease, box-shadow 250ms ease;
  }

  .ma-nav-links a:hover {
    color: var(--ma-white);
    border-color: var(--ma-border);
  }

  .ma-nav-links a.active {
    color: var(--ma-white);
    border-color: rgba(5, 204, 144, 0.45);
  }

  .ma-nav-links a.active::before,
  .ma-nav-links a:hover::before {
    opacity: 1;
    box-shadow: 0 0 10px var(--ma-mint-glow);
  }

  .ma-nav-has-submenu {
    position: relative;
  }

  .ma-nav-submenu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    width: 320px;
    padding: 0.55rem;
    border: 1px solid rgba(244, 241, 232, 0.14);
    background: rgba(7, 9, 13, 0.97);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(16px);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -8px);
    transition:
      opacity 180ms ease,
      visibility 180ms ease,
      transform 180ms ease;
  }

  .ma-nav-submenu::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -14px;
    height: 14px;
  }

  .ma-nav-has-submenu:hover .ma-nav-submenu,
  .ma-nav-has-submenu:focus-within .ma-nav-submenu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .ma-nav-links .ma-nav-submenu a {
    display: grid;
    gap: 0.28rem;
    padding: 0.9rem 1rem;
    border: 1px solid transparent;
    text-transform: none;
    letter-spacing: 0;
  }

  .ma-nav-links .ma-nav-submenu a::before {
    display: none;
  }

  .ma-nav-links .ma-nav-submenu a + a {
    margin-top: 0.25rem;
  }

  .ma-nav-links .ma-nav-submenu a:hover,
  .ma-nav-links .ma-nav-submenu a.active {
    border-color: rgba(5, 204, 144, 0.38);
    background: rgba(5, 204, 144, 0.07);
  }

  .ma-nav-submenu strong {
    color: #f4f1e8;
    font-family: var(--ma-font-display);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .ma-nav-submenu span {
    color: var(--ma-text-dim);
    font-family: var(--ma-font-body);
    font-size: 0.76rem;
    line-height: 1.45;
    white-space: normal;
  }

  .ma-nav-right {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-shrink: 0;
  }

  .ma-nav-status {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ma-nav-cta {
    font-size: 0.68rem !important;
    padding: 0.62rem 1.1rem !important;
  }

  .ma-nav-index,
  .ma-nav-gallery-return {
    background: none;
    border: 1px solid var(--ma-border);
    color: var(--ma-white);
    font-family: var(--ma-font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    text-decoration: none;
    transition:
      border-color 0.25s,
      background 0.25s;
  }

  .ma-nav-index:hover,
  .ma-nav-gallery-return:hover {
    border-color: rgba(242, 241, 236, 0.4);
    background: rgba(242, 241, 236, 0.04);
  }

  .ma-nav-gallery-return:link,
  .ma-nav-gallery-return:visited,
  .ma-nav-gallery-return:hover,
  .ma-nav-gallery-return:active {
    color: var(--ma-white);
    text-decoration: none;
  }

  .ma-nav-index-lines {
    position: relative;
    display: block;
    width: 18px;
    height: 12px;
    flex: 0 0 18px;
  }

  .ma-nav-index i {
    position: absolute;
    left: 2px;
    display: block;
    width: 14px;
    height: 1px;
    border-radius: 999px;
    background: #f2f1ec;
    transform-origin: center;
    transition:
      background 260ms ease,
      box-shadow 260ms ease,
      transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1),
      width 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .ma-nav-index i:first-child {
    top: 3px;
  }

  .ma-nav-index i:last-child {
    top: 8px;
  }

  .ma-nav-index:hover i,
  .ma-nav-index.is-open i {
    background: #05cc90;
    box-shadow: 0 0 10px rgba(5, 204, 144, 0.72);
  }

  .ma-nav-index:hover i:first-child {
    transform: translateX(3px);
    width: 12px;
  }

  .ma-nav-index:hover i:last-child {
    transform: translateX(-3px);
    width: 16px;
  }

  .ma-nav-index.is-open i:first-child {
    transform: translateY(2.5px) rotate(42deg);
    width: 18px;
  }

  .ma-nav-index.is-open i:last-child {
    transform: translateY(-2.5px) rotate(-42deg);
    width: 18px;
  }

  :global(.ma-nav-cube-mark) {
    --cube-size: 4px;
    --cube-gap-x: 7px;
    --cube-gap-y: 7px;
    position: relative;
    display: block;
    width: 18px;
    height: 15px;
    flex: 0 0 18px;
  }

  :global(.ma-nav-cube) {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    width: var(--cube-size);
    height: var(--cube-size);
    background: #f2f1ec;
    border-radius: 1px;
    box-shadow: 0 0 0 rgba(5, 204, 144, 0);
    transition:
      background 220ms ease,
      box-shadow 220ms ease,
      transform 460ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global(.ma-nav-cube:nth-child(1)) {
    transform: translate(0, 1px);
  }

  :global(.ma-nav-cube:nth-child(2)) {
    transform: translate(var(--cube-gap-x), 1px);
  }

  :global(.ma-nav-cube:nth-child(3)) {
    transform: translate(calc(var(--cube-gap-x) * 2), 1px);
  }

  :global(.ma-nav-cube:nth-child(4)) {
    transform: translate(calc(var(--cube-gap-x) * 2), calc(var(--cube-gap-y) + 1px));
  }

  :global(.ma-nav-cube:nth-child(5)) {
    transform: translate(var(--cube-gap-x), calc(var(--cube-gap-y) + 1px));
  }

  :global(.ma-nav-cube:nth-child(6)) {
    transform: translate(0, calc(var(--cube-gap-y) + 1px));
  }

  .ma-nav-gallery-return:hover :global(.ma-nav-cube) {
    background: #05cc90;
    box-shadow: 0 0 9px rgba(5, 204, 144, 0.72);
  }

  .ma-nav-gallery-return:hover :global(.ma-nav-cube:nth-child(1)) {
    transform: translate(var(--cube-gap-x), 1px);
  }

  .ma-nav-gallery-return:hover :global(.ma-nav-cube:nth-child(2)) {
    transform: translate(calc(var(--cube-gap-x) * 2), 1px);
  }

  .ma-nav-gallery-return:hover :global(.ma-nav-cube:nth-child(3)) {
    transform: translate(calc(var(--cube-gap-x) * 2), calc(var(--cube-gap-y) + 1px));
  }

  .ma-nav-gallery-return:hover :global(.ma-nav-cube:nth-child(4)) {
    transform: translate(var(--cube-gap-x), calc(var(--cube-gap-y) + 1px));
  }

  .ma-nav-gallery-return:hover :global(.ma-nav-cube:nth-child(5)) {
    transform: translate(0, calc(var(--cube-gap-y) + 1px));
  }

  .ma-nav-gallery-return:hover :global(.ma-nav-cube:nth-child(6)) {
    transform: translate(0, 1px);
  }

  .ma-nav-index > span:first-child,
  .ma-nav-gallery-return > span:first-child {
    margin-right: 4px;
  }

  @media (max-width: 1339px) {
    .ma-nav-status {
      display: none;
    }
  }

  @media (max-width: 1170px) {
    .ma-nav-links {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .ma-nav-inner {
      padding: 0 14px;
      height: 64px;
      gap: 10px;
    }

    .ma-logo-img {
      height: 24px;
    }

    .ma-nav-logo {
      gap: 0;
    }

    .ma-logo-wordmark {
      display: none;
    }

    .ma-nav-cta {
      display: none;
    }

    .ma-nav-right {
      gap: 8px;
      min-width: 0;
    }

    .ma-nav-index,
    .ma-nav-gallery-return {
      flex: 0 0 auto;
      padding: 9px 10px;
      gap: 8px;
      letter-spacing: 0.16em;
    }

    .ma-nav-index > span:first-child,
    .ma-nav-gallery-return > span:first-child {
      margin-right: 0;
    }
  }
</style>


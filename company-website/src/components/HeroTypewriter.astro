---
/**
 * Hero Typewriter Animation Component
 * 
 * Implements a two-phase typewriter effect:
 * 1. Tag line auto-plays on page load (500ms delay)
 * 2. Headline triggers on first scroll
 * 
 * Features:
 * - Blinking cursor (mint green, 1s cycle)
 * - Accessibility: respects prefers-reduced-motion
 * - Screen reader support: aria-live regions with full text
 * - Performance: zero layout shift, RAF-based animation
 * 
 * @component
 */

interface Props {
  /** Tag line text to type out on load */
  tagText: string;
  /** Headline text to type on scroll */
  headlineText: string;
  /** Typing speed in milliseconds per character */
  typingSpeed?: number;
  /** Delay before starting tag line animation */
  startDelay?: number;
}

const { 
  tagText, 
  headlineText, 
  typingSpeed = 120, 
  startDelay = 500 
} = Astro.props;
---

<div class="ma-hero-tag" data-text={tagText}>
  <span class="typewriter-tag" aria-live="polite"></span>
</div>
<h1 data-text={headlineText}>
  <span class="typewriter-headline" aria-live="polite"></span><span class="ma-cursor">|</span>
</h1>

<style is:global>
  .typewriter-tag {
    display: inline-block;
    color: var(--ma-mint, #00E5A0);
    min-width: 37ch;
    min-height: 1em;
    vertical-align: baseline;
  }
  
  .typewriter-headline {
    display: inline-block;
    color: inherit;
    min-width: 14ch;
    min-height: 1em;
    vertical-align: baseline;
  }

  .ma-cursor {
    display: inline-block;
    color: var(--ma-mint, #00E5A0);
    font-weight: 400;
    animation: blink 1.2s step-end infinite;
    opacity: 0;
    vertical-align: baseline;
  }
  
  .ma-cursor.visible {
    opacity: 1;
  }
  
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  
  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .typewriter-tag::before {
      content: attr(data-text);
    }
    
    .typewriter-headline::before {
      content: attr(data-text);
    }
    
    .ma-cursor {
      animation: none;
    }
  }
</style>

<script is:inline define:vars={{ tagText, headlineText, typingSpeed, startDelay }}>
  // eslint-disable-next-line @typescript-eslint/ban-ts-comment
  // @ts-nocheck
  /**
   * Typewriter animation implementation
   * Uses requestAnimationFrame for smooth rendering
   */
  
  // Check for reduced motion preference
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
  if (prefersReducedMotion) {
    // Display all text immediately
    const tagElement = document.querySelector('.typewriter-tag');
    const headlineElement = document.querySelector('.typewriter-headline');
    
    if (tagElement) tagElement.textContent = tagText;
    if (headlineElement) headlineElement.textContent = headlineText;
  } else {
    let headlineStarted = false;
    
    /**
     * Typewriter function - reveals text character by character
     * @param element - Target DOM element
     * @param text - Text to type out
     * @param speed - Milliseconds per character
     * @param callback - Function to call when complete
     */
    function typeWriter(element, text, speed, callback) {
      if (!element) return;
      
      let index = 0;
      let lastTime = performance.now();
      
      function type(currentTime) {
        const elapsed = currentTime - lastTime;
        
        if (elapsed >= speed) {
          if (index < text.length) {
            element.textContent = text.substring(0, index + 1);
            index++;
            lastTime = currentTime;
          } else {
            // Animation complete
            if (callback) callback();
            return;
          }
        }
        
        requestAnimationFrame(type);
      }
      
      requestAnimationFrame(type);
    }
    
    /**
     * Start tag line animation after delay
     */
    function startTagAnimation() {
      const tagElement = document.querySelector('.typewriter-tag');
      if (tagElement) {
        typeWriter(tagElement, tagText, typingSpeed);
      }
    }
    
    /**
     * Start headline animation
     */
    function startHeadlineAnimation() {
      if (headlineStarted) return;
      headlineStarted = true;
      const headlineElement = document.querySelector('.typewriter-headline');
      const cursorElement = document.querySelector('.ma-cursor');
      if (headlineElement) {
        typeWriter(headlineElement, headlineText, typingSpeed);
      }
      if (cursorElement) {
        cursorElement.classList.add('visible');
      }
    }

    function handleHeadlineIntent(event) {
      if (event && typeof event.preventDefault === 'function') {
        event.preventDefault();
      }
      startHeadlineAnimation();
    }

    function armHeadlineScrollTrigger() {
      window.addEventListener('wheel', handleHeadlineIntent, { once: true, passive: false });
      window.addEventListener('touchmove', handleHeadlineIntent, { once: true, passive: false });
      window.addEventListener('keydown', (event) => {
        if (['ArrowDown', 'PageDown', 'Space', ' '].includes(event.key)) {
          handleHeadlineIntent(event);
        }
      }, { once: true });
    }
    
    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    
    function init() {
      setTimeout(startTagAnimation, startDelay);
      armHeadlineScrollTrigger();
    }
  }
</script>

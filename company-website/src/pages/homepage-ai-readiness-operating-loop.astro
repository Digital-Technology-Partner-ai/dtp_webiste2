  <style>
    :root{--bg:#030406;--panel:#101322;--panel2:#171a2f;--text:#eceff2;--muted:#a4aabb;--mint:#05cc90;--orange:#ffb86b;--blue:#7aa2ff;--line:rgba(255,255,255,.1)}
    *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--text);font-family:'IBM Plex Sans',system-ui,sans-serif;line-height:1.5;overflow-x:hidden} a{text-decoration:none;color:inherit}.mono{font-family:'IBM Plex Mono',monospace}.container{max-width:1200px;margin:0 auto;padding:0 28px}.nav{position:fixed;top:20px;left:50%;transform:translateX(-50%);width:min(1120px,calc(100% - 32px));z-index:5;border:1px solid var(--line);border-radius:999px;background:rgba(16,19,34,.78);backdrop-filter:blur(18px)}.nav-inner{height:62px;display:flex;align-items:center;justify-content:space-between;padding:0 18px}.brand{font-family:'Space Grotesk';font-weight:700}.links{display:flex;gap:20px;color:var(--muted);font-size:14px}.nav-cta{background:var(--mint);color:#02120d;border-radius:999px;padding:9px 13px;font-weight:700}.hero{padding:148px 0 80px;position:relative}.orbit-bg{position:absolute;inset:-120px -20vw auto auto;width:760px;height:760px;border:1px solid rgba(5,204,144,.18);border-radius:50%;opacity:.8}.orbit-bg:before,.orbit-bg:after{content:"";position:absolute;border:1px solid rgba(255,255,255,.08);border-radius:50%;inset:90px}.orbit-bg:after{inset:190px;border-color:rgba(5,204,144,.12)}.hero-grid{position:relative;display:grid;grid-template-columns:.92fr 1.08fr;gap:62px;align-items:center}.tag{font-family:'IBM Plex Mono';font-size:13px;color:var(--mint);text-transform:uppercase;letter-spacing:.08em}.hero h1{font-family:'Space Grotesk';font-size:clamp(50px,7vw,92px);line-height:.94;letter-spacing:-.06em;margin:18px 0 22px}.hero p{font-size:22px;color:#c3c8d3;margin:0 0 30px;max-width:620px}.buttons{display:flex;gap:12px;flex-wrap:wrap}.btn{display:inline-flex;padding:15px 18px;border-radius:12px;border:1px solid var(--line);font-weight:700}.btn.primary{background:var(--mint);border-color:var(--mint);color:#02120d}.loop{height:560px;position:relative;border:1px solid var(--line);border-radius:34px;background:radial-gradient(circle at 50% 50%,rgba(5,204,144,.12),transparent 40%),linear-gradient(145deg,rgba(23,26,47,.86),rgba(7,8,14,.86));box-shadow:0 24px 90px rgba(0,0,0,.54);overflow:hidden}.loop:before{content:"";position:absolute;inset:36px;border:1px dashed rgba(5,204,144,.32);border-radius:50%}.node{position:absolute;width:160px;padding:15px;border:1px solid var(--line);border-radius:18px;background:rgba(16,19,34,.92)}.node strong{display:block;font-family:'Space Grotesk';font-size:18px}.node span{font-size:13px;color:var(--muted)}.n1{top:42px;left:50%;transform:translateX(-50%)}.n2{top:190px;right:48px}.n3{bottom:58px;right:130px}.n4{bottom:58px;left:130px}.n5{top:190px;left:48px}.centre{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:210px;height:210px;border-radius:50%;background:rgba(5,204,144,.1);border:1px solid rgba(5,204,144,.36);display:grid;place-items:center;text-align:center;padding:26px}.centre strong{font-family:'Space Grotesk';font-size:28px;line-height:1}.centre span{color:var(--muted);font-size:13px;margin-top:8px;display:block}.section{padding:84px 0;border-top:1px solid var(--line)}.section-head{max-width:800px}.section h2{font-family:'Space Grotesk';font-size:clamp(38px,5vw,68px);line-height:.98;letter-spacing:-.05em;margin:14px 0 18px}.section p.intro{font-size:20px;color:var(--muted)}.split{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:36px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:26px;padding:28px;min-height:310px}.panel h3{font-family:'Space Grotesk';font-size:34px;margin:0 0 16px}.panel p{color:var(--muted);font-size:18px}.chips{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}.chip{font-family:'IBM Plex Mono';font-size:12px;border:1px solid rgba(5,204,144,.26);color:var(--mint);background:rgba(5,204,144,.06);border-radius:999px;padding:8px 10px}.ladder{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:34px}.tier{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:24px;padding:26px}.tier:nth-child(2){border-color:rgba(5,204,144,.35)}.tier small{font-family:'IBM Plex Mono';color:var(--mint)}.tier h3{font-family:'Space Grotesk';font-size:30px;margin:18px 0 10px}.tier p{color:var(--muted);margin:0}.work-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:24px;overflow:hidden;margin-top:34px}.work{background:#06070c;padding:24px;min-height:190px}.work b{color:var(--mint);font-family:'IBM Plex Mono'}.work h3{font-family:'Space Grotesk';margin:35px 0 8px}.work p{color:var(--muted);font-size:14px;margin:0}.final{padding:92px 0 112px}.final-card{background:linear-gradient(135deg,rgba(5,204,144,.14),rgba(122,162,255,.08));border:1px solid rgba(5,204,144,.25);border-radius:34px;padding:44px;display:flex;justify-content:space-between;gap:36px;align-items:center}.final h2{font-family:'Space Grotesk';font-size:50px;line-height:1;margin:0 0 12px}.final p{color:var(--muted);font-size:18px;margin:0}@media(max-width:980px){.hero-grid,.split{grid-template-columns:1fr}.ladder,.work-strip{grid-template-columns:1fr}.links{display:none}.loop{height:620px}.node{width:145px}.final-card{display:block}.final .btn{margin-top:24px}}
  </style>
</head>
<body>
  <nav class="nav"><div class="nav-inner"><a class="brand" href="/">DTP</a><div class="links"><a href="#loop">Loop</a><a href="#readiness">Readiness</a><a href="#build">Build</a><a class="nav-cta" href="#start">Start</a></div></div></nav>
  <main>
    <section class="hero"><div class="orbit-bg"></div><div class="container hero-grid"><div><div class="tag">// AI readiness into working systems</div><h1>Make AI adoption visible, then make the useful parts real.</h1><p>DTP helps companies move from scattered AI interest to leadership clarity, focused proof of concept work, and practical tools that people can actually use.</p><div class="buttons"><a class="btn primary" href="#start">Talk to DTP</a><a class="btn" href="#loop">View the operating loop</a></div></div><div class="loop" id="loop"><div class="node n1"><strong>Map</strong><span>Where AI is already appearing.</span></div><div class="node n2"><strong>Diagnose</strong><span>Capability, risk, value and friction.</span></div><div class="node n3"><strong>Decide</strong><span>Encourage, control, investigate or stop.</span></div><div class="node n4"><strong>Build</strong><span>Small proofs and MVPs where justified.</span></div><div class="node n5"><strong>Operate</strong><span>Evidence, ownership and adoption.</span></div><div class="centre"><div><strong>Decision loop</strong><span>not a one-off AI workshop</span></div></div></div></div></section>
    <section class="section" id="readiness"><div class="container"><div class="section-head"><div class="tag">// First, understand the operating reality</div><h2>Leadership needs evidence, not another generic AI promise.</h2><p class="intro">The useful work begins when you can see where AI is already being used, which opportunities matter, what risks need control, and which proofs are worth funding.</p></div><div class="ladder"><article class="tier"><small>01 / Signal</small><h3>Readiness Snapshot</h3><p>A quick way to qualify whether there is enough signal to look deeper.</p></article><article class="tier"><small>02 / Evidence</small><h3>Readiness Diagnostic</h3><p>A clearer evidence base before leadership decides what should happen next.</p></article><article class="tier"><small>03 / Decision</small><h3>Readiness Advisory</h3><p>Interpretation, challenge and a leadership playback that turns evidence into action.</p></article></div></div></section>
    <section class="section" id="build"><div class="container"><div class="split"><article class="panel"><div class="tag">// What this is not</div><h3>Not “we will build you an AI thing”.</h3><p>That is too easy to say and often the wrong place to start. If the business does not know what to build, what it can absorb, or where the risk sits, jumping to delivery just creates smarter-looking waste.</p><div class="chips"><span class="chip">no hype</span><span class="chip">no fake maturity score</span><span class="chip">no blind build sprint</span></div></article><article class="panel"><div class="tag">// What DTP can do next</div><h3>From decision to delivery.</h3><p>When the evidence points to a useful opportunity, DTP can build the proof, MVP or operating workflow, then help pilot it with the right controls and feedback loop.</p><div class="chips"><span class="chip">PoC</span><span class="chip">MVP</span><span class="chip">pilot</span><span class="chip">operational AI</span><span class="chip">internal agents</span></div></article></div></div></section>
    <section class="section"><div class="container"><div class="section-head"><div class="tag">// Places DTP creates value</div><h2>Useful AI work usually connects several layers.</h2></div><div class="work-strip"><article class="work"><b>01</b><h3>Leadership clarity</h3><p>Decision packs, readiness reviews and adoption maps.</p></article><article class="work"><b>02</b><h3>Operational workflows</h3><p>Agents, automations and data flows around real work.</p></article><article class="work"><b>03</b><h3>Proof and product</h3><p>Focused builds that test whether an idea deserves more investment.</p></article><article class="work"><b>04</b><h3>Adoption control</h3><p>Feedback loops, evidence, governance and ownership.</p></article></div></div></section>
    <section class="final" id="start"><div class="container"><div class="final-card"><div><div class="tag">// Start with the right question</div><h2>What is AI already doing to your business?</h2><p>Once that is visible, the next build decision gets much easier.</p></div><a class="btn primary" href="https://outlook.office.com/bookwithme/user/f0762b9af6a94ed2add9818a4f3ca4e5@digitaltechnologypartner.ai/meetingtype/qc2lOXjEdkO6GkMS_jZJrQ2?anonymous" target="_blank" rel="noopener noreferrer">Book a discovery call</a></div></div></section>
  </main>
</body>
</html>

---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
---

<Layout
  title="Newsroom Review | Digital Technology Partner"
  description="Temporary review surface for draft newsroom articles."
  noindex={true}
>
  <Header />

  <main class="ma-section">
    <article class="ma-container" style="max-width: 820px;">
      <header style="margin-bottom:2rem;">
        <span class="ma-section-tag">// newsroom review</span>
        <h1 style="font-size: clamp(2rem, 4vw, 3rem); line-height:1.1; margin:1rem 0;">Review links are article-specific</h1>
        <p style="font-size:1.1rem; color:var(--ma-text-secondary); max-width:70ch;">
          Draft review does not happen on the main DTP domain. Use the separate here.now review link Hudson sent for the specific article under review.
        </p>
      </header>
    </article>
  </main>
</Layout>

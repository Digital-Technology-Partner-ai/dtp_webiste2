---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

const approvedNews = await getCollection(
  'news',
  ({ data }) => data.approved === true
);
const articles = approvedNews.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const featured = articles[0];
const latest = articles.slice(1, 7);

const themes = [
  {
    id: 'leadership',
    label: 'Leadership',
    title: 'What leaders should fund, stop or govern.',
    tags: ['strategy', 'ai-adoption', 'enterprise-operations'],
  },
  {
    id: 'delivery',
    label: 'Delivery',
    title: 'How AI moves from pilot to production.',
    tags: ['implementation', 'digital-transformation', 'production'],
  },
  {
    id: 'governance',
    label: 'Governance',
    title: 'Risk, policy, security and operational control.',
    tags: ['governance', 'risk', 'compliance'],
  },
];

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });

const cleanCopy = (value: string) =>
  value.replace(/\s*[\u2014\u2013]\s*/g, ', ');
---

<Layout
  title="Insights, the filtered AI feed for leadership decisions | Digital Technology Partner"
  description="AI adoption, governance and delivery news, read for you and reduced to what changes a leadership decision. Read less. Decide more."
>
  <Header />
  <main class="insights-page">
    <section class="insights-hero" aria-labelledby="insights-title">
      <div class="insights-grid"></div>
      <div class="ma-container insights-hero-inner">
        <div class="insights-copy" data-insights-reveal>
          <span class="ma-section-tag">// the_filter</span>
          <h1 id="insights-title">AI expertise has a short shelf life.</h1>
          <p>
            AI is broad, technical and changing by the week. We stay close to
            the tools, developments and evidence, separate substance from noise,
            and bring forward what business leaders need to understand or act
            on.
          </p>
          <div class="insights-actions">
            <a class="ma-btn ma-btn-mint" href="#latest-signal"
              >View the latest signal</a
            >
            <a class="ma-btn ma-btn-outline" href="/news/"
              >Browse the full newsroom</a
            >
          </div>
        </div>

        <aside
          class="signal-console"
          aria-label="Animated insights information filter"
          data-insights-reveal
        >
          <div class="signal-console-top">
            <span>current signal</span>
          </div>
          <div class="signal-visual browser-depth-visual">
            <iframe
              src="/media/insights/browser-depth-transformation.html"
              title="Animated information streams becoming organised in a front decision screen"
              loading="eager"
              sandbox="allow-scripts"
              referrerpolicy="no-referrer"
              tabindex="-1"
            ></iframe>
          </div>
          <div class="signal-readout">
            <span>
              AI moves faster than any leadership team can reasonably track. We
              filter what matters.
            </span>
          </div>
        </aside>
      </div>
    </section>

    <section class="ma-section theme-section">
      <div class="ma-container theme-strip" aria-label="Insight themes">
        {
          themes.map((theme) => (
            <button
              type="button"
              data-signal-theme={theme.id}
              data-signal-label={theme.label}
              data-signal-value={theme.title}
              class:list={[
                'theme-button',
                { active: theme.id === 'leadership' },
              ]}
              aria-pressed={theme.id === 'leadership' ? 'true' : 'false'}
            >
              <span>{theme.label}</span>
              <strong>{theme.title}</strong>
            </button>
          ))
        }
      </div>
    </section>

    <section class="ma-section editorial-section" id="latest-signal">
      <div class="ma-container editorial-grid">
        <div class="editorial-copy" data-insights-reveal>
          <span class="ma-section-tag">// latest_signal</span>
          <h2>Read what is changing, then decide what deserves attention.</h2>
          <p>Five minutes a week is enough. Start with the featured piece.</p>
        </div>
        <div class="editorial-feed">
          {
            featured && (
              <article class="featured-article" data-insights-card>
                <div class="article-meta">
                  <span>Featured</span>
                  <time datetime={featured.data.pubDate.toISOString()}>
                    {formatDate(featured.data.pubDate)}
                  </time>
                </div>
                <h3>
                  <a href={`/news/${featured.id}`}>
                    {cleanCopy(featured.data.title)}
                  </a>
                </h3>
                <p>{cleanCopy(featured.data.description)}</p>
                <div class="article-tags">
                  {[
                    featured.data.category,
                    ...(featured.data.tags || []).slice(0, 3),
                  ].map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              </article>
            )
          }

          <div class="article-list">
            {
              latest.map((article) => (
                <article data-insights-card>
                  <div class="article-meta">
                    <span>{article.data.category}</span>
                    <time datetime={article.data.pubDate.toISOString()}>
                      {formatDate(article.data.pubDate)}
                    </time>
                  </div>
                  <h3>
                    <a href={`/news/${article.id}`}>
                      {cleanCopy(article.data.title)}
                    </a>
                  </h3>
                  <p>{cleanCopy(article.data.description)}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="ma-section theme-map-section">
      <div class="ma-container">
        <div class="theme-map-head" data-insights-reveal>
          <span class="ma-section-tag">// editorial_lenses</span>
          <h2>Use Insights as a decision filter.</h2>
        </div>
        <div class="theme-map">
          {
            themes.map((theme) => (
              <article data-insights-card>
                <span>{theme.label}</span>
                <h3>{theme.title}</h3>
                <p>{theme.tags.map((tag) => `#${tag}`).join('  ')}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="insights-cta">
      <div class="ma-container insights-cta-inner" data-insights-reveal>
        <span class="ma-section-tag">// the_sample</span>
        <h2>This is the judgement we sell. Sample it freely.</h2>
        <p>
          Every piece here is written with the same question we bring to client
          work: what deserves your attention, your budget or your guardrails
          next? If the thinking is useful, the conversation is more useful.
        </p>
        <div class="insights-actions">
          <a
            class="ma-btn ma-btn-mint ma-btn-lg"
            href="/programmes/ai-adoption-readiness/"
          >
            Start with AI Readiness
          </a>
          <a class="ma-btn ma-btn-outline ma-btn-lg" href="/contact/"
            >Book a Discovery Call</a
          >
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const themeButtons = Array.from(
    document.querySelectorAll('[data-signal-theme]')
  ) as HTMLButtonElement[];

  const setTheme = (button: HTMLButtonElement) => {
    themeButtons.forEach((item) => {
      const active = item === button;
      item.classList.toggle('active', active);
      item.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  };

  themeButtons.forEach((button) => {
    button.addEventListener('pointerenter', () => setTheme(button));
    button.addEventListener('focus', () => setTheme(button));
    button.addEventListener('click', () => setTheme(button));
  });
</script>

<style>
  .insights-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 16% 10%,
        rgba(5, 204, 144, 0.12),
        transparent 31rem
      ),
      radial-gradient(
        circle at 78% 18%,
        rgba(124, 139, 255, 0.1),
        transparent 30rem
      );
    color: var(--ma-text);
  }

  .insights-hero {
    position: relative;
    min-height: 90vh;
    padding: 7.35rem 0 3.8rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid rgba(244, 241, 232, 0.1);
  }

  .insights-grid {
    position: absolute;
    inset: 0;
    opacity: 0.13;
    background-image:
      linear-gradient(rgba(244, 241, 232, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 232, 0.035) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: radial-gradient(
      ellipse 78% 74% at 62% 46%,
      black,
      transparent 86%
    );
  }

  .insights-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 1.05fr);
    gap: 4rem;
    align-items: center;
  }

  .insights-copy h1 {
    max-width: 860px;
    margin-bottom: 1.3rem;
    color: #f4f1e8;
    font-size: clamp(2.95rem, 5vw, 4.7rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .insights-copy p {
    max-width: 690px;
    color: #d8d6ce;
    font-size: 1.1rem;
    line-height: 1.68;
  }

  .insights-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .signal-console {
    position: relative;
    overflow: hidden;
    padding: 1.25rem;
    border: 1px solid rgba(244, 241, 232, 0.14);
    border-radius: var(--ma-radius);
    background:
      radial-gradient(
        circle at 48% 42%,
        rgba(5, 204, 144, 0.13),
        transparent 22rem
      ),
      linear-gradient(145deg, rgba(11, 16, 26, 0.86), rgba(4, 6, 9, 0.55));
    box-shadow: 0 34px 100px rgba(0, 0, 0, 0.32);
  }

  .signal-console-top,
  .signal-readout {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ma-text-dim);
    font-family: var(--ma-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .signal-console-top > span {
    color: var(--ma-mint);
    font-weight: 500;
  }

  .signal-visual {
    position: relative;
    margin: 0.75rem 0 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #050507;
  }

  .browser-depth-visual iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #050507;
    pointer-events: none;
  }

  .signal-readout {
    display: block;
    min-height: 0;
    padding: 0.7rem 0 0.1rem;
    background: transparent;
    color: #d8d6ce;
    line-height: 1.5;
  }

  .theme-section {
    padding-top: 2rem;
    padding-bottom: 2rem;
    background: rgba(11, 16, 26, 0.45);
    border-bottom: 1px solid var(--ma-border);
  }

  .theme-strip,
  .theme-map {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .theme-button,
  .theme-map article {
    display: grid;
    gap: 0.45rem;
    min-height: 118px;
    padding: 1rem;
    border: 1px solid rgba(244, 241, 232, 0.13);
    border-radius: var(--ma-radius);
    background: rgba(11, 16, 26, 0.78);
    color: #d8d6ce;
    text-align: left;
  }

  .theme-button {
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .theme-button span,
  .theme-map article span {
    color: #f4f1e8;
    font-family: var(--ma-font-display);
    font-size: 1.08rem;
    font-weight: 700;
  }

  .theme-button strong,
  .theme-map article p {
    color: var(--ma-text-dim);
    font-size: 0.9rem;
    line-height: 1.42;
  }

  .theme-button:hover,
  .theme-button:focus-visible,
  .theme-button.active {
    border-color: rgba(5, 204, 144, 0.62);
    background: rgba(5, 204, 144, 0.1);
    transform: translateY(-3px);
    outline: none;
  }

  .editorial-section {
    background: rgba(7, 9, 13, 0.5);
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.76fr) minmax(0, 1.24fr);
    gap: 4rem;
    align-items: start;
  }

  .editorial-copy {
    position: sticky;
    top: 7rem;
  }

  .editorial-copy h2,
  .theme-map-head h2,
  .insights-cta h2 {
    color: #f4f1e8;
    letter-spacing: 0;
  }

  .editorial-copy p,
  .insights-cta p {
    max-width: 690px;
    margin-top: 1rem;
    color: #d8d6ce;
    font-size: 1.05rem;
    line-height: 1.68;
  }

  .editorial-feed {
    display: grid;
    gap: 1rem;
  }

  .featured-article,
  .article-list article {
    padding: 1.25rem;
    border: 1px solid rgba(244, 241, 232, 0.12);
    border-radius: var(--ma-radius);
    background:
      linear-gradient(90deg, rgba(5, 204, 144, 0.055), transparent 46%),
      rgba(11, 16, 26, 0.7);
  }

  .featured-article {
    min-height: 280px;
  }

  .article-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
    color: var(--ma-mint);
    font-family: var(--ma-font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .article-meta time {
    color: var(--ma-text-dim);
  }

  .featured-article h3,
  .article-list h3 {
    margin: 1rem 0 0.65rem;
    color: #f4f1e8;
    font-size: clamp(1.25rem, 2.2vw, 1.8rem);
    letter-spacing: 0;
  }

  .article-list h3 {
    font-size: 1.12rem;
  }

  .featured-article a,
  .article-list a {
    color: inherit;
    text-decoration: none;
  }

  .featured-article a:hover,
  .article-list a:hover {
    color: var(--ma-mint);
  }

  .featured-article p,
  .article-list p {
    color: #d8d6ce;
    line-height: 1.62;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }

  .article-tags span {
    padding: 0.35rem 0.55rem;
    border: 1px solid rgba(5, 204, 144, 0.24);
    border-radius: 999px;
    color: var(--ma-mint);
    font-size: 0.74rem;
  }

  .theme-map-section {
    background:
      linear-gradient(
        135deg,
        rgba(5, 204, 144, 0.08),
        rgba(124, 139, 255, 0.05)
      );
    border-top: 1px solid var(--ma-border);
  }

  .theme-map-head {
    max-width: 780px;
    margin-bottom: 2.5rem;
  }

  .insights-cta {
    padding: 5.8rem 0;
    text-align: center;
    background:
      radial-gradient(
        circle at 50% 8%,
        rgba(5, 204, 144, 0.14),
        transparent 27rem
      );
  }

  .insights-cta-inner {
    max-width: 900px;
  }

  .insights-cta p {
    margin-right: auto;
    margin-left: auto;
  }

  .insights-cta .insights-actions {
    justify-content: center;
  }

  @media (max-width: 1120px) {
    .insights-hero-inner,
    .editorial-grid {
      grid-template-columns: 1fr;
    }

    .editorial-copy {
      position: static;
    }

    .theme-strip,
    .theme-map,
    .article-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .insights-hero {
      min-height: auto;
      padding: 7rem 0 3.5rem;
    }

    .insights-copy h1 {
      font-size: 2.42rem;
      line-height: 1.04;
    }

    .insights-copy p,
    .editorial-copy p,
    .insights-cta p {
      font-size: 1rem;
    }

    .insights-actions {
      display: grid;
      width: 100%;
      justify-content: stretch;
    }

    .insights-cta .insights-actions {
      justify-content: stretch;
    }

    .insights-actions .ma-btn {
      justify-content: center;
      width: 100%;
    }

    .signal-console {
      padding: 1rem;
    }

    .signal-console-top {
      display: grid;
      gap: 0.25rem;
    }

    .signal-visual {
      aspect-ratio: 4 / 3;
    }

    .browser-depth-visual iframe {
      transform: scale(0.82);
      transform-origin: center;
    }
  }
</style>

---
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

const phases = [
  {
    id: 'discover',
    code: '01',
    title: 'Discover',
    question: 'Is the problem clear enough to deserve money?',
    promise: 'Make the problem clear enough to choose a responsible route.',
    detail:
      'Understand users, workflow, data, systems, risk, ownership and the business decision the work must improve.',
    evidence:
      'Current-state map, constraints, success criteria and recommended first route.',
  },
  {
    id: 'prove',
    code: '02',
    title: 'Prove',
    question: 'Is the value real outside a slide?',
    promise: 'Test the smallest convincing version of value.',
    detail:
      'Create a focused PoC around one workflow, data path, decision surface, agent behaviour or integration risk.',
    evidence:
      'Evidence of feasibility, value, limits and what must be true before MVP.',
  },
  {
    id: 'build',
    code: '03',
    title: 'Build',
    question: 'Can real users touch it without it breaking?',
    promise: 'Turn the proven core into something real users can touch.',
    detail:
      'Build an MVP with usable interfaces, real data pathways, controls, support assumptions and delivery-grade architecture.',
    evidence:
      'Working MVP, measured behaviours, operational feedback and launch-readiness gaps.',
  },
  {
    id: 'pilot',
    code: '04',
    title: 'Pilot',
    question: 'Does it survive actual operations?',
    promise: 'Run safely inside a controlled operational setting.',
    detail:
      'Test with users, measure adoption, expose edge cases, refine controls and decide whether the system should scale.',
    evidence:
      'Pilot findings, adoption signals, risk updates and scale/no-scale recommendation.',
  },
  {
    id: 'launch',
    code: '05',
    title: 'Launch',
    question: "Who owns it when it's live?",
    promise:
      'Scale the system with ownership, monitoring and improvement cycles.',
    detail:
      'Move into live use with support, documentation, monitoring, feedback loops and a clear improvement backlog.',
    evidence:
      'Live system, handover, monitoring model and next improvement route.',
  },
];

const safeguards = [
  'Human approval loops where decisions carry risk.',
  'Permissions and data boundaries defined before scale.',
  'Operational support model agreed before launch.',
  'Measurement tied to effort, visibility, speed or safety.',
];

const routeLinks = [
  {
    label: 'AI Adoption Readiness',
    href: '/programmes/ai-adoption-readiness/',
    note: 'When the starting point is unclear.',
  },
  {
    label: 'AI Foundry',
    href: '/programmes/ai-foundry/',
    note: 'When the team needs evidence and confidence.',
  },
  {
    label: 'Solutions',
    href: '/solutions/',
    note: 'When a use case is ready to shape.',
  },
];
---

<Layout
  title="Process, five evidence gates from idea to live system | Digital Technology Partner"
  description="DTP's delivery method: Discover, Prove, Build, Pilot, Launch. Every gate demands evidence and includes the right to stop. That's what keeps the work fast and honest."
>
  <Header />
  <main class="process-page">
    <section class="process-hero" aria-labelledby="process-title">
      <div class="process-grid"></div>
      <div class="ma-container process-hero-inner">
        <div class="process-copy" data-process-reveal>
          <span class="ma-section-tag">// the_right_to_stop</span>
          <h1 id="process-title">
            Every gate includes the right to stop. That's why the work moves
            fast.
          </h1>
          <p>
            DTP delivery runs through five evidence gates: Discover, Prove,
            Build, Pilot, Launch. Each one buys information before anything
            costs scale, and stopping at any of them is a result, not a failure.
          </p>
          <div class="process-actions">
            <a class="ma-btn ma-btn-mint" href="/contact/"
              >Talk through your route</a
            >
            <a class="ma-btn ma-btn-outline" href="/solutions/"
              >See solution types</a
            >
          </div>
        </div>

        <aside
          class="delivery-console"
          aria-label="Animated DTP delivery corridor"
          data-process-reveal
        >
          <div class="delivery-console-top">
            <span>delivery corridor</span>
            <strong id="phase-console-title">Discover</strong>
          </div>
          <div class="delivery-visual">
            <canvas id="delivery-corridor-scene" aria-hidden="true"></canvas>
            <span class="gate-label gate-label-one">scope</span>
            <span class="gate-label gate-label-two">proof</span>
            <span class="gate-label gate-label-three">pilot</span>
          </div>
          <div class="phase-readout" aria-live="polite">
            <span id="phase-console-promise">{phases[0].promise}</span>
          </div>
        </aside>
      </div>
    </section>

    <section class="ma-section phase-section">
      <div class="ma-container phase-layout">
        <div class="phase-sticky" data-process-reveal>
          <span class="ma-section-tag">// gate_sequence</span>
          <h2>Progress is earned by evidence, not optimism.</h2>
          <p>
            Each gate buys information before it costs scale. The gate is passed
            when the evidence is strong enough, and closed without shame when it
            isn't.
          </p>
          <div class="phase-progress" aria-hidden="true">
            <span></span>
          </div>
        </div>

        <div class="phase-stack" aria-label="DTP delivery phases">
          {
            phases.map((phase, index) => (
              <article
                class="phase-panel"
                data-process-card
                data-phase-id={phase.id}
                data-phase-index={index}
                data-phase-title={phase.title}
                data-phase-promise={phase.promise}
              >
                <span>{phase.code}</span>
                <p class="phase-question">{phase.question}</p>
                <h3>{phase.title}</h3>
                <strong>{phase.promise}</strong>
                <p>{phase.detail}</p>
                <div>
                  <small>Evidence gate</small>
                  <p>{phase.evidence}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ma-section safeguard-section">
      <div class="ma-container safeguard-grid">
        <div data-process-reveal>
          <span class="ma-section-tag">// delivery_safeguards</span>
          <h2>Controls are part of the build, not decoration at the end.</h2>
          <p>
            The process works because governance, adoption and technical reality
            are handled while the system is being shaped.
          </p>
        </div>
        <div class="safeguard-list">
          {safeguards.map((item) => <p data-process-card>{item}</p>)}
          <p class="safeguard-note" data-process-card>
            We publish the method because the method isn't the moat. Judgement
            is.
          </p>
        </div>
      </div>
    </section>

    <section class="ma-section route-section">
      <div class="ma-container">
        <div class="route-head" data-process-reveal>
          <span class="ma-section-tag">// choose_entry_point</span>
          <h2>Enter the process at the right level of certainty.</h2>
        </div>
        <div class="route-grid">
          {
            routeLinks.map((route) => (
              <a class="route-card" href={route.href} data-process-card>
                <strong>{route.label}</strong>
                <span>{route.note}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="process-cta">
      <div class="ma-container process-cta-inner" data-process-reveal>
        <span class="ma-section-tag">// make_the_next_gate_clear</span>
        <h2>
          Not every idea needs a build. Every serious idea needs a responsible
          next gate.
        </h2>
        <div class="process-actions">
          <a class="ma-btn ma-btn-mint ma-btn-lg" href="/contact/"
            >Talk through your route</a
          >
          <a class="ma-btn ma-btn-outline ma-btn-lg" href="/why-dtp/">Why DTP</a
          >
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;
  const canvas = document.getElementById(
    'delivery-corridor-scene'
  ) as HTMLCanvasElement | null;
  const gsapReady = import('gsap');
  const phasePanels = Array.from(
    document.querySelectorAll('[data-phase-id]')
  ) as HTMLElement[];
  const consoleTitle = document.getElementById('phase-console-title');
  const consolePromise = document.getElementById('phase-console-promise');

  const setActivePhaseDom = async (panel: HTMLElement) => {
    phasePanels.forEach((item) =>
      item.classList.toggle('active', item === panel)
    );
    if (consoleTitle) consoleTitle.textContent = panel.dataset.phaseTitle || '';
    if (consolePromise) {
      if (reducedMotion) {
        consolePromise.textContent = panel.dataset.phasePromise || '';
      } else {
        const { gsap } = await gsapReady;
        gsap.to(consolePromise, {
          opacity: 0,
          y: 6,
          duration: 0.12,
          ease: 'power2.out',
          onComplete: () => {
            consolePromise.textContent = panel.dataset.phasePromise || '';
            gsap.to(consolePromise, {
              opacity: 1,
              y: 0,
              duration: 0.24,
              ease: 'power3.out',
            });
          },
        });
      }
    }
    document.dispatchEvent(
      new CustomEvent('delivery-phase-focus', {
        detail: {
          index: Number(panel.dataset.phaseIndex || 0),
          id: panel.dataset.phaseId,
        },
      })
    );
  };

  phasePanels.forEach((panel) => {
    panel.addEventListener('pointerenter', () => void setActivePhaseDom(panel));
    panel.addEventListener('focusin', () => void setActivePhaseDom(panel));
  });
  if (phasePanels[0]) void setActivePhaseDom(phasePanels[0]);

  if (canvas) {
    const [THREE, gsapModule] = await Promise.all([import('three'), gsapReady]);
    const { gsap } = gsapModule;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.6));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
    camera.position.set(0, 0.18, 8.8);

    const group = new THREE.Group();
    scene.add(group);

    const mint = new THREE.Color('#00e5a0');
    const blue = new THREE.Color('#7c8bff');
    const amber = new THREE.Color('#f4c84a');
    const ivory = new THREE.Color('#f4f1e8');
    const materials: THREE.Material[] = [];
    const geometries: THREE.BufferGeometry[] = [];
    const gates: THREE.Mesh[] = [];
    const lanes: THREE.Line[] = [];
    const focusState = {
      targetX: -2.4,
      yaw: -0.08,
      zoom: 8.8,
      particleOpacity: 0.62,
    };

    const gateX = [-2.8, -1.4, 0, 1.4, 2.8];

    const makeMaterial = (color: THREE.Color, opacity: number) => {
      const material = new THREE.MeshBasicMaterial({
        color,
        transparent: true,
        opacity,
        depthWrite: false,
        side: THREE.DoubleSide,
      });
      materials.push(material);
      return material;
    };

    gateX.forEach((x, index) => {
      const color =
        index === 0
          ? mint
          : index === 4
            ? amber
            : index % 2 === 0
              ? blue
              : ivory;
      const ring = new THREE.Mesh(
        new THREE.TorusGeometry(0.42, 0.014, 12, 96),
        makeMaterial(color, index === 0 ? 0.78 : 0.28)
      );
      ring.position.set(x, 0, 0);
      ring.rotation.y = Math.PI / 2;
      ring.userData.focusOpacity = index === 0 ? 0.78 : 0.28;
      ring.userData.focusScale = index === 0 ? 1.18 : 0.92;
      group.add(ring);
      gates.push(ring);

      const core = new THREE.Mesh(
        new THREE.SphereGeometry(0.055, 20, 20),
        makeMaterial(color, index === 0 ? 0.95 : 0.54)
      );
      core.position.set(x, 0, 0);
      core.userData.focusOpacity = index === 0 ? 0.95 : 0.54;
      core.userData.focusScale = index === 0 ? 1.2 : 0.92;
      group.add(core);
      gates.push(core);
    });

    const makeLane = (y: number, z: number, color: THREE.Color) => {
      const geometry = new THREE.BufferGeometry().setFromPoints([
        new THREE.Vector3(-3.25, y, z),
        new THREE.Vector3(3.25, y, z),
      ]);
      geometries.push(geometry);
      const material = new THREE.LineBasicMaterial({
        color,
        transparent: true,
        opacity: 0.22,
      });
      materials.push(material);
      const line = new THREE.Line(geometry, material);
      line.userData.focusOpacity = 0.22;
      group.add(line);
      lanes.push(line);
    };

    makeLane(0.82, -0.18, mint);
    makeLane(-0.82, -0.18, blue);
    makeLane(0, 0.22, ivory);

    const particleCount = 760;
    const particlePositions = new Float32Array(particleCount * 3);
    const particleColors = new Float32Array(particleCount * 3);
    for (let i = 0; i < particleCount; i += 1) {
      const x = -3.3 + Math.random() * 6.6;
      const y = (Math.random() - 0.5) * 1.85;
      const z = (Math.random() - 0.5) * 0.72;
      particlePositions[i * 3] = x;
      particlePositions[i * 3 + 1] = y;
      particlePositions[i * 3 + 2] = z;
      const color =
        i % 11 === 0 ? amber : i % 5 === 0 ? blue : i % 3 === 0 ? ivory : mint;
      particleColors[i * 3] = color.r;
      particleColors[i * 3 + 1] = color.g;
      particleColors[i * 3 + 2] = color.b;
    }

    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute(
      'position',
      new THREE.BufferAttribute(particlePositions, 3)
    );
    particleGeometry.setAttribute(
      'color',
      new THREE.BufferAttribute(particleColors, 3)
    );
    const particles = new THREE.Points(
      particleGeometry,
      new THREE.PointsMaterial({
        size: 0.024,
        vertexColors: true,
        transparent: true,
        opacity: 0.62,
        depthWrite: false,
      })
    );
    group.add(particles);

    const focusPhase = (index: number) => {
      const clamped = Math.max(0, Math.min(gateX.length - 1, index));
      gsap.to(focusState, {
        targetX: gateX[clamped],
        yaw: -0.12 + clamped * 0.06,
        zoom: 8.8 - clamped * 0.12,
        particleOpacity: 0.62 + clamped * 0.06,
        duration: reducedMotion ? 0 : 0.72,
        ease: 'power3.out',
      });
      gates.forEach((gate, gateIndex) => {
        const phaseIndex = Math.floor(gateIndex / 2);
        const active = phaseIndex === clamped;
        const passed = phaseIndex < clamped;
        gsap.to(gate.userData, {
          focusScale: active ? 1.38 : passed ? 1.08 : 0.9,
          focusOpacity: active ? 0.92 : passed ? 0.5 : 0.22,
          duration: reducedMotion ? 0 : 0.45,
          ease: 'back.out(1.5)',
        });
      });
      lanes.forEach((lane) => {
        gsap.to(lane.userData, {
          focusOpacity: 0.2 + clamped * 0.045,
          duration: reducedMotion ? 0 : 0.4,
          ease: 'power2.out',
        });
      });
    };

    const onPhaseFocus = (event: Event) => {
      const phaseEvent = event as CustomEvent<{ index: number }>;
      focusPhase(phaseEvent.detail.index);
    };
    document.addEventListener(
      'delivery-phase-focus',
      onPhaseFocus as EventListener
    );
    focusPhase(0);

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const width = Math.max(rect.width, 1);
      const height = Math.max(rect.height, 1);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      group.scale.setScalar(window.innerWidth < 760 ? 0.72 : 1);
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    const pointer = { x: 0, y: 0 };
    const onPointerMove = (event: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = ((event.clientX - rect.left) / rect.width - 0.5) * 0.18;
      pointer.y = ((event.clientY - rect.top) / rect.height - 0.5) * 0.12;
    };
    canvas.addEventListener('pointermove', onPointerMove);

    if (!reducedMotion) {
      gsap.from('[data-process-reveal]', {
        opacity: 0,
        y: 24,
        duration: 0.84,
        ease: 'power3.out',
        stagger: 0.12,
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            gsap.to(entry.target, {
              opacity: 1,
              y: 0,
              duration: 0.66,
              ease: 'power3.out',
            });
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.18 }
      );
      document.querySelectorAll('[data-process-card]').forEach((element) => {
        gsap.set(element, { opacity: 0, y: 24 });
        observer.observe(element);
      });
    }

    const start = window.performance.now();
    let frame = 0;
    const render = () => {
      const t = (window.performance.now() - start) / 1000;
      if (!reducedMotion) {
        group.rotation.y +=
          (focusState.yaw + pointer.x - group.rotation.y) * 0.026;
        group.rotation.x += (-0.12 + pointer.y - group.rotation.x) * 0.024;
        camera.position.z += (focusState.zoom - camera.position.z) * 0.035;
        camera.position.x +=
          (focusState.targetX * 0.12 - camera.position.x) * 0.03;
        particles.rotation.z += 0.00055;
        (particles.material as THREE.PointsMaterial).opacity +=
          (focusState.particleOpacity -
            (particles.material as THREE.PointsMaterial).opacity) *
          0.04;
        gates.forEach((gate, index) => {
          const material = gate.material as THREE.MeshBasicMaterial;
          const pulse = Math.sin(t * 1.75 + index * 0.4) * 0.045;
          gate.scale.setScalar((gate.userData.focusScale ?? 1) + pulse);
          material.opacity = gate.userData.focusOpacity ?? material.opacity;
          gate.rotation.z = t * (0.08 + Math.floor(index / 2) * 0.01);
        });
        lanes.forEach((lane, index) => {
          const material = lane.material as THREE.LineBasicMaterial;
          material.opacity =
            (lane.userData.focusOpacity ?? 0.2) +
            Math.sin(t * 1.2 + index) * 0.026;
        });
      }
      renderer.render(scene, camera);
      frame = window.requestAnimationFrame(render);
    };
    render();

    document.addEventListener('astro:before-swap', () => {
      window.cancelAnimationFrame(frame);
      window.removeEventListener('resize', resize);
      canvas.removeEventListener('pointermove', onPointerMove);
      document.removeEventListener(
        'delivery-phase-focus',
        onPhaseFocus as EventListener
      );
      renderer.dispose();
      particleGeometry.dispose();
      geometries.forEach((geometry) => geometry.dispose());
      materials.forEach((material) => material.dispose());
    });
  }

  if (!reducedMotion) {
    const { gsap } = await gsapReady;
    const { ScrollTrigger } = await import('gsap/ScrollTrigger');
    gsap.registerPlugin(ScrollTrigger);

    const progressTween = gsap.to('.phase-progress span', {
      scaleX: 1,
      ease: 'none',
      scrollTrigger: {
        trigger: '.phase-stack',
        start: 'top 72%',
        end: 'bottom 58%',
        scrub: 0.55,
      },
    });

    const phaseTriggers = phasePanels.map((panel) =>
      ScrollTrigger.create({
        trigger: panel,
        start: 'top 54%',
        end: 'bottom 54%',
        onEnter: () => void setActivePhaseDom(panel),
        onEnterBack: () => void setActivePhaseDom(panel),
      })
    );

    document.addEventListener('astro:before-swap', () => {
      progressTween.scrollTrigger?.kill();
      progressTween.kill();
      phaseTriggers.forEach((trigger) => trigger.kill());
    });
  }
</script>

<style>
  .process-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 16% 10%,
        rgba(0, 229, 160, 0.12),
        transparent 31rem
      ),
      radial-gradient(
        circle at 78% 18%,
        rgba(124, 139, 255, 0.1),
        transparent 30rem
      ),
      linear-gradient(135deg, #000 0%, #080812 56%, #000 100%);
    color: var(--ma-text);
  }

  .process-hero {
    position: relative;
    min-height: 90vh;
    padding: 7.35rem 0 3.8rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid rgba(244, 241, 232, 0.1);
  }

  .process-grid {
    position: absolute;
    inset: 0;
    opacity: 0.13;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(244, 241, 232, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 232, 0.035) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: radial-gradient(
      ellipse 78% 74% at 62% 46%,
      black,
      transparent 86%
    );
  }

  .process-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(420px, 0.82fr);
    gap: 3rem;
    align-items: center;
  }

  .process-copy h1 {
    max-width: 870px;
    margin-bottom: 1.3rem;
    color: #f4f1e8;
    font-size: clamp(2.95rem, 5vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .process-copy p {
    max-width: 690px;
    color: #d8d6ce;
    font-size: 1.1rem;
    line-height: 1.68;
  }

  .process-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .delivery-console {
    position: relative;
    overflow: hidden;
    padding: 1.25rem;
    border: 1px solid rgba(244, 241, 232, 0.14);
    border-radius: var(--ma-radius);
    background:
      radial-gradient(
        circle at 48% 42%,
        rgba(0, 229, 160, 0.13),
        transparent 22rem
      ),
      linear-gradient(145deg, rgba(17, 17, 34, 0.84), rgba(0, 0, 0, 0.5));
    box-shadow: 0 34px 100px rgba(0, 0, 0, 0.32);
  }

  .delivery-console::before {
    content: '';
    position: absolute;
    inset: 1rem;
    border: 1px solid rgba(0, 229, 160, 0.08);
    border-radius: 6px;
    pointer-events: none;
  }

  .delivery-console-top,
  .phase-readout {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ma-text-dim);
    font-family: var(--ma-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .delivery-console-top strong {
    color: var(--ma-mint);
    font-weight: 500;
  }

  .delivery-visual {
    position: relative;
    min-height: 430px;
    margin: 0.45rem 0 0.9rem;
    overflow: hidden;
  }

  .delivery-visual canvas {
    display: block;
    width: 100%;
    height: 430px;
  }

  .gate-label {
    position: absolute;
    z-index: 2;
    color: var(--ma-mint);
    font-family: var(--ma-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-shadow: 0 0 18px rgba(0, 229, 160, 0.48);
    pointer-events: none;
  }

  .gate-label-one {
    left: 16%;
    top: 32%;
  }

  .gate-label-two {
    left: 47%;
    top: 20%;
    color: #7c8bff;
  }

  .gate-label-three {
    right: 12%;
    bottom: 28%;
    color: #f4c84a;
  }

  .phase-readout {
    display: block;
    min-height: 56px;
    padding: 0.82rem;
    border: 1px solid rgba(244, 241, 232, 0.1);
    border-radius: var(--ma-radius);
    background: rgba(0, 0, 0, 0.36);
    color: #d8d6ce;
    line-height: 1.4;
  }

  .phase-section {

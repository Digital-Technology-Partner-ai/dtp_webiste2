---
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

const bookingUrl =
  'https://outlook.office.com/bookwithme/user/f0762b9af6a94ed2add9818a4f3ca4e5@digitaltechnologypartner.ai/meetingtype/qc2lOXjEdkO6GkMS_jZJrQ2?anonymous';

const solutionCategories = [
  {
    id: 'systems',
    eyebrow: '01 / strategy',
    title: 'Business systems strategy',
    copy:
      'Map the current estate, expose friction, define the target operating picture and turn scattered requirements into a phased technical roadmap.',
    outcomes: ['Current-state map', 'Architecture options', 'Prioritised roadmap'],
    signal: 'fragmented estate',
    mode: 'target architecture',
    result: 'sequenced roadmap',
  },
  {
    id: 'data',
    eyebrow: '02 / visibility',
    title: 'Data and reporting',
    copy:
      'Bring operational data into view with dashboards, alerts and decision surfaces that make progress, risk and exceptions easier to act on.',
    outcomes: ['Leadership dashboards', 'Operational alerts', 'Data quality signals'],
    signal: 'hidden signals',
    mode: 'decision surface',
    result: 'visible exceptions',
  },
  {
    id: 'workflow',
    eyebrow: '03 / automation',
    title: 'Workflow automation',
    copy:
      'Remove manual steps from document handling, task routing, approvals and handoffs while keeping people in control of the moments that matter.',
    outcomes: ['Document processing', 'Task routing', 'Human approval loops'],
    signal: 'manual drag',
    mode: 'workflow routing',
    result: 'fewer handoffs',
  },
  {
    id: 'agents',
    eyebrow: '04 / controlled ai',
    title: 'AI agents and copilots',
    copy:
      'Design controlled agents that work inside real operating constraints: permissions, audit trails, escalation paths, data boundaries and measurable value.',
    outcomes: ['Messaging-native agents', 'Operational copilots', 'Governed escalation'],
    signal: 'repeatable judgement',
    mode: 'controlled copilot',
    result: 'auditable support',
  },
  {
    id: 'bespoke',
    eyebrow: '05 / custom systems',
    title: 'Bespoke AI systems',
    copy:
      'Build custom AI-enabled products, search layers, knowledge tools and workflow systems when off-the-shelf software cannot match the work.',
    outcomes: ['Custom interfaces', 'Search and retrieval', 'Production integrations'],
    signal: 'specialist workflow',
    mode: 'bespoke system',
    result: 'fit-for-purpose tool',
  },
];

const decisionRoutes = [
  {
    trigger: 'clarity',
    label: 'We need clarity',
    fit: 'Start with systems strategy.',
    body:
      'Use this when leaders know there is value somewhere, but the problem, ownership, constraints or sequence are still too fuzzy to build safely.',
    next: 'Discovery or AI Adoption Readiness',
  },
  {
    trigger: 'visibility',
    label: 'We need visibility',
    fit: 'Start with data and reporting.',
    body:
      'Use this when decisions are slowed by spreadsheets, missing signals, inconsistent reports or operational exceptions that surface too late.',
    next: 'Data audit, dashboard prototype, alert design',
  },
  {
    trigger: 'manual',
    label: 'We need less manual work',
    fit: 'Start with workflow automation.',
    body:
      'Use this when teams are losing time to repeatable document, routing, checking, quoting, approval or coordination work.',
    next: 'Workflow map, automation PoC, controlled MVP',
  },
  {
    trigger: 'assistant',
    label: 'We need an AI assistant',
    fit: 'Start with controlled agents.',
    body:
      'Use this when the organisation wants an agent or copilot, but needs guardrails around data, permissions, reliability and escalation.',
    next: 'Agent design sprint, governance model, pilot',
  },
  {
    trigger: 'custom',
    label: 'Nothing fits',
    fit: 'Start with bespoke system design.',
    body:
      'Use this when the workflow is specialised enough that value depends on a custom interface, model workflow, integration layer or product experience.',
    next: 'Technical discovery, prototype, MVP route',
  },
];

const deliveryPath = [
  {
    phase: 'Discover',
    detail: 'Understand users, data, systems, risk and the business decision the build must improve.',
  },
  {
    phase: 'Prove',
    detail: 'Create the smallest convincing test of value before asking the organisation to fund the full idea.',
  },
  {
    phase: 'Build',
    detail: 'Turn the proven core into an MVP that can survive real users, real data and real constraints.',
  },
  {
    phase: 'Pilot',
    detail: 'Run in a controlled setting, measure behaviour, refine adoption and expose operational edge cases.',
  },
  {
    phase: 'Launch',
    detail: 'Scale with support, monitoring, improvement cycles and clear ownership after go-live.',
  },
];

const proofPoints = [
  {
    stat: '40% faster quotation preparation',
    copy: 'AI-assisted document and calculation workflows reduced effort around technical quotation work.',
  },
  {
    stat: 'Zero missed maintenance tasks',
    copy: 'A messaging-native operational agent kept production floor maintenance visible and accountable.',
  },
  {
    stat: 'Controlled architecture for AI search',
    copy: 'Custom AI/ML and vector-search systems can be designed around security, context and practical use.',
  },
];
---

<Layout
  title="Solutions - Digital Technology Partner"
  description="Practical AI and digital systems for business systems strategy, data, reporting, automation, AI agents and bespoke systems."
>
  <Header />
  <main class="solution-page">
    <section class="solution-hero" aria-labelledby="solution-title">
      <div class="solution-grid-bg"></div>
      <div class="solution-scan"></div>
      <div class="ma-container solution-hero-grid">
        <div class="solution-copy">
          <span class="ma-section-tag">// solution_engine</span>
          <h1 id="solution-title" data-solution-reveal>
            Useful AI starts with the work your organisation needs to improve.
          </h1>
          <p data-solution-reveal>
            DTP designs and builds practical systems around workflow, data, people and governance.
            The aim is measurable operational value, not isolated tools.
          </p>
          <div class="solution-actions" data-solution-reveal>
            <a class="ma-btn ma-btn-mint" href={bookingUrl} target="_blank" rel="noopener noreferrer">
              Talk through a business problem
            </a>
            <a class="ma-btn ma-btn-outline" href="/process/">See the delivery path</a>
          </div>
        </div>

        <aside class="engine-panel" aria-label="Animated DTP solution engine">
          <div class="engine-topline">
            <span>solution engine</span>
            <strong>Problem -> System -> Outcome</strong>
          </div>
          <div class="engine-visual">
            <canvas id="solution-engine-scene" aria-hidden="true"></canvas>
            <span class="engine-label engine-label-work">work</span>
            <span class="engine-label engine-label-data">data</span>
            <span class="engine-label engine-label-control">control</span>
            <span class="engine-label engine-label-value">value</span>
          </div>
          <div class="engine-ledger">
            <span data-engine-ledger="signal">input: messy workflow</span>
            <span data-engine-ledger="mode">filter: governance</span>
            <span data-engine-ledger="result">output: useful system</span>
          </div>
        </aside>

        <dl class="solution-metrics" data-solution-reveal>
          <div>
            <dt>Business first</dt>
            <dd>Workflow, risk and value before tooling.</dd>
          </div>
          <div>
            <dt>Controlled AI</dt>
            <dd>Permissions, audit and human oversight by design.</dd>
          </div>
          <div>
            <dt>Delivery-grade</dt>
            <dd>Stage-gated from idea to live system.</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="ma-section engine-intro">
      <div class="ma-container intro-grid">
        <div data-solution-reveal>
          <span class="ma-section-tag">// business_problem_first</span>
          <h2>The solution is chosen after the work is understood.</h2>
        </div>
        <div class="intro-copy" data-solution-reveal>
          <p>
            AI projects become expensive when the tool is selected before the workflow is understood.
            DTP starts with the operating problem: where time is lost, where decisions are weak,
            where data is hidden and where a system would create measurable value.
          </p>
          <p>
            From there, the answer might be a dashboard, an automation, an agent, a custom
            interface or a staged roadmap. The right solution is the one that fits the work.
          </p>
        </div>
      </div>
    </section>

    <section class="ma-section solution-catalogue">
      <div class="ma-container">
        <div class="catalogue-head" data-solution-reveal>
          <span class="ma-section-tag">// practical_catalogue</span>
          <h2>Five kinds of practical build work.</h2>
          <p>
            Each route can stand alone, but the strongest work usually combines strategy,
            data, workflow design and controlled AI into one useful operating system.
          </p>
        </div>
        <div class="catalogue-rail" aria-label="DTP solution categories">
          {solutionCategories.map((category) => (
            <article class="solution-module" data-solution-card data-engine-id={category.id}>
              <button
                type="button"
                class="solution-module-hit"
                data-engine-select={category.id}
                data-engine-signal={category.signal}
                data-engine-mode={category.mode}
                data-engine-result={category.result}
                aria-label={`Tune the engine to ${category.title}`}
              ></button>
              <span>{category.eyebrow}</span>
              <h3>{category.title}</h3>
              <p>{category.copy}</p>
              <ul>
                {category.outcomes.map((outcome) => <li>{outcome}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ma-section decision-section" aria-labelledby="decision-title">
      <div class="ma-container decision-grid">
        <div class="decision-copy" data-solution-reveal>
          <span class="ma-section-tag">// decision_engine</span>
          <h2 id="decision-title">Match the route to the problem signal.</h2>
          <p>
            Buyers often arrive with a tool in mind. This chooser keeps the conversation anchored
            to the business condition that actually needs to change.
          </p>
        </div>
        <div class="decision-console" data-solution-reveal>
          <div class="decision-triggers" role="tablist" aria-label="Problem signals">
            {decisionRoutes.map((route, index) => (
              <button
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                class:list={['decision-trigger', { active: index === 0 }]}
                data-route-trigger={route.trigger}
                data-fit={route.fit}
                data-body={route.body}
                data-next={route.next}
              >
                {route.label}
              </button>
            ))}
          </div>
          <article class="decision-output" aria-live="polite">
            <span>recommended route</span>
            <h3 id="decision-fit">{decisionRoutes[0].fit}</h3>
            <p id="decision-body">{decisionRoutes[0].body}</p>
            <strong id="decision-next">{decisionRoutes[0].next}</strong>
          </article>
        </div>
      </div>
    </section>

    <section class="ma-section delivery-section">
      <div class="ma-container">
        <div class="delivery-head" data-solution-reveal>
          <span class="ma-section-tag">// controlled_delivery</span>
          <h2>From business problem to live system, one gate at a time.</h2>
        </div>
        <div class="delivery-track-shell" data-solution-card>
          <div class="delivery-progress" aria-hidden="true"></div>
          <div class="delivery-track">
            {deliveryPath.map((step, index) => (
              <article data-delivery-step>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{step.phase}</h3>
                <p>{step.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="ma-section proof-section">
      <div class="ma-container proof-grid">
        <div class="proof-copy" data-solution-reveal>
          <span class="ma-section-tag">// proof_near_decision</span>
          <h2>Built for practical outcomes, not AI theatre.</h2>
          <p>
            The best solution pages earn trust by showing business evidence close to the next
            step. These are the types of operational gains DTP systems are built to create.
          </p>
        </div>
        <div class="proof-list">
          {proofPoints.map((point) => (
            <article data-solution-card>
              <strong>{point.stat}</strong>
              <p>{point.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="solution-cta">
      <div class="ma-container cta-inner" data-solution-reveal>
        <span class="ma-section-tag">// build_the_right_thing</span>
        <h2>Bring the business problem. We will help shape the system.</h2>
        <p>
          If the use case is ready, move into Discovery. If the signal is still unclear, start with
          Readiness or Foundry so the build earns its place.
        </p>
        <div class="cta-actions">
          <a class="ma-btn ma-btn-mint ma-btn-lg" href={bookingUrl} target="_blank" rel="noopener noreferrer">
            Talk through the build
          </a>
          <a class="ma-btn ma-btn-outline ma-btn-lg" href="/programmes/ai-adoption-readiness/">
            Start with readiness
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const canvas = document.getElementById('solution-engine-scene') as HTMLCanvasElement | null;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const gsapReady = import('gsap');

  const triggerButtons = Array.from(document.querySelectorAll('[data-route-trigger]')) as HTMLButtonElement[];
  const moduleButtons = Array.from(document.querySelectorAll('[data-engine-select]')) as HTMLButtonElement[];
  const moduleCards = Array.from(document.querySelectorAll('[data-engine-id]')) as HTMLElement[];
  const fitTarget = document.getElementById('decision-fit');
  const bodyTarget = document.getElementById('decision-body');
  const nextTarget = document.getElementById('decision-next');
  const ledgerTargets = {
    signal: document.querySelector('[data-engine-ledger="signal"]'),
    mode: document.querySelector('[data-engine-ledger="mode"]'),
    result: document.querySelector('[data-engine-ledger="result"]'),
  };

  const setDecisionRoute = async (button: HTMLButtonElement) => {
    const gsapModule = await gsapReady;
    const { gsap } = gsapModule;

    triggerButtons.forEach((item) => {
      const isActive = item === button;
      item.classList.toggle('active', isActive);
      item.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    const output = document.querySelector('.decision-output');
    if (output) {
      gsap.to(output, {
        opacity: 0,
        y: 8,
        duration: 0.14,
        ease: 'power2.out',
        onComplete: () => {
          if (fitTarget) fitTarget.textContent = button.dataset.fit || '';
          if (bodyTarget) bodyTarget.textContent = button.dataset.body || '';
          if (nextTarget) nextTarget.textContent = button.dataset.next || '';
          gsap.to(output, { opacity: 1, y: 0, duration: 0.28, ease: 'power3.out' });
        },
      });
    }
  };

  const updateLedger = async (button: HTMLButtonElement, animate = true) => {
    const values = {
      signal: `input: ${button.dataset.engineSignal || 'messy workflow'}`,
      mode: `filter: ${button.dataset.engineMode || 'governance'}`,
      result: `output: ${button.dataset.engineResult || 'useful system'}`,
    };

    if (!animate || reducedMotion) {
      Object.entries(values).forEach(([key, value]) => {
        ledgerTargets[key as keyof typeof ledgerTargets]!.textContent = value;
      });
      return;
    }

    const { gsap } = await gsapReady;
    const targets = Object.values(ledgerTargets).filter(Boolean);
    gsap.to(targets, {
      opacity: 0,
      y: 6,
      duration: 0.14,
      ease: 'power2.out',
      onComplete: () => {
        Object.entries(values).forEach(([key, value]) => {
          ledgerTargets[key as keyof typeof ledgerTargets]!.textContent = value;
        });
        gsap.to(targets, { opacity: 1, y: 0, duration: 0.28, ease: 'power3.out', stagger: 0.04 });
      },
    });
  };

  const setActiveEngineModule = async (button: HTMLButtonElement, animate = true) => {
    const id = button.dataset.engineSelect || '';
    moduleCards.forEach((card) => {
      card.classList.toggle('active', card.dataset.engineId === id);
    });
    await updateLedger(button, animate);
    document.dispatchEvent(new CustomEvent('solution-engine-focus', { detail: { id } }));
  };

  triggerButtons.forEach((button) => {
    button.addEventListener('click', () => {
      void setDecisionRoute(button);
    });
  });

  moduleButtons.forEach((button) => {
    button.addEventListener('pointerenter', () => {
      void setActiveEngineModule(button);
    });
    button.addEventListener('focus', () => {
      void setActiveEngineModule(button);
    });
    button.addEventListener('click', () => {
      void setActiveEngineModule(button);
    });
  });

  if (moduleButtons[0]) {
    void setActiveEngineModule(moduleButtons[0], false);
  }

  if (canvas) {
    const [THREE, gsapModule] = await Promise.all([import('three'), gsapReady]);
    const { gsap } = gsapModule;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    camera.position.set(0, 0.12, 8.8);

    const group = new THREE.Group();
    scene.add(group);

    const mint = new THREE.Color('#00e5a0');
    const ivory = new THREE.Color('#f4f1e8');
    const blue = new THREE.Color('#7c8bff');
    const amber = new THREE.Color('#f4c84a');

    const sharedMaterials: THREE.Material[] = [];
    const engineNodes: THREE.Mesh[] = [];
    const engineLines: THREE.Line[] = [];
    const focusState = {
      yaw: 0,
      pitch: -0.18,
      zoom: 8.8,
      particleOpacity: 0.62,
    };

    const nodePositions = [
      [0, 0, 0],
      [-2.8, 1.25, 0.25],
      [-1.42, -1.75, -0.18],
      [1.38, 1.62, 0.12],
      [2.72, -0.95, 0.34],
      [0.22, -2.62, -0.26],
      [0.02, 2.62, -0.22],
    ] as Array<[number, number, number]>;

    const focusMap = {
      systems: { node: 1, yaw: -0.18, pitch: -0.08, zoom: 8.25, particleOpacity: 0.7 },
      data: { node: 2, yaw: 0.16, pitch: -0.24, zoom: 8.05, particleOpacity: 0.76 },
      workflow: { node: 3, yaw: -0.26, pitch: -0.28, zoom: 8.35, particleOpacity: 0.82 },
      agents: { node: 4, yaw: 0.24, pitch: -0.12, zoom: 8.0, particleOpacity: 0.88 },
      bespoke: { node: 5, yaw: 0.08, pitch: -0.34, zoom: 7.92, particleOpacity: 0.92 },
    } as const;

    const createMaterial = (color: typeof mint, opacity: number) => {
      const material = new THREE.MeshBasicMaterial({
        color,
        transparent: true,
        opacity,
        depthWrite: false,
      });
      sharedMaterials.push(material);
      return material;
    };

    const createNode = (position: [number, number, number], index: number) => {
      const color = index === 0 ? mint : index % 3 === 0 ? blue : index % 2 === 0 ? amber : ivory;
      const glow = new THREE.Mesh(
        new THREE.SphereGeometry(index === 0 ? 0.42 : 0.28, 28, 28),
        createMaterial(color, index === 0 ? 0.14 : 0.08)
      );
      glow.position.set(...position);
      group.add(glow);

      const node = new THREE.Mesh(
        new THREE.SphereGeometry(index === 0 ? 0.11 : 0.07, 24, 24),
        createMaterial(color, index === 0 ? 0.98 : 0.82)
      );
      node.position.set(...position);
      group.add(node);
      engineNodes.push(node, glow);
    };

    nodePositions.forEach(createNode);

    const createLine = (start: [number, number, number], end: [number, number, number], color = mint) => {
      const geometry = new THREE.BufferGeometry().setFromPoints([
        new THREE.Vector3(...start),
        new THREE.Vector3(...end),
      ]);
      const material = new THREE.LineBasicMaterial({
        color,
        transparent: true,
        opacity: color === mint ? 0.34 : 0.22,
      });
      sharedMaterials.push(material);
      const line = new THREE.Line(geometry, material);
      group.add(line);
      line.userData.focusOpacity = color === mint ? 0.34 : 0.22;
      engineLines.push(line);
      return geometry;
    };

    const lineGeometries = nodePositions.slice(1).map((position, index) =>
      createLine(nodePositions[0], position, index % 2 === 0 ? mint : ivory)
    );
    lineGeometries.push(createLine(nodePositions[1], nodePositions[3], blue));
    lineGeometries.push(createLine(nodePositions[2], nodePositions[4], amber));
    lineGeometries.push(createLine(nodePositions[5], nodePositions[6], mint));

    const ringMaterial = new THREE.MeshBasicMaterial({
      color: mint,
      transparent: true,
      opacity: 0.17,
      side: THREE.DoubleSide,
      depthWrite: false,
    });
    sharedMaterials.push(ringMaterial);

    const rings = [1.2, 2.05, 3.02].map((radius, index) => {
      const ring = new THREE.Mesh(new THREE.TorusGeometry(radius, 0.009, 12, 180), ringMaterial.clone());
      sharedMaterials.push(ring.material);
      ring.rotation.x = Math.PI / 2 + index * 0.2;
      ring.rotation.y = index * 0.26;
      group.add(ring);
      return ring;
    });

    const streamCount = 720;
    const positions = new Float32Array(streamCount * 3);
    const colors = new Float32Array(streamCount * 3);
    for (let i = 0; i < streamCount; i += 1) {
      const radius = 0.8 + Math.random() * 3.25;
      const angle = Math.random() * Math.PI * 2;
      const lift = (Math.random() - 0.5) * 1.2;
      positions[i * 3] = Math.cos(angle) * radius;
      positions[i * 3 + 1] = Math.sin(angle) * radius * 0.62 + lift * 0.1;
      positions[i * 3 + 2] = lift;

      const color = i % 11 === 0 ? amber : i % 5 === 0 ? blue : i % 3 === 0 ? ivory : mint;
      colors[i * 3] = color.r;
      colors[i * 3 + 1] = color.g;
      colors[i * 3 + 2] = color.b;
    }

    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    particleGeometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    const particles = new THREE.Points(
      particleGeometry,
      new THREE.PointsMaterial({
        size: 0.026,
        vertexColors: true,
        transparent: true,
        opacity: 0.62,
        depthWrite: false,
      })
    );
    group.add(particles);

    group.rotation.x = -0.18;

    const focusEngineScene = (id: keyof typeof focusMap | string) => {
      const target = focusMap[id as keyof typeof focusMap] || focusMap.systems;
      gsap.to(focusState, {
        yaw: target.yaw,
        pitch: target.pitch,
        zoom: target.zoom,
        particleOpacity: target.particleOpacity,
        duration: reducedMotion ? 0 : 0.72,
        ease: 'power3.out',
      });

      engineNodes.forEach((node, index) => {
        const pairIndex = Math.floor(index / 2);
        const isCore = pairIndex === 0;
        const isTarget = pairIndex === target.node;
        gsap.to(node.userData, {
          focusScale: isTarget ? 1.48 : isCore ? 1.16 : 0.96,
          duration: reducedMotion ? 0 : 0.48,
          ease: 'back.out(1.6)',
        });
      });

      engineLines.forEach((line, index) => {
        gsap.to(line.userData, {
          focusOpacity: index === target.node - 1 ? 0.58 : index < 6 ? 0.22 : 0.16,
          duration: reducedMotion ? 0 : 0.4,
          ease: 'power2.out',
        });
      });
    };

    const onEngineFocus = (event: Event) => {
      const focusEvent = event as CustomEvent<{ id: keyof typeof focusMap }>;
      focusEngineScene(focusEvent.detail.id);
    };

    document.addEventListener('solution-engine-focus', onEngineFocus as EventListener);
    focusEngineScene('systems');

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const width = Math.max(rect.width, 1);
      const height = Math.max(rect.height, 1);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      group.scale.setScalar(window.innerWidth < 720 ? 0.78 : 1);
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });

    if (!reducedMotion) {
      gsap.from('[data-solution-reveal]', {
        opacity: 0,
        y: 26,
        duration: 0.82,
        ease: 'power3.out',
        stagger: 0.13,
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            gsap.to(entry.target, {
              opacity: 1,
              y: 0,
              duration: 0.68,
              ease: 'power3.out',
            });
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.18 }
      );

      document.querySelectorAll('[data-solution-card]').forEach((element) => {
        gsap.set(element, { opacity: 0, y: 22 });
        observer.observe(element);
      });

      gsap.fromTo(
        '.engine-panel',
        { opacity: 0, y: 18, scale: 0.98 },
        { opacity: 1, y: 0, scale: 1, duration: 1.05, ease: 'power3.out', delay: 0.24 }
      );
    }

    const pointer = { x: 0, y: 0 };
    const onPointerMove = (event: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = ((event.clientX - rect.left) / rect.width - 0.5) * 0.18;
      pointer.y = ((event.clientY - rect.top) / rect.height - 0.5) * 0.12;
    };

    canvas.addEventListener('pointermove', onPointerMove);

    const startTime = window.performance.now();
    let frameId = 0;
    const render = () => {
      const t = (window.performance.now() - startTime) / 1000;
      if (!reducedMotion) {
        group.rotation.y += (pointer.x - group.rotation.y) * 0.025;
        group.rotation.x += (focusState.pitch + pointer.y - group.rotation.x) * 0.025;
        group.rotation.y += (focusState.yaw - group.rotation.y) * 0.014;
        camera.position.z += (focusState.zoom - camera.position.z) * 0.035;
        particles.rotation.z -= 0.00085;
        particles.rotation.y += 0.00045;
        (particles.material as THREE.PointsMaterial).opacity +=
          (focusState.particleOpacity - (particles.material as THREE.PointsMaterial).opacity) * 0.04;
        rings.forEach((ring, index) => {
          ring.rotation.z = t * (0.05 + index * 0.018);
        });
        engineNodes.forEach((node, index) => {
          const focusScale = node.userData.focusScale ?? 1;
          const pulse = Math.sin(t * 1.7 + index * 0.44) * 0.055;
          node.scale.setScalar(focusScale + pulse);
        });
        engineLines.forEach((line, index) => {
          const lineMaterial = line.material as THREE.LineBasicMaterial;
          const focusOpacity = line.userData.focusOpacity ?? 0.2;
          lineMaterial.opacity = focusOpacity + Math.sin(t * 1.35 + index) * 0.035;
        });
      }
      renderer.render(scene, camera);
      frameId = window.requestAnimationFrame(render);
    };

    render();

    document.addEventListener('astro:before-swap', () => {
      window.cancelAnimationFrame(frameId);
      window.removeEventListener('resize', resize);
      canvas.removeEventListener('pointermove', onPointerMove);
      document.removeEventListener('solution-engine-focus', onEngineFocus as EventListener);
      renderer.dispose();
      particleGeometry.dispose();
      lineGeometries.forEach((geometry) => geometry.dispose());
      sharedMaterials.forEach((material) => material.dispose());
    });
  }

  if (!reducedMotion) {
    const { gsap } = await gsapReady;
    const { ScrollTrigger } = await import('gsap/ScrollTrigger');
    gsap.registerPlugin(ScrollTrigger);

    gsap.set('[data-delivery-step]', { opacity: 0.48 });
    const deliveryTweens = [
      gsap.to('.delivery-progress', {
      scaleX: 1,
      ease: 'none',
      scrollTrigger: {
        trigger: '.delivery-track-shell',
        start: 'top 72%',
        end: 'bottom 42%',
        scrub: 0.5,
      },
      }),
    ];

    document.querySelectorAll('[data-delivery-step]').forEach((step) => {
      deliveryTweens.push(
        gsap.to(step, {
          opacity: 1,
          y: -4,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: step,
            start: 'top 72%',
            end: 'bottom 48%',
            scrub: 0.4,
          },
        })
      );
    });

    document.addEventListener('astro:before-swap', () => {
      deliveryTweens.forEach((tween) => {
        tween.scrollTrigger?.kill();
        tween.kill();
      });
    });
  }
</script>


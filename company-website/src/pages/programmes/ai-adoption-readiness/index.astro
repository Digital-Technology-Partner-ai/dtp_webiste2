---
import Header from '../../../components/Header.astro';
import Layout from '../../../layouts/Layout.astro';

const readinessLevels = [
  {
    mode: '// Broad scan',
    title: 'Readiness Snapshot',
    summary:
      'A fast, self-reported baseline for leadership teams that need an initial signal before deciding whether deeper assessment is justified.',
    bestFor:
      'Early clarity, budget shaping and deciding whether AI adoption needs more attention.',
  },
  {
    mode: '// Pattern and proof',
    title: 'Readiness Diagnostic',
    summary:
      'Structured answers plus AI-led interviews and listening sessions that expose adoption patterns, workflow drag, confidence gaps and risk signals.',
    bestFor:
      'When leadership needs evidence before choosing a route, sponsor or first serious use case.',
  },
  {
    mode: '// Decision judgement',
    title: 'Readiness Advisory',
    summary:
      'DTP interpretation and leadership discussion, turning the evidence into practical recommendations on what to fund, govern, investigate or stop.',
    bestFor:
      'When the organisation needs a trusted external view before committing people, budget or policy change.',
  },
];

const inspectionAreas = [
  'Current AI use and shadow adoption',
  'Workflow drag and missed value',
  'Permission, data and review gaps',
  'Governance maturity and policy clarity',
  'Staff confidence, fear and blockers',
  'Use cases worth encouraging, or parking',
];

const weekFlow = [
  {
    day: 'Day 01',
    title: 'Scope the map',
    text: 'Agree the leadership question, teams in scope, risk appetite and what a useful answer must look like.',
  },
  {
    day: 'Days 02 and 03',
    title: 'Gather the signal',
    text: 'Collect structured inputs and, where useful, run AI-led listening sessions to surface patterns across teams.',
  },
  {
    day: '04',
    title: 'Separate signal from noise',
    text: "Map where AI is helping, where it's risky, where adoption is blocked and which ideas should wait.",
  },
  {
    day: '05',
    title: 'Leadership readout',
    text: 'Discuss the evidence, the decision options and the practical route forward.',
  },
];

const mapPoints = [
  {
    title: 'Signal',
    text: 'workflows where AI is already saving time or improving judgement.',
  },
  {
    title: 'Risk',
    text: 'data exposure, weak ownership, poor review or unclear permission.',
  },
  {
    title: 'Noise',
    text: 'tool-chasing, theatre and ideas that should be parked.',
  },
  {
    title: 'Decision',
    text: 'what leadership should encourage, control, investigate or stop.',
  },
];

const leadershipOutputs = [
  'A current-state map of AI use, including what was invisible before',
  'A risk and opportunity summary in plain language',
  'Prioritised next actions, each with an owner-shaped edge',
  'A recommendation on the best route forward',
];

const nextRouteLinks = [
  { label: 'Explore Foundry', href: '/programmes/ai-foundry/' },
  { label: 'View Coaching', href: '/programmes/leadership-ai-coaching/' },
  { label: 'See the delivery process', href: '/process/' },
];

const faqs = [
  {
    question: 'Is this a technical audit?',
    answer:
      'Not only. It looks at technology, but the real value is connecting tool use, workflow, governance, confidence and leadership decision-making.',
  },
  {
    question: 'Do we need to know exactly what AI tools people are using?',
    answer:
      'No. Part of the assessment is establishing what is visible, what is assumed and where there may be shadow adoption or unclear ownership.',
  },
  {
    question: 'Will this expose individuals?',
    answer:
      'No. Quiet experimentation is signal, not misconduct. The assessment maps patterns and workflows, not names, and staff are told that up front.',
  },
  {
    question: 'What happens after the sprint?',
    answer:
      'You may choose guidance, AI Foundry, Discovery, a focused PoC, leadership coaching or no further action. The point is to make the next decision clearer.',
  },
];
---

<Layout
  title="AI Adoption Readiness Sprint: one week, one map | Digital Technology Partner"
  description="A one-week assessment that maps where AI is helping, where it's risky and where it's noise, shadow adoption included. Three levels, one clear leadership decision."
>
  <Header />
  <main class="readiness-page">
    <section class="readiness-hero">
      <div class="scope-grid"></div>
      <div class="ma-container readiness-hero-grid">
        <div class="readiness-copy" data-readiness-reveal>
          <span class="ma-section-tag">// whats_already_happening</span>
          <h1>AI is already inside your business. It didn't ask permission.</h1>
          <p>
            Staff are experimenting quietly. Teams are blocked by policy.
            Licence spend isn't changing how work gets done. The Readiness
            Sprint maps all of it in one week: signal, risk, noise, and the next
            decision.
          </p>
          <div class="readiness-actions">
            <a class="ma-btn ma-btn-mint" href="/contact/">
              Book a readiness call
            </a>
            <a class="ma-btn ma-btn-outline" href="#levels"
              >Compare the levels</a
            >
          </div>
          <dl class="readiness-stats" aria-label="Readiness sprint summary">
            <div>
              <dt>1 week</dt>
              <dd>Time-boxed assessment</dd>
            </div>
            <div>
              <dt>3 levels</dt>
              <dd>Snapshot, Diagnostic, Advisory</dd>
            </div>
            <div>
              <dt>1 map</dt>
              <dd>Signal, risk, noise and next action</dd>
            </div>
          </dl>
        </div>

        <div
          class="radar-panel"
          aria-label="Signal, risk and noise radar"
          data-readiness-reveal
        >
          <div class="radar-topline">
            <span>readiness radar</span>
            <strong>decision view</strong>
          </div>
          <div class="radar-visual" aria-hidden="true">
            <canvas id="readiness-radar-scene" aria-hidden="true"></canvas>
            <div class="radar-label radar-label-signal">Signal</div>
            <div class="radar-label radar-label-risk">Risk</div>
            <div class="radar-label radar-label-noise">Noise</div>
            <div class="radar-label radar-label-decision">Decision</div>
          </div>
          <div class="radar-callouts">
            <article>
              <span>Signal</span>
              <p>
                Workflows where AI is already saving time or improving
                judgement.
              </p>
            </article>
            <article class="risk">
              <span>Risk</span>
              <p>
                Data exposure, weak ownership, poor review or unclear
                permission.
              </p>
            </article>
            <article class="noise">
              <span>Noise</span>
              <p>Tool-chasing, theatre and ideas that should be parked.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="ma-section readiness-intro">
      <div class="ma-container intro-grid">
        <div>
          <span class="ma-section-tag">// the_map</span>
          <h2>
            Most organisations do not need more AI noise. They need a map.
          </h2>
        </div>
        <div class="intro-copy">
          <p>
            Leaders are being asked to decide while the tools, risks and
            expectations keep moving. The sprint turns that uncertainty into one
            decision view:
          </p>
          <div class="map-list">
            {
              mapPoints.map((point) => (
                <article>
                  <strong>{point.title}</strong>
                  <p>{point.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="ma-section inspect-section">
      <div class="ma-container inspect-grid">
        <div class="inspect-copy">
          <span class="ma-section-tag">// what_we_inspect</span>
          <h2>We inspect the operating reality, not just the tool list.</h2>
          <p>
            The useful answer is rarely "which model should we use?" It's where
            AI is already touching work, where staff feel exposed, and where the
            organisation has enough signal to act.
          </p>
        </div>
        <div class="inspection-list" aria-label="Inspection areas">
          {inspectionAreas.map((area) => <div>{area}</div>)}
        </div>
      </div>
    </section>

    <section class="ma-section flow-section">
      <div class="ma-container">
        <div class="ma-section-header">
          <span class="ma-section-tag">// one_week_flow</span>
          <h2>Monday we scope. Friday you decide.</h2>
        </div>
        <div class="flow-grid">
          {
            weekFlow.map((step) => (
              <article class="flow-step">
                <span>{step.day}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ma-section leadership-section">
      <div class="ma-container leadership-grid">
        <div>
          <span class="ma-section-tag">// what_leadership_gets</span>
          <h2>
            Next board meeting, someone will ask about AI. The answer will be in
            front of you.
          </h2>
        </div>
        <div class="leadership-copy">
          <p>
            The sprint ends in a leadership readout built for the moments that
            actually test you: the board question, the vendor pitch, the budget
            round. You receive:
          </p>
          <div class="leadership-list">
            {leadershipOutputs.map((item) => <p>{item}</p>)}
          </div>
        </div>
      </div>
    </section>

    <section class="ma-section levels-section" id="levels">
      <div class="ma-container">
        <div class="ma-section-header">
          <span class="ma-section-tag">// choose_confidence_level</span>
          <h2>Choose the right level of confidence.</h2>
          <p>
            Each option stands alone. The right fit depends on appetite, budget
            and the strategic driver behind the assessment.
          </p>
        </div>
        <div class="levels-grid">
          {
            readinessLevels.map((level) => (
              <article class="level-card">
                <div class="ma-card-line" />
                <span>{level.mode}</span>
                <h3>{level.title}</h3>
                <p>{level.summary}</p>
                <div class="best-for">
                  <strong>Best for</strong>
                  <p>{level.bestFor}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ma-section decision-section">
      <div class="ma-container honest-outcome">
        <span class="ma-section-tag">// the_honest_outcome</span>
        <h2>One legitimate outcome: no further action.</h2>
        <div>
          <p>
            The sprint ends with a recommendation, not a sales pitch. The route
            forward might be guidance, AI Foundry, Discovery, a focused proof of
            concept, leadership coaching, or stopping here. If the evidence says
            stop, the readout says stop. The point is to choose with evidence.
          </p>
          <div class="route-links">
            {nextRouteLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
        </div>
      </div>
    </section>

    <section class="ma-section faq-section">
      <div class="ma-container faq-grid">
        <div>
          <span class="ma-section-tag">// questions</span>
          <h2>Useful questions before you start.</h2>
        </div>
        <div class="faq-list">
          {
            faqs.map((faq) => (
              <details class="ma-faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="readiness-cta">
      <div class="ma-container readiness-cta-inner">
        <span class="ma-section-tag">// start_with_clarity</span>
        <h2>Start with the clearest next decision.</h2>
        <p>
          If AI adoption feels busy, risky or hard to read, one week turns it
          into a decision you can defend.
        </p>
        <a class="ma-btn ma-btn-mint ma-btn-lg" href="/contact/">
          Book a readiness call
        </a>
        <a class="ma-btn ma-btn-outline ma-btn-lg" href="/programmes/">
          Compare all programmes
        </a>
      </div>
    </section>
  </main>
</Layout>

<script>
  const canvas = document.getElementById(
    'readiness-radar-scene'
  ) as HTMLCanvasElement | null;
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  if (canvas) {
    const [THREE, gsapModule] = await Promise.all([
      import('three'),
      import('gsap'),
    ]);
    const { gsap } = gsapModule;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
    camera.position.set(0, 0, 8.5);

    const group = new THREE.Group();
    scene.add(group);

    const mint = new THREE.Color('#00e5a0');
    const risk = new THREE.Color('#f4c84a');
    const noise = new THREE.Color('#b5b5c4');
    const ivory = new THREE.Color('#f4f1e8');

    const ringMaterial = new THREE.MeshBasicMaterial({
      color: mint,
      transparent: true,
      opacity: 0.18,
      side: THREE.DoubleSide,
      depthWrite: false,
    });

    [1.15, 2.15, 3.15].forEach((radius, index) => {
      const ring = new THREE.Mesh(
        new THREE.TorusGeometry(radius, 0.008, 12, 180),
        ringMaterial.clone()
      );
      ring.material.opacity = index === 0 ? 0.32 : 0.13;
      ring.rotation.x = Math.PI / 2;
      group.add(ring);
    });

    const axisMaterial = new THREE.LineBasicMaterial({
      color: ivory,
      transparent: true,
      opacity: 0.15,
    });

    const makeLine = (
      points: Array<[number, number, number]>,
      material = axisMaterial
    ) => {
      const geometry = new THREE.BufferGeometry().setFromPoints(
        points.map(([x, y, z]) => new THREE.Vector3(x, y, z))
      );
      const line = new THREE.Line(geometry, material);
      group.add(line);
      return line;
    };

    makeLine([
      [-3.2, 0, 0],
      [3.2, 0, 0],
    ]);
    makeLine([
      [0, -3.2, 0],
      [0, 3.2, 0],
    ]);
    makeLine(
      [
        [-2.25, -2.25, 0],
        [2.25, 2.25, 0],
      ],
      new THREE.LineBasicMaterial({
        color: mint,
        transparent: true,
        opacity: 0.22,
      })
    );

    const sweepMaterial = new THREE.MeshBasicMaterial({
      color: mint,
      transparent: true,
      opacity: 0.18,
      side: THREE.DoubleSide,
      depthWrite: false,
    });
    const sweep = new THREE.Mesh(
      new THREE.CircleGeometry(3.08, 80, 0, Math.PI / 4.8),
      sweepMaterial
    );
    sweep.rotation.z = -0.12;
    group.add(sweep);

    const vectorMaterial = new THREE.LineBasicMaterial({
      color: mint,
      transparent: true,
      opacity: 0.78,
    });
    const vectorLine = makeLine(
      [
        [0, 0, 0.03],
        [2.42, 1.84, 0.03],
      ],
      vectorMaterial
    );

    const createNode = (
      x: number,
      y: number,
      color: typeof mint,
      size = 0.075
    ) => {
      const glow = new THREE.Mesh(
        new THREE.SphereGeometry(size * 3.4, 24, 24),
        new THREE.MeshBasicMaterial({
          color,
          transparent: true,
          opacity: 0.13,
          depthWrite: false,
        })
      );
      glow.position.set(x, y, 0.1);
      group.add(glow);

      const node = new THREE.Mesh(
        new THREE.SphereGeometry(size, 24, 24),
        new THREE.MeshBasicMaterial({
          color,
          transparent: true,
          opacity: 0.96,
        })
      );
      node.position.set(x, y, 0.18);
      group.add(node);
      return { node, glow };
    };

    const signalNode = createNode(-1.92, 1.85, mint, 0.088);
    const riskNode = createNode(1.82, 0.64, risk, 0.078);
    const noiseNode = createNode(0.82, -1.42, noise, 0.066);
    const decisionNode = createNode(0, 0, ivory, 0.07);
    const nodes = [signalNode, riskNode, noiseNode, decisionNode];

    const pointCount = 420;
    const positions = new Float32Array(pointCount * 3);
    const colors = new Float32Array(pointCount * 3);
    for (let i = 0; i < pointCount; i += 1) {
      const radius = 0.45 + Math.random() * 2.95;
      const angle = Math.random() * Math.PI * 2;
      const yScale = 0.86 + Math.random() * 0.18;
      positions[i * 3] = Math.cos(angle) * radius;
      positions[i * 3 + 1] = Math.sin(angle) * radius * yScale;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 0.28;
      const color = i % 8 === 0 ? risk : i % 4 === 0 ? noise : mint;
      colors[i * 3] = color.r;
      colors[i * 3 + 1] = color.g;
      colors[i * 3 + 2] = color.b;
    }

    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute(
      'position',
      new THREE.BufferAttribute(positions, 3)
    );
    particleGeometry.setAttribute(
      'color',
      new THREE.BufferAttribute(colors, 3)
    );
    const particles = new THREE.Points(
      particleGeometry,
      new THREE.PointsMaterial({
        size: 0.025,
        vertexColors: true,
        transparent: true,
        opacity: 0.64,
        depthWrite: false,
      })
    );
    group.add(particles);

    group.rotation.x = -0.22;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const width = Math.max(rect.width, 1);
      const height = Math.max(rect.height, 1);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      group.scale.setScalar(window.innerWidth < 720 ? 0.82 : 1);
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });

    if (!reducedMotion) {
      gsap.from('[data-readiness-reveal]', {
        opacity: 0,
        y: 24,
        duration: 0.85,
        ease: 'power3.out',
        stagger: 0.16,
      });
      gsap.from('.readiness-stats > div', {
        opacity: 0,
        y: 16,
        duration: 0.55,
        delay: 0.38,
        ease: 'power3.out',
        stagger: 0.08,
      });
      gsap.from('.radar-callouts article', {
        opacity: 0,
        y: 16,
        duration: 0.55,
        delay: 0.6,
        ease: 'power3.out',
        stagger: 0.08,
      });
      gsap.from('.radar-label', {
        opacity: 0,
        scale: 0.92,
        duration: 0.5,
        delay: 0.72,
        ease: 'power2.out',
        stagger: 0.06,
      });
    }

    const clock = new THREE.Clock();
    let frameId = 0;
    const render = () => {
      const t = clock.getElapsedTime();
      if (!reducedMotion) {
        sweep.rotation.z = t * 0.72 - 0.18;
        particles.rotation.z -= 0.0009;
        vectorLine.material.opacity = 0.48 + Math.sin(t * 1.5) * 0.18;
        nodes.forEach(({ node, glow }, index) => {
          const pulse = 1 + Math.sin(t * 1.8 + index * 0.9) * 0.16;
          node.scale.setScalar(pulse);
          glow.scale.setScalar(1 + Math.sin(t * 1.5 + index) * 0.22);
        });
        group.rotation.z = Math.sin(t * 0.22) * 0.035;
      }
      renderer.render(scene, camera);
      frameId = window.requestAnimationFrame(render);
    };

    render();

    document.addEventListener('astro:before-swap', () => {
      window.cancelAnimationFrame(frameId);
      window.removeEventListener('resize', resize);
      renderer.dispose();
      particleGeometry.dispose();
      ringMaterial.dispose();
      sweepMaterial.dispose();
      axisMaterial.dispose();
      vectorMaterial.dispose();
    });
  }
</script>

<style>
  .readiness-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 40% 18%,
        rgba(5, 204, 144, 0.11),
        transparent 32rem
      );
  }

  .readiness-hero {
    position: relative;
    overflow: hidden;
    padding: 7.9rem 0 4.4rem;
    min-height: 86vh;
    display: flex;
    align-items: center;
  }

  .scope-grid {
    position: absolute;
    inset: 0;
    opacity: 0.14;
    background-image:
      linear-gradient(rgba(244, 241, 232, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 232, 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  .readiness-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 1.05fr);
    gap: 4rem;
    align-items: center;
  }

  .readiness-copy h1 {
    max-width: 780px;
    margin-bottom: 1.35rem;
    color: #f4f1e8;
    font-size: clamp(3rem, 5.55vw, 5.15rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .readiness-copy > p {
    max-width: 660px;
    color: #d8d6ce;
    font-size: 1.18rem;
    line-height: 1.65;
  }

  .readiness-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .readiness-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 720px;
    margin-top: 2.4rem;
  }

  .readiness-stats div {
    padding: 1rem;
    border: 1px solid rgba(244, 241, 232, 0.12);
    border-radius: var(--ma-radius);
    background: rgba(16, 16, 27, 0.72);
  }

  .readiness-stats dt {
    margin-bottom: 0.2rem;
    color: var(--ma-mint);
    font-family: var(--ma-font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .readiness-stats dd {
    margin: 0;
    color: var(--ma-text-dim);
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .radar-panel {
    position: relative;
    padding: 1.4rem;
    border: 1px solid rgba(244, 241, 232, 0.13);
    border-radius: 28px;
    background:
      radial-gradient(
        circle at 48% 44%,
        rgba(5, 204, 144, 0.12),
        transparent 20rem
      ),
      linear-gradient(145deg, rgba(13, 13, 22, 0.8), rgba(0, 0, 0, 0.32));
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.28);
    overflow: hidden;
  }

  .radar-panel::before {
    content: '';
    position: absolute;
    inset: 4.2rem 4rem 8.2rem;
    border: 1px solid rgba(5, 204, 144, 0.08);
    border-radius: 50%;
    pointer-events: none;
  }

  .radar-topline {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
    color: var(--ma-text-dim);
    font-family: var(--ma-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .radar-topline strong {
    color: var(--ma-mint);
    font-weight: 500;
  }

  .radar-visual {
    position: relative;
    min-height: 420px;
    margin: 0.2rem 0 0.9rem;
    overflow: hidden;
  }

  .radar-visual canvas {
    display: block;
    width: 100%;
    height: 420px;
  }

  .radar-label {
    position: absolute;
    z-index: 2;
    color: var(--ma-mint);
    font-family: var(--ma-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-shadow: 0 0 18px rgba(5, 204, 144, 0.5);
    pointer-events: none;
  }

  .radar-label-signal {
    left: 20%;
    top: 22%;
  }

  .radar-label-risk {
    right: 17%;
    top: 40%;
    color: #f4c84a;
    text-shadow: 0 0 18px rgba(244, 200, 74, 0.42);
  }

  .radar-label-noise {
    right: 28%;
    bottom: 25%;
    color: #b5b5c4;
    text-shadow: 0 0 18px rgba(181, 181, 196, 0.36);

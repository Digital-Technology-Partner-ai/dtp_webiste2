---
import Header from '../../../components/Header.astro';
import Layout from '../../../layouts/Layout.astro';

const foundryOutputs = [
  'Workflow opportunities grounded in real business work',
  'A prioritised experiment backlog with practical next steps',
  'Adoption observations: confidence, blockers, risk and ownership',
  'Leadership evidence for what to fund, pause, govern or move into delivery',
];

const principles = [
  {
    number: '01',
    title: 'Club, not course.',
    text: 'Energy matters more than syllabus. People should leave with something they tried, not something they watched.',
  },
  {
    number: '02',
    title: 'Safe to be a beginner.',
    text: 'The room must work for first-time users and regular experimenters alike. Nobody performs expertise; nobody hides confusion.',
  },
  {
    number: '03',
    title: 'Tie it to real work.',
    text: 'The centre of gravity is operational friction, not abstract AI exploration.',
  },
  {
    number: '04',
    title: "Facilitate, don't lecture.",
    text: 'DTP brings structure and questions. The expertise lives in the room.',
  },
  {
    number: '05',
    title: 'Notice governance.',
    text: 'Surface acceptable use, confidentiality and quality control as you go, without making governance the whole point.',
  },
];

const sessions = [
  {
    week: 'Week 1',
    title: 'Mobilise',
    text: 'Sponsor intent, participant mix, baseline, tools and permission boundary.',
  },
  {
    week: 'Weeks 2 and 3',
    title: 'Common ground',
    text: 'A shared mental model of what AI does well, where it fails and how to use it responsibly.',
  },
  {
    week: 'Weeks 4 to 7',
    title: 'Hands dirty',
    text: "Tool demos, toolbox day, mini-challenges and hackathons. Bring the most annoying workflow you own; that's the raw material.",
  },
  {
    week: 'Weeks 8 to 10',
    title: 'Apply to work',
    text: 'Cross-functional pitches and business workshops tied to real operational friction.',
  },
  {
    week: 'Weeks 11 and 12',
    title: 'Land it',
    text: 'Showcase, lessons learned, shortlist, guardrail themes and the leadership readout.',
  },
];

const readoutPiles = [
  {
    title: 'Fund',
    text: 'use cases with enough evidence, appetite and ownership to justify the next stage.',
  },
  {
    title: 'Guide',
    text: 'useful activity that needs data rules, accountable owners, human review or escalation.',
  },
  {
    title: 'Investigate',
    text: 'promising areas that need more evidence before leadership commits.',
  },
  {
    title: 'Pause',
    text: 'work blocked by access, risk, unclear ownership or weak timing.',
  },
  {
    title: 'Stop',
    text: "ideas that look interesting but don't deserve more organisational attention.",
  },
  {
    title: 'Build confidence',
    text: 'measured before and after: not just attendance, but people comfortable applying and presenting AI work.',
  },
];

const leaveWith = [
  'A shortlist of practical AI use cases grounded in your real problems',
  'One or two proof-of-concept candidates ready for a serious decision',
  'A measurably more confident, more connected workforce',
  "A leadership readout: where you are, what's worth doing, and what isn't",
  'A decision pack with clear next steps',
];

const fitSignals = [
  {
    title: 'Best fit',
    items: [
      'Teams with real workflows to inspect',
      'Leaders who want evidence before build',
      'Organisations that need adoption confidence',
    ],
  },
  {
    title: 'Less suitable',
    items: [
      'A generic AI awareness session',
      'A one-off motivational talk',
      'A replacement for policy, legal or compliance work',
    ],
  },
];

const participantCommitments = [
  {
    title: 'Bring real work',
    text: 'The best raw material is a task, workflow or frustration you already understand. It does not need to be polished before you bring it into the room.',
  },
  {
    title: 'Try things',
    text: 'Foundry is hands-on. You will test tools and approaches, compare results and learn from attempts that do not work as expected.',
  },
  {
    title: 'Share what you notice',
    text: 'Useful evidence includes what helped, what failed, what felt risky and what would need to change before an idea could be taken further.',
  },
];

const faqs = [
  {
    question: 'Do I need technical or AI experience?',
    answer:
      'No. Foundry is designed for a mixed group, including people who are completely new to AI and people who already experiment with it regularly. You are not expected to perform expertise or hide what you do not know.',
  },
  {
    question: 'Is this a training course?',
    answer:
      'Not in the usual sense. There is enough shared learning to give everyone a useful starting point, but the programme runs as a working club. The emphasis is on trying things, discussing what happened and applying the learning to real work.',
  },
  {
    question: 'What will we actually do?',
    answer:
      'The activity mix can include AI fundamentals, tool demonstrations, practical challenges, hackathons, peer showcases, failure stories and workshops built around real business problems. The exact mix is shaped around the people in the cohort and the opportunities that surface.',
  },
  {
    question: 'What should I bring to the sessions?',
    answer:
      'Bring curiosity and examples of work you understand. A repetitive task, awkward handover, slow document process, information bottleneck or small frustration can all be useful starting points. You do not need to arrive with a finished AI idea.',
  },
  {
    question: 'How much time will it take?',
    answer:
      'The Foundry runs over twelve weeks, with a planned rhythm of sessions and practical activity. Your organisation will confirm the detailed schedule. The time is intended to be treated as part of the work, not as an extra hobby squeezed around it.',
  },
  {
    question: 'Which AI tools will we use?',
    answer:
      'Tools and access routes are agreed with your organisation. Foundry can work with tools already available to the cohort and may introduce other options where appropriate. Nobody should create new accounts, buy licences or use unapproved tools simply for the sake of a session.',
  },
  {
    question: 'Can I use confidential or sensitive information?',
    answer:
      'Only where the tool, information and use have been approved by your organisation. Sessions include practical discussion about confidentiality, accuracy and human review. If you are unsure whether material is safe to use, stop and ask before entering it into an AI tool.',
  },
  {
    question: 'What if my experiment does not work?',
    answer:
      'That is useful evidence, not failure. The programme is designed to make it safe to test ideas, compare results and explain what did not work. A clear reason to pause or stop an idea can be as valuable as finding one worth developing.',
  },
  {
    question: 'Will every idea become a software project?',
    answer:
      'No. Some ideas may be solved with a better prompt, a simple workflow change, guidance or an existing tool. Others may need more investigation, a proof of concept or no further action. The point is to make a proportionate decision, not to manufacture a build pipeline.',
  },
  {
    question: 'What happens at the end of the twelve weeks?',
    answer:
      'The cohort shares what it tried and what it learned. Leadership receives a grounded readout covering practical use cases, adoption signals, risks, ownership questions and recommended next decisions. Strong ideas may move forward, while others may be guided, investigated, paused or stopped.',
  },
];
---

<Layout
  title="AI Foundry: a twelve-week working group, not a course | Digital Technology Partner"
  description="AI Foundry turns scattered experiments into evidence and leadership decisions in twelve weeks: five principles, real work, and a readout of choices: fund, guide, investigate, pause or stop."
>
  <Header />
  <main class="foundry-page">
    <section class="foundry-hero">
      <div class="foundry-grid-bg"></div>
      <div class="ma-container foundry-hero-grid">
        <div class="foundry-copy">
          <span class="ma-section-tag">// club_not_course</span>
          <h1>This is not AI training. It's a club.</h1>
          <p>
            AI Foundry is a twelve-week working group that turns scattered
            experiments into shared confidence, useful evidence and decisions
            leadership can act on. Energy over syllabus. Evidence over opinion.
          </p>
          <div class="foundry-actions">
            <a class="ma-btn ma-btn-mint" href="#questions">
              Read participant FAQs
            </a>
            <a class="ma-btn ma-btn-outline" href="#twelve-weeks"
              >See the twelve weeks</a
            >
          </div>
          <dl class="foundry-stats" aria-label="AI Foundry summary">
            <div>
              <dt>12 weeks</dt>
              <dd>Time-boxed working group</dd>
            </div>
            <div>
              <dt>5 principles</dt>
              <dd>How the room works</dd>
            </div>
            <div>
              <dt>6 decisions</dt>
              <dd>What leadership decides</dd>
            </div>
          </dl>
        </div>

        <aside class="foundry-console" aria-label="AI Foundry output console">
          <div class="console-top">
            <span>foundry output</span>
          </div>
          <div class="console-core convergence-visual">
            <iframe
              src="/media/programmes/combining-shapes.html"
              title="Animated fragments combining into one shared decision"
              loading="eager"
              sandbox="allow-scripts"
              referrerpolicy="no-referrer"
              tabindex="-1"
            ></iframe>
          </div>
          <ul>
            {foundryOutputs.map((output) => <li>{output}</li>)}
          </ul>
        </aside>
      </div>
    </section>

    <section class="ma-section context-section">
      <div class="ma-container context-grid">
        <div>
          <span class="ma-section-tag">// five_foundry_principles</span>
          <h2>Five principles make the room work.</h2>
        </div>
        <div class="context-copy">
          <p>
            Most people in your organisation are hiding what they don't know
            about AI. The room is designed for that.
          </p>
          <div class="principles-list">
            {
              principles.map((principle) => (
                <article>
                  <span>{principle.number}</span>
                  <h3>{principle.title}</h3>
                  <p>{principle.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="ma-section session-section" id="twelve-weeks">
      <div class="ma-container">
        <div class="ma-section-header">
          <span class="ma-section-tag">// the_twelve_weeks</span>
          <h2>Make the next step obvious.</h2>
          <p>
            A controlled route across five phases: enough structure to be
            useful, enough room for real operational friction to surface.
          </p>
        </div>
        <div class="session-grid">
          {
            sessions.map((session) => (
              <article>
                <span>{session.week}</span>
                <h3>{session.title}</h3>
                <p>{session.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ma-section readout-section">
      <div class="ma-container readout-grid">
        <div>
          <span class="ma-section-tag">// the_readout</span>
          <h2>The output is not a deck. It's a set of choices.</h2>
          <p>
            Your organisation doesn't lack AI ideas; it lacks evidence. Twelve
            weeks of real attempts let leadership sort the pipeline into six
            honest decisions:
          </p>
        </div>
        <div class="readout-piles">
          {
            readoutPiles.map((pile) => (
              <article>
                <strong>{pile.title}</strong>
                <p>{pile.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ma-section leave-section">
      <div class="ma-container leave-grid">
        <div>
          <span class="ma-section-tag">// what_you_leave_with</span>
          <h2>What you leave with.</h2>
        </div>
        <div class="leave-list">
          {leaveWith.map((item) => <p>{item}</p>)}
        </div>
      </div>
    </section>

    <section class="ma-section fit-section">
      <div class="ma-container fit-grid">
        <div class="fit-panel">
          <span class="ma-section-tag">// what_it_takes</span>
          <h2>Foundry asks three things of you.</h2>
          <ul class="takes-list">
            <li>
              <strong>A named sponsor</strong> someone who owns the leadership question.
            </li>
            <li>
              <strong>A working contact</strong> someone who keeps the group connected
              to real work.
            </li>
            <li>
              <strong>Leadership air cover</strong> permission for people to spend
              real time and be beginners in public.
            </li>
          </ul>
        </div>
        <div class="fit-lists">
          {
            fitSignals.map((group) => (
              <article>
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
          <p class="fit-outro">
            If the sponsor, contact or air cover isn't available yet, start with
            Readiness: it's a smaller ask. <a
              href="/programmes/ai-adoption-readiness/">Start with Readiness</a
            >
          </p>
        </div>
      </div>
    </section>

    <section class="ma-section participant-section">
      <div class="ma-container participant-shell">
        <div class="participant-stage">
          <div class="ma-section-header participant-head">
            <span class="ma-section-tag">// your_part_in_the_room</span>
            <h2>You do not need a finished idea. You need something real to explore.</h2>
            <p>
              Foundry works when participants bring their knowledge of the work,
              stay curious and report honestly on what happens.
            </p>
          </div>
          <div class="participant-neural-art">
            <iframe
              src="/media/programmes/synapse-tracers.html"
              title="Animated neural connections forming and moving"
              loading="lazy"
              sandbox="allow-scripts"
              referrerpolicy="no-referrer"
              tabindex="-1"
            ></iframe>
            <span>// curiosity_becomes_connection</span>
          </div>
        </div>
        <div class="participant-grid">
          {
            participantCommitments.map((item) => (
              <article>
                <strong>{item.title}</strong>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ma-section faq-section" id="questions">
      <div class="ma-container faq-grid">
        <div class="faq-heading">
          <span class="ma-section-tag">// participant_questions</span>
          <h2>Useful questions before you start.</h2>
          <p>
            The short version: beginners are welcome, real work is encouraged,
            and nobody is expected to turn every experiment into a project.
          </p>
        </div>
        <div class="faq-list">
          {
            faqs.map((faq) => (
              <details class="ma-faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="foundry-cta">
      <div class="ma-container cta-inner">
        <span class="ma-section-tag">// bring_foundry_to_your_team</span>
        <h2>Thinking about a Foundry for your organisation?</h2>
        <p>
          If people need permission, shared confidence and a practical route
          from AI interest to useful evidence, we can help you decide whether
          Foundry is the right fit.
        </p>
        <div class="cta-actions">
          <a class="ma-btn ma-btn-mint ma-btn-lg" href="/contact/">
            Discuss a Foundry
          </a>
          <a class="ma-btn ma-btn-outline ma-btn-lg" href="/programmes/"
            >Compare all programmes</a
          >
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .foundry-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 18% 12%,
        rgba(5, 204, 144, 0.13),
        transparent 30rem
      ),
      radial-gradient(
        circle at 76% 22%,
        rgba(124, 139, 255, 0.09),
        transparent 28rem
      );
  }

  .foundry-hero {
    position: relative;
    min-height: 86vh;
    padding: 8.75rem 0 3rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--ma-border);
  }

  .foundry-grid-bg {
    position: absolute;
    inset: 0;
    opacity: 0.14;
    background-image:
      linear-gradient(rgba(244, 241, 232, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 232, 0.04) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(
      ellipse 78% 70% at 58% 42%,
      black,
      transparent 84%
    );
  }

  .foundry-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(420px, 0.92fr);
    gap: 4rem;
    align-items: center;
  }

  .foundry-copy h1 {
    max-width: 810px;
    margin-bottom: 1.3rem;
    color: #f4f1e8;
    font-size: 4.55rem;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .foundry-copy p {
    max-width: 670px;
    color: #d8d6ce;
    font-size: 1.12rem;
    line-height: 1.72;
  }

  .foundry-actions,
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .foundry-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 720px;
    margin-top: 2.4rem;
  }

  .foundry-stats div {
    padding: 1rem;
    border: 1px solid rgba(244, 241, 232, 0.12);
    border-radius: var(--ma-radius);
    background: rgba(16, 16, 27, 0.72);
  }

  .foundry-stats dt {
    margin-bottom: 0.2rem;
    color: var(--ma-mint);
    font-family: var(--ma-font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .foundry-stats dd {
    margin: 0;
    color: var(--ma-text-dim);
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .foundry-console {
    padding: 1.45rem;
    border: 1px solid rgba(5, 204, 144, 0.3);
    border-radius: var(--ma-radius);
    background:
      radial-gradient(
        circle at 50% 30%,
        rgba(5, 204, 144, 0.13),
        transparent 17rem
      ),
      rgba(11, 16, 26, 0.72);
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.34);
  }

  .console-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: start;
    margin-bottom: 1.4rem;
  }

  .console-top span,
  .session-grid article span {
    color: var(--ma-mint);
    font-family: var(--ma-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .console-top strong {
    color: #f4f1e8;
    font-family: var(--ma-font-display);
    font-size: 1.15rem;
  }

  .console-core {
    min-height: 260px;
    padding: 0;
    border: 1px solid rgba(244, 241, 232, 0.1);
    border-radius: var(--ma-radius);
    background: #080b09;
    overflow: hidden;
  }

  .convergence-visual iframe {
    display: block;
    width: 100%;
    height: 320px;
    border: 0;
    background: #080b09;
    pointer-events: none;
  }

  .foundry-console ul {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.3rem;
    padding: 0;
    list-style: none;
  }

  .foundry-console li {
    padding-left: 1rem;
    border-left: 2px solid rgba(5, 204, 144, 0.66);
    color: var(--ma-text);
    line-height: 1.52;
  }

  .context-section {
    background: var(--ma-bg);
  }

  .context-grid,
  .readout-grid,
  .leave-grid,
  .fit-grid,
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
    gap: 3rem;
    align-items: start;
  }

  .context-grid h2,
  .session-section h2,
  .readout-grid h2,
  .leave-grid h2,
  .fit-panel h2,
  .participant-head h2,
  .faq-heading h2,
  .foundry-cta h2 {
    letter-spacing: 0;
  }

  .context-copy {
    display: grid;
    gap: 1rem;
  }

  .context-copy p,
  .readout-grid > div > p,
  .fit-panel p,
  .participant-head p,
  .faq-heading p,
  .foundry-cta p {
    color: #d8d6ce;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .principles-list,
  .readout-piles,
  .leave-list {
    display: grid;
    gap: 0.9rem;
  }

  .principles-list article,
  .readout-piles article,
  .leave-list p {
    margin: 0;
    padding: 1rem 1.1rem;
    border-left: 3px solid rgba(5, 204, 144, 0.72);
    background: rgba(244, 241, 232, 0.04);
  }

  .principles-list span {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--ma-mint);
    font-family: var(--ma-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .principles-list h3 {
    margin-bottom: 0.4rem;
    color: #f4f1e8;
    font-size: 1.1rem;
    letter-spacing: 0;
  }

  .principles-list p,
  .readout-piles p,
  .leave-list p {
    color: #d8d6ce;
    line-height: 1.58;
  }

  .session-section {
    border-top: 1px solid var(--ma-border);
    background:
      linear-gradient(
        135deg,
        rgba(5, 204, 144, 0.07),
        rgba(124, 139, 255, 0.05)
      );
  }

  .session-section .ma-section-header {
    max-width: 780px;
  }

  .session-section .ma-section-header p {
    margin-top: 0.8rem;
    color: #d8d6ce;
    font-size: 1.05rem;
    line-height: 1.68;
  }

  .session-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .session-grid article,
  .fit-lists article,
  .participant-grid article {
    border: 1px solid rgba(244, 241, 232, 0.13);
    border-radius: var(--ma-radius);
    background: rgba(11, 16, 26, 0.74);
  }

  .session-grid article {
    padding: 1.25rem;
    min-height: 230px;
  }

  .session-grid h3 {
    margin: 1rem 0 0.65rem;
    color: #f4f1e8;
    font-size: 1.14rem;
    letter-spacing: 0;
  }

  .session-grid p,
  .fit-lists li,
  .participant-grid p {
    line-height: 1.58;
  }

  .fit-section {
    border-top: 1px solid var(--ma-border);
    border-bottom: 1px solid var(--ma-border);
    background: var(--ma-bg);
  }

  .readout-section {
    border-top: 1px solid var(--ma-border);
    background: var(--ma-bg);
  }

  .readout-grid > div:first-child p {
    margin-top: 1rem;
  }

  .readout-piles {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .readout-piles strong {
    display: block;
    margin-bottom: 0.35rem;
    color: #f4f1e8;
    font-family: var(--ma-font-display);
  }

  .leave-section {
    border-top: 1px solid var(--ma-border);
    background:
      linear-gradient(
        135deg,
        rgba(5, 204, 144, 0.06),
        rgba(124, 139, 255, 0.05)
      );
  }

  .fit-lists {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .fit-outro {
    grid-column: 1 / -1;
    margin: 0;
    color: #d8d6ce;
    line-height: 1.62;
  }

  .fit-outro a {
    color: var(--ma-mint);
    font-family: var(--ma-font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .takes-list {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.3rem;
    padding: 0;
    list-style: none;
  }

  .takes-list li {
    padding-left: 1rem;
    border-left: 2px solid rgba(5, 204, 144, 0.58);
    color: var(--ma-text);

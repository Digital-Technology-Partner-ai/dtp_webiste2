---
import Header from '../../../components/Header.astro';
import Layout from '../../../layouts/Layout.astro';

const bookingUrl =
  'https://outlook.office.com/bookwithme/user/f0762b9af6a94ed2add9818a4f3ca4e5@digitaltechnologypartner.ai/meetingtype/qc2lOXjEdkO6GkMS_jZJrQ2?anonymous';

const privateSignals = [
  'You need to test your thinking before taking it to the board.',
  'Vendor claims, AI agents or governance questions are moving faster than your available time.',
  'You want practical technical translation without turning it into a wider internal programme yet.',
];

const coachingThemes = [
  {
    title: 'Strategic Clarity',
    text: 'Turn AI noise, board pressure and vendor language into a smaller set of practical decisions.',
  },
  {
    title: 'Technical Translation',
    text: 'Understand what models, agents, automation and data architecture mean for your actual organisation.',
  },
  {
    title: 'Private Confidence',
    text: 'Build personal fluency with AI tools, workflows and risk questions in a discreet one-to-one setting.',
  },
  {
    title: 'Decision Support',
    text: 'Pressure-test options before committing budget, announcing strategy or sponsoring delivery.',
  },
];

const sessionFlow = [
  {
    label: '01',
    title: 'Confidential orientation',
    text: 'Clarify the pressure, questions, context and decisions you need to feel more confident about.',
  },
  {
    label: '02',
    title: 'Practical translation',
    text: 'Work through tools, vendors, workflows, data concerns, governance questions or AI agent concepts in plain language.',
  },
  {
    label: '03',
    title: 'Decision map',
    text: 'Turn the discussion into practical next steps: what to explore, what to delegate, what to govern and what to park.',
  },
];

const boundaries = [
  'Not generic AI training',
  'Not legal or compliance advice',
  'Not a sales push into a build',
  'Not a public workshop unless you choose that route later',
];
---

<Layout
  title="Senior Leadership AI Coaching - Digital Technology Partner"
  description="Discreet one-to-one AI and technology coaching for senior leaders who need private clarity, technical translation and decision support."
>
  <Header />
  <main class="coaching-page">
    <section class="coaching-hero" aria-labelledby="coaching-title">
      <canvas id="leadership-scene" class="leadership-scene" aria-hidden="true"></canvas>
      <div class="scene-vignette"></div>
      <div class="ma-container coaching-hero-grid">
        <div class="coaching-copy" data-reveal>
          <span class="ma-section-tag">// leadership_suite.private_ai_clarity</span>
          <h1 id="coaching-title">Private AI and technology support for senior leaders.</h1>
          <p>
            A calm, confidential route for leaders who need a trusted technical sounding board,
            practical translation and clearer decisions around AI.
          </p>
          <div class="coaching-actions">
            <a class="ma-btn ma-btn-mint" href={bookingUrl} target="_blank" rel="noopener noreferrer">
              Arrange a confidential conversation
            </a>
            <a class="ma-btn ma-btn-outline" href="/programmes/ai-adoption-readiness/">
              Explore Readiness first
            </a>
          </div>
        </div>

        <aside class="privacy-console" aria-label="Leadership coaching signal" data-reveal>
          <span>executive signal</span>
          <strong>Think clearly before you have to decide publicly.</strong>
          <ul>
            {privateSignals.map((signal) => <li>{signal}</li>)}
          </ul>
        </aside>
      </div>
    </section>

    <section class="ma-section clarity-section">
      <div class="ma-container clarity-grid">
        <div>
          <span class="ma-section-tag">// why_this_exists</span>
          <h2>Leadership pressure has changed. The support model should too.</h2>
        </div>
        <div class="clarity-copy">
          <p>
            Senior leaders are expected to answer questions about AI strategy, risk, tools,
            agents, data, workforce impact and vendor claims. The problem is not intelligence;
            it is bandwidth, translation and a safe place to pressure-test thinking.
          </p>
          <p>
            This coaching offer gives leaders practical fluency without forcing the organisation
            into a public programme before the decision is ready.
          </p>
        </div>
      </div>
    </section>

    <section class="ma-section themes-section">
      <div class="ma-container">
        <div class="ma-section-header themes-head">
          <span class="ma-section-tag">// coaching_themes</span>
          <h2>What the coaching can cover.</h2>
        </div>
        <div class="themes-grid">
          {coachingThemes.map((theme) => (
            <article data-reveal-card>
              <div class="ma-card-line"></div>
              <h3>{theme.title}</h3>
              <p>{theme.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ma-section session-section">
      <div class="ma-container session-grid">
        <div class="session-copy">
          <span class="ma-section-tag">// discreet_session_model</span>
          <h2>A private rhythm for clearer decisions.</h2>
          <p>
            Sessions are shaped around the decisions in front of you. They can be exploratory,
            technical, strategic or hands-on depending on what would create confidence fastest.
          </p>
        </div>
        <div class="session-steps">
          {sessionFlow.map((step) => (
            <article>
              <span>{step.label}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ma-section boundaries-section">
      <div class="ma-container boundaries-grid">
        <div class="boundaries-panel">
          <span class="ma-section-tag">// premium_boundaries</span>
          <h2>Clear boundaries make the offer more useful.</h2>
          <p>
            The value is confidential judgement, translation and decision support. It is not a
            noisy workshop or a generic course wearing executive clothes.
          </p>
        </div>
        <div class="boundary-list" aria-label="Coaching boundaries">
          {boundaries.map((boundary) => <div>{boundary}</div>)}
        </div>
      </div>
    </section>

    <section class="coaching-cta">
      <div class="ma-container cta-inner">
        <span class="ma-section-tag">// private_next_step</span>
        <h2>Need a discreet place to think this through?</h2>
        <p>
          Start with a confidential conversation. If Readiness, Foundry or delivery is the better
          route, we will say so plainly.
        </p>
        <div class="cta-actions">
          <a class="ma-btn ma-btn-mint ma-btn-lg" href={bookingUrl} target="_blank" rel="noopener noreferrer">
            Arrange a confidential conversation
          </a>
          <a class="ma-btn ma-btn-outline ma-btn-lg" href="/programmes/">Compare all programmes</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const canvas = document.getElementById('leadership-scene') as HTMLCanvasElement | null;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas) {
    const [THREE, gsapModule] = await Promise.all([import('three'), import('gsap')]);
    const { gsap } = gsapModule;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
    camera.position.set(0, 0.12, 8.6);

    const group = new THREE.Group();
    scene.add(group);

    const mint = new THREE.Color('#00e5a0');
    const ivory = new THREE.Color('#f4f1e8');
    const blue = new THREE.Color('#7c8bff');

    const ringMaterial = new THREE.MeshBasicMaterial({
      color: mint,
      transparent: true,
      opacity: 0.36,
      side: THREE.DoubleSide,
    });

    const chamberMaterial = new THREE.MeshBasicMaterial({
      color: mint,
      transparent: true,
      opacity: 0.08,
      wireframe: true,
    });

    const inner = new THREE.Mesh(new THREE.IcosahedronGeometry(1.12, 1), chamberMaterial);
    inner.rotation.set(0.4, 0.1, 0.25);
    group.add(inner);

    const rings = [1.86, 2.55, 3.18].map((radius, index) => {
      const ring = new THREE.Mesh(
        new THREE.TorusGeometry(radius, 0.008, 12, 160),
        ringMaterial.clone()
      );
      ring.material.opacity = 0.18 + index * 0.06;
      ring.rotation.x = Math.PI / 2 + index * 0.28;
      ring.rotation.y = index * 0.24;
      group.add(ring);
      return ring;
    });

    const pointCount = 560;
    const positions = new Float32Array(pointCount * 3);
    const colors = new Float32Array(pointCount * 3);

    for (let i = 0; i < pointCount; i += 1) {
      const radius = 1.7 + Math.random() * 2.2;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      positions[i * 3] = radius * Math.sin(phi) * Math.cos(theta);
      positions[i * 3 + 1] = radius * Math.sin(phi) * Math.sin(theta) * 0.64;
      positions[i * 3 + 2] = radius * Math.cos(phi);

      const color = i % 7 === 0 ? blue : i % 3 === 0 ? ivory : mint;
      colors[i * 3] = color.r;
      colors[i * 3 + 1] = color.g;
      colors[i * 3 + 2] = color.b;
    }

    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    particleGeometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    const particles = new THREE.Points(
      particleGeometry,
      new THREE.PointsMaterial({
        size: 0.032,
        vertexColors: true,
        transparent: true,
        opacity: 0.78,
        depthWrite: false,
      })
    );
    group.add(particles);

    const decisionNodes = [
      [-2.5, 0.9, 0.3],
      [2.2, 0.68, -0.1],
      [-1.5, -1.25, 0.5],
      [1.75, -1.15, -0.4],
    ].map(([x, y, z], index) => {
      const node = new THREE.Mesh(
        new THREE.SphereGeometry(index === 0 ? 0.075 : 0.055, 20, 20),
        new THREE.MeshBasicMaterial({
          color: index === 0 ? mint : ivory,
          transparent: true,
          opacity: index === 0 ? 0.92 : 0.58,
        })
      );
      node.position.set(x, y, z);
      group.add(node);
      return node;
    });

    group.position.x = window.innerWidth < 900 ? 0 : 1.28;
    group.position.y = window.innerWidth < 900 ? -0.2 : -0.02;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const width = Math.max(rect.width, 1);
      const height = Math.max(rect.height, 1);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      group.position.x = window.innerWidth < 900 ? 0 : 1.28;
      group.scale.setScalar(window.innerWidth < 720 ? 0.82 : 1);
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });

    if (!reducedMotion) {
      gsap.fromTo(
        group.rotation,
        { y: -0.28, x: 0.08 },
        { y: 0.1, x: -0.03, duration: 2.2, ease: 'power3.out' }
      );
      gsap.fromTo(
        '.leadership-scene',
        { opacity: 0 },
        { opacity: 1, duration: 1.1, ease: 'power2.out' }
      );
      gsap.from('[data-reveal]', {
        opacity: 0,
        y: 24,
        duration: 0.85,
        ease: 'power3.out',
        stagger: 0.16,
      });
      gsap.from('[data-reveal-card]', {
        opacity: 0,
        y: 18,
        duration: 0.65,
        ease: 'power3.out',
        stagger: 0.08,
        scrollTrigger: undefined,
      });
    }

    const clock = new THREE.Clock();
    let frameId = 0;
    const render = () => {
      const t = clock.getElapsedTime();
      if (!reducedMotion) {
        group.rotation.y += 0.0018;
        inner.rotation.x += 0.0025;
        inner.rotation.y += 0.003;
        particles.rotation.y -= 0.0009;
        rings.forEach((ring, index) => {
          ring.rotation.z = t * (0.035 + index * 0.012);
        });
        decisionNodes.forEach((node, index) => {
          node.scale.setScalar(1 + Math.sin(t * 1.4 + index) * 0.12);
        });
      }
      renderer.render(scene, camera);
      frameId = window.requestAnimationFrame(render);
    };

    render();

    document.addEventListener('astro:before-swap', () => {
      window.cancelAnimationFrame(frameId);
      window.removeEventListener('resize', resize);
      renderer.dispose();
      particleGeometry.dispose();
      ringMaterial.dispose();
      chamberMaterial.dispose();
    });
  }
</script>

<style>
  .coaching-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 22% 12%, rgba(0, 229, 160, 0.1), transparent 30rem),
      radial-gradient(circle at 78% 20%, rgba(124, 139, 255, 0.09), transparent 30rem),
      #000;
  }

  .coaching-hero {
    position: relative;
    min-height: 88vh;
    padding: 8.75rem 0 3.25rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--ma-border);
  }

  .leadership-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.92;
  }

  .scene-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.94) 0%, rgba(0, 0, 0, 0.72) 34%, rgba(0, 0, 0, 0.28) 64%, rgba(0, 0, 0, 0.7) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent 38%, rgba(0, 0, 0, 0.82));
    pointer-events: none;
  }

  .coaching-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.72fr);
    gap: 4rem;
    align-items: center;
  }

  .coaching-copy h1 {
    max-width: 790px;
    margin-bottom: 1.3rem;
    color: #f4f1e8;
    font-size: 4.55rem;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .coaching-copy p {
    max-width: 660px;
    color: #d8d6ce;
    font-size: 1.12rem;
    line-height: 1.72;
  }

  .coaching-actions,
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .privacy-console {
    padding: 1.5rem;
    border: 1px solid rgba(0, 229, 160, 0.25);
    border-radius: var(--ma-radius);
    background: rgba(10, 10, 15, 0.66);
    backdrop-filter: blur(18px);
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.34);
  }

  .privacy-console span,
  .session-steps article > span {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--ma-mint);
    font-family: var(--ma-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .privacy-console strong {
    display: block;
    color: #f4f1e8;
    font-family: var(--ma-font-display);
    font-size: 1.55rem;
    line-height: 1.18;
  }

  .privacy-console ul {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.35rem;
    padding: 0;
    list-style: none;
  }

  .privacy-console li {
    padding-left: 1rem;
    border-left: 2px solid rgba(0, 229, 160, 0.68);
    color: var(--ma-text);
    line-height: 1.54;
  }

  .clarity-section,
  .boundaries-section {
    background: var(--ma-bg);
  }

  .clarity-grid,
  .session-grid,
  .boundaries-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
    gap: 3rem;
    align-items: start;
  }

  .clarity-grid h2,
  .themes-head h2,
  .session-copy h2,
  .boundaries-panel h2,
  .coaching-cta h2 {
    letter-spacing: 0;
  }

  .clarity-copy {
    display: grid;
    gap: 1rem;
  }

  .clarity-copy p,
  .session-copy p,
  .boundaries-panel p,
  .coaching-cta p {
    color: #d8d6ce;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .themes-section,
  .session-section {
    border-top: 1px solid var(--ma-border);
    background:
      linear-gradient(135deg, rgba(0, 229, 160, 0.07), rgba(124, 139, 255, 0.05)),
      #07070c;
  }

  .themes-head {
    max-width: 760px;
  }

  .themes-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .themes-grid article,
  .session-steps article,
  .boundary-list div {
    border: 1px solid rgba(244, 241, 232, 0.13);
    border-radius: var(--ma-radius);
    background: rgba(17, 17, 34, 0.72);
  }

  .themes-grid article {
    position: relative;
    min-height: 210px;
    padding: 1.3rem;
    overflow: hidden;
  }

  .themes-grid h3 {
    margin-bottom: 0.75rem;
    color: #f4f1e8;
    font-size: 1.14rem;
    letter-spacing: 0;
  }

  .themes-grid p,
  .session-steps p {
    line-height: 1.58;
  }

  .session-section {
    border-bottom: 1px solid var(--ma-border);
  }

  .session-steps {
    display: grid;
    gap: 1rem;
  }

  .session-steps article {
    display: grid;
    grid-template-columns: 4.4rem minmax(0, 1fr);
    gap: 1.2rem;
    padding: 1.2rem;
  }

  .session-steps h3 {
    margin-bottom: 0.35rem;
    color: #f4f1e8;
    font-size: 1.1rem;
    letter-spacing: 0;
  }

  .boundary-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .boundary-list div {
    min-height: 96px;
    display: grid;
    align-items: center;
    padding: 1.2rem;
    color: #f4f1e8;
    font-family: var(--ma-font-display);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .coaching-cta {
    padding: 5.75rem 0;
    text-align: center;
    background:
      radial-gradient(circle at 50% 16%, rgba(0, 229, 160, 0.12), transparent 25rem),
      #050509;
  }

  .cta-inner {
    max-width: 820px;
  }

  .coaching-cta p {
    max-width: 680px;
    margin: 1rem auto 0;
  }

  .cta-actions {
    justify-content: center;
  }

  @media (max-width: 1080px) {
    .coaching-hero-grid,
    .clarity-grid,
    .session-grid,
    .boundaries-grid {
      grid-template-columns: 1fr;
    }

    .themes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .coaching-hero {
      min-height: auto;
      padding: 7rem 0 3.5rem;
    }

    .leadership-scene {
      height: 56rem;
    }

    .scene-vignette {
      background:
        linear-gradient(180deg, rgba(0, 0, 0, 0.92), rgba(0, 0, 0, 0.7) 42%, rgba(0, 0, 0, 0.96)),
        linear-gradient(90deg, rgba(0, 0, 0, 0.84), rgba(0, 0, 0, 0.38));
    }

    .coaching-copy h1 {
      font-size: 2.66rem;
      line-height: 1;
    }

    .coaching-copy p,
    .clarity-copy p,
    .session-copy p,
    .boundaries-panel p,
    .coaching-cta p {
      font-size: 1rem;
    }

    .coaching-actions,
    .cta-actions {
      display: grid;
    }

    .coaching-actions .ma-btn,
    .cta-actions .ma-btn {
      justify-content: center;
      width: 100%;
    }

    .themes-grid,
    .boundary-list {
      grid-template-columns: 1fr;
    }

    .session-steps article {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .leadership-scene {
      opacity: 0.42;
    }
  }
</style>

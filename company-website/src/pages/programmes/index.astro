---
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';

const bookingUrl =
  'https://outlook.office.com/bookwithme/user/f0762b9af6a94ed2add9818a4f3ca4e5@digitaltechnologypartner.ai/meetingtype/qc2lOXjEdkO6GkMS_jZJrQ2?anonymous';

const programmes = [
  {
    signal: 'Assess',
    title: 'AI Adoption Readiness',
    href: '/programmes/ai-adoption-readiness/',
    summary:
      'A one-week view of current AI use, adoption risk, missed value and the next leadership decision.',
    bestFor: 'When leaders are uncertain what is happening, what is safe, or where to start.',
    output: 'Current-state map, risk/opportunity readout and recommended next action.',
    cta: 'Start with Readiness',
    featured: true,
  },
  {
    signal: 'Focus',
    title: 'AI Foundry',
    href: '/programmes/ai-foundry/',
    summary:
      'A practical working group for teams who need to explore useful AI opportunities through real work.',
    bestFor: 'When the organisation needs team confidence, use-case evidence and a stronger opportunity backlog.',
    output: 'Working sessions, prioritised experiments, adoption observations and candidate roadmap.',
    cta: 'Explore Foundry',
  },
  {
    signal: 'Lead',
    title: 'Senior Leadership AI Coaching',
    href: '/programmes/leadership-ai-coaching/',
    summary:
      'Discreet one-to-one AI and technology support for senior leaders making practical decisions.',
    bestFor: 'When a leader needs a trusted technical sounding board, translation and private confidence.',
    output: 'Clearer choices on strategy, vendors, governance, workflows and personal AI use.',
    cta: 'View Coaching',
  },
];

const decisionSignals = [
  'You have AI activity but no shared map of value, risk or ownership.',
  'Teams are interested in AI, but confidence and practical use cases are uneven.',
  'Senior leaders need private support before making public commitments.',
  'The business wants progress without jumping straight into an expensive build.',
];

const routeSteps = [
  {
    label: '01',
    title: 'Map the current reality',
    text: 'Readiness shows what is happening, what is risky and which decision is actually needed.',
  },
  {
    label: '02',
    title: 'Build team evidence',
    text: 'Foundry turns curiosity into grounded opportunities, workflow insight and leadership evidence.',
  },
  {
    label: '03',
    title: 'Move only when justified',
    text: 'The strongest ideas can move into Discovery, PoC, MVP, Pilot and Launch through DTP delivery.',
  },
];
---

<Layout
  title="AI Programmes - Digital Technology Partner"
  description="Structured DTP programmes for AI readiness, AI working groups and discreet senior leadership coaching."
>
  <Header />
  <main class="programmes-page">
    <section class="programmes-hero">
      <div class="programmes-grid-bg"></div>
      <div class="ma-container programmes-hero-grid">
        <div class="programmes-copy">
          <span class="ma-section-tag">// programmes.control_room</span>
          <h1>Structured ways to assess, focus and lead AI adoption.</h1>
          <p>
            Choose a practical route into AI: map the current reality, build confidence through
            working sessions, or give senior leaders discreet decision support.
          </p>
          <div class="programmes-actions">
            <a class="ma-btn ma-btn-mint" href="#compare">Compare programmes</a>
            <a class="ma-btn ma-btn-outline" href={bookingUrl} target="_blank" rel="noopener noreferrer">
              Book a Discovery Call
            </a>
          </div>
        </div>

        <aside class="decision-panel" aria-label="Programme decision signals">
          <span>best starting signal</span>
          <strong>Most uncertain organisations should start with Readiness.</strong>
          <p>
            It gives leadership the map before committing people, budget or political capital.
          </p>
          <ul>
            {decisionSignals.map((signal) => <li>{signal}</li>)}
          </ul>
        </aside>
      </div>
    </section>

    <section class="ma-section compare-section" id="compare">
      <div class="ma-container">
        <div class="ma-section-header compare-head">
          <span class="ma-section-tag">// compare_the_routes</span>
          <h2>Pick the route that matches the decision in front of you.</h2>
          <p>
            These are deliberately focused programmes. Each creates a clearer next decision,
            not a vague enthusiasm report.
          </p>
        </div>

        <div class="programme-grid">
          {programmes.map((programme) => (
            <article class:list={['programme-card', { featured: programme.featured }]}>
              <div class="ma-card-line"></div>
              <span>{programme.signal}</span>
              <h3>{programme.title}</h3>
              <p>{programme.summary}</p>
              <dl>
                <div>
                  <dt>Best for</dt>
                  <dd>{programme.bestFor}</dd>
                </div>
                <div>
                  <dt>Output</dt>
                  <dd>{programme.output}</dd>
                </div>
              </dl>
              <a href={programme.href}>{programme.cta}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ma-section route-section">
      <div class="ma-container route-grid">
        <div class="route-copy">
          <span class="ma-section-tag">// recommended_sequence</span>
          <h2>A calm path from uncertainty to action.</h2>
          <p>
            The programmes work independently, but the strongest route is often Readiness,
            then Foundry, then controlled delivery. That keeps AI adoption grounded in evidence.
          </p>
        </div>
        <div class="route-steps">
          {routeSteps.map((step) => (
            <article>
              <span>{step.label}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="programme-proof">
      <div class="ma-container proof-inner">
        <div>
          <span class="ma-section-tag">// proof_before_commitment</span>
          <h2>Designed to reduce risk before delivery starts.</h2>
        </div>
        <div class="proof-copy">
          <p>
            DTP programmes help leadership decide what deserves ownership, what should be
            governed, what needs team confidence and what should move into staged delivery.
          </p>
          <a class="ma-btn ma-btn-mint" href="/programmes/ai-adoption-readiness/">Start with AI Readiness</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .programmes-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 20% 12%, rgba(0, 229, 160, 0.12), transparent 30rem),
      radial-gradient(circle at 78% 20%, rgba(124, 139, 255, 0.08), transparent 28rem),
      #000;
  }

  .programmes-hero {
    position: relative;
    min-height: 82vh;
    padding: 8.75rem 0 4rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--ma-border);
  }

  .programmes-grid-bg {
    position: absolute;
    inset: 0;
    opacity: 0.13;
    background-image:
      linear-gradient(rgba(244, 241, 232, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 232, 0.04) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 74% 70% at 58% 42%, black, transparent 84%);
  }

  .programmes-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(360px, 0.96fr);
    gap: 4rem;
    align-items: center;
  }

  .programmes-copy h1 {
    max-width: 780px;
    margin-bottom: 1.3rem;
    color: #f4f1e8;
    font-size: 4.6rem;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .programmes-copy p {
    max-width: 660px;
    color: #d8d6ce;
    font-size: 1.12rem;
    line-height: 1.72;
  }

  .programmes-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .decision-panel {
    padding: 1.65rem;
    border: 1px solid rgba(0, 229, 160, 0.3);
    border-radius: var(--ma-radius);
    background:
      radial-gradient(circle at 18% 15%, rgba(0, 229, 160, 0.12), transparent 18rem),
      rgba(17, 17, 34, 0.72);
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.32);
  }

  .decision-panel span,
  .programme-card > span,
  .route-steps article > span {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--ma-mint);
    font-family: var(--ma-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .decision-panel strong {
    display: block;
    color: #f4f1e8;
    font-family: var(--ma-font-display);
    font-size: 1.65rem;
    line-height: 1.18;
  }

  .decision-panel p {
    margin-top: 1rem;
    color: #d8d6ce;
    line-height: 1.65;
  }

  .decision-panel ul {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.4rem;
    padding: 0;
    list-style: none;
  }

  .decision-panel li {
    padding-left: 1rem;
    border-left: 2px solid rgba(0, 229, 160, 0.7);
    color: var(--ma-text);
    line-height: 1.52;
  }

  .compare-section {
    background: var(--ma-bg);
  }

  .compare-head {
    max-width: 820px;
  }

  .compare-head h2,
  .route-copy h2,
  .proof-inner h2 {
    letter-spacing: 0;
  }

  .compare-head p {
    max-width: 720px;
    margin-top: 0.9rem;
    color: #d8d6ce;
    font-size: 1.05rem;
    line-height: 1.68;
  }

  .programme-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .programme-card {
    position: relative;
    min-height: 100%;
    padding: 1.45rem;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(244, 241, 232, 0.13);
    border-radius: var(--ma-radius);
    background: var(--ma-surface);
  }

  .programme-card.featured {
    border-color: rgba(0, 229, 160, 0.5);
    background: linear-gradient(145deg, rgba(0, 229, 160, 0.1), rgba(17, 17, 34, 0.86));
  }

  .programme-card h3 {
    margin-bottom: 0.85rem;
    color: #f4f1e8;
    font-size: 1.35rem;
    letter-spacing: 0;
  }

  .programme-card p,
  .programme-card dd {
    color: var(--ma-text-dim);
    line-height: 1.6;
  }

  .programme-card dl {
    display: grid;
    gap: 1rem;
    margin: 1.3rem 0;
  }

  .programme-card dt {
    margin-bottom: 0.25rem;
    color: #f4f1e8;
    font-family: var(--ma-font-display);
    font-size: 0.95rem;
  }

  .programme-card a {
    margin-top: auto;
    color: var(--ma-mint);
    font-family: var(--ma-font-display);
    font-weight: 600;
  }

  .route-section {
    border-top: 1px solid var(--ma-border);
    border-bottom: 1px solid var(--ma-border);
    background:
      linear-gradient(135deg, rgba(0, 229, 160, 0.08), rgba(124, 139, 255, 0.06)),
      #07070c;
  }

  .route-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 3rem;
    align-items: start;
  }

  .route-copy p {
    margin-top: 1rem;
    color: #d8d6ce;
    font-size: 1.05rem;
    line-height: 1.68;
  }

  .route-steps {
    display: grid;
    gap: 1rem;
  }

  .route-steps article {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1.2rem;
    padding: 1.2rem;
    border: 1px solid rgba(244, 241, 232, 0.12);
    border-radius: var(--ma-radius);
    background: rgba(5, 5, 9, 0.58);
  }

  .route-steps h3 {
    margin-bottom: 0.35rem;
    font-size: 1.1rem;
    letter-spacing: 0;
  }

  .route-steps p {
    line-height: 1.58;
  }

  .programme-proof {
    padding: 5.5rem 0;
    background:
      radial-gradient(circle at 50% 12%, rgba(0, 229, 160, 0.12), transparent 24rem),
      #050509;
  }

  .proof-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 3rem;
    align-items: center;
  }

  .proof-copy p {
    max-width: 650px;
    margin-bottom: 1.5rem;
    color: #d8d6ce;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  @media (max-width: 980px) {
    .programmes-hero {
      min-height: auto;
      padding: 7rem 0 3.5rem;
    }

    .programmes-hero-grid,
    .programme-grid,
    .route-grid,
    .proof-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .programmes-copy h1 {
      font-size: 2.72rem;
      line-height: 1;
    }

    .programmes-copy p,
    .compare-head p,
    .route-copy p,
    .proof-copy p {
      font-size: 1rem;
    }

    .programmes-actions {
      display: grid;
    }

    .programmes-actions .ma-btn,
    .proof-copy .ma-btn {
      justify-content: center;
      width: 100%;
    }

    .route-steps article {
      grid-template-columns: 1fr;
    }
  }
</style>

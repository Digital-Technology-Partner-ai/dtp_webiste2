---
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';

const programmes = [
  {
    tag: 'Assess · For the organisation',
    title: 'AI Adoption Readiness',
    href: '/programmes/ai-adoption-readiness/',
    output:
      'You leave with a current-state map of AI use, a risk and opportunity readout, and one recommended next action.',
    bestWhen:
      "Leaders are uncertain what's happening, what's safe, or where to start.",
    scope: 'One week.',
    cta: 'Start with Readiness',
    featured: true,
  },
  {
    tag: 'Focus · For the team',
    title: 'AI Foundry',
    href: '/programmes/ai-foundry/',
    output:
      'You leave with prioritised experiments, adoption observations and a candidate roadmap backed by evidence from real work.',
    bestWhen:
      'The organisation needs team confidence and use-case evidence, not more opinions.',
    scope: 'Twelve weeks.',
    cta: 'Explore Foundry',
  },
  {
    tag: 'Lead · For you',
    title: 'Senior Leadership AI Coaching',
    href: '/programmes/leadership-ai-coaching/',
    output:
      'You leave with clearer choices on strategy, vendors, governance and your own use of AI, worked through in private, with no internal audience.',
    bestWhen: 'One leader needs a trusted, confidential sounding board.',
    cta: 'View Coaching',
  },
];

const triageStatements = [
  {
    statement:
      "There's AI activity everywhere, but no shared map of value, risk or ownership.",
    route: 'Start with Readiness',
  },
  {
    statement:
      'Teams are curious, but confidence is uneven and ideas outnumber evidence.',
    route: "That's Foundry",
  },
  {
    statement: "You're personally expected to have answers you don't have yet.",
    route: "That's Coaching",
  },
  {
    statement: "The board wants progress, but won't sign a big build on faith.",
    route: 'Start with Readiness',
  },
];
---

<Layout
  title="AI Programmes: for the organisation, the team, and you | Digital Technology Partner"
  description="Three focused AI programmes from DTP: a one-week readiness assessment, a hands-on AI Foundry for teams, and private AI coaching for senior leaders."
>
  <Header />
  <main class="programmes-page">
    <section class="programmes-hero">
      <div class="st-backdrop" aria-hidden="true">
        <img
          src="/images/studio/neuralmesh-2400.webp"
          srcset="/images/studio/neuralmesh-1280.webp 1280w, /images/studio/neuralmesh-2400.webp 2400w"
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="programmes-grid-bg"></div>
      <div class="ma-container programmes-hero-grid">
        <div class="programmes-copy">
          <span class="ma-section-tag">// choose_your_door</span>
          <h1>For the organisation. For the team. For you.</h1>
          <p>
            Three focused programmes: map the organisation's AI reality, build
            the team's confidence on real work, or give one leader private
            clarity. Each ends with a decision, not a vague enthusiasm report.
          </p>
          <div class="programmes-actions">
            <a class="ma-btn ma-btn-mint" href="#compare">Compare the routes</a>
            <a class="ma-btn ma-btn-outline" href="/contact/">
              Book a Discovery Call
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="ma-section triage-section">
      <div class="ma-container">
        <div class="ma-section-header triage-head">
          <span class="ma-section-tag">// which_of_these_is_true</span>
          <h2>Tell us what's true. It points at where to start.</h2>
        </div>
        <div class="triage-grid">
          {
            triageStatements.map((item, index) => (
              <article class="triage-card">
                <span>{index + 1}</span>
                <p>"{item.statement}"</p>
                <strong>{item.route}</strong>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ma-section compare-section" id="compare">
      <div class="ma-container">
        <div class="ma-section-header compare-head">
          <span class="ma-section-tag">// compare_the_routes</span>
          <h2>Pick the route that matches where you are.</h2>
        </div>

        <div class="programme-grid">
          {
            programmes.map((programme) => (
              <article
                class:list={[
                  'programme-card',
                  { featured: programme.featured },
                ]}
              >
                <div class="ma-card-line" />
                <span>{programme.tag}</span>
                <h3>{programme.title}</h3>
                <p class="programme-output">{programme.output}</p>
                <dl>
                  <div>
                    <dt>Best when</dt>
                    <dd>{programme.bestWhen}</dd>
                  </div>
                  {programme.scope && (
                    <div>
                      <dt>Scope</dt>
                      <dd>{programme.scope}</dd>
                    </div>
                  )}
                </dl>
                <a href={programme.href}>{programme.cta}</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ma-section route-section">
      <div class="ma-container route-grid">
        <div class="route-copy">
          <span class="ma-section-tag">// why_this_order</span>
          <h2>They stand alone. They're stronger in order.</h2>
        </div>
        <div class="route-copy">
          <p>
            Readiness shows what's real. Foundry turns what's real into
            evidence. The strongest evidence earns staged delivery: Discovery,
            PoC, MVP, Pilot, Launch. Coaching runs alongside any of it, or
            before everything.
          </p>
          <a class="route-link" href="/process/">See how delivery works</a>
        </div>
      </div>
    </section>

    <section class="programme-proof">
      <div class="ma-container proof-inner">
        <div>
          <span class="ma-section-tag">// the_smallest_commitment</span>
          <h2>Still unsure? Then it's one week, by definition.</h2>
        </div>
        <div class="proof-copy">
          <p>
            When the right route isn't obvious, that is the Readiness signal:
            get the map before committing people, budget or attention.
          </p>
          <a
            class="ma-btn ma-btn-mint"
            href="/programmes/ai-adoption-readiness/">Start with AI Readiness</a
          >
          <a class="ma-btn ma-btn-outline" href="/contact/"
            >Book a Discovery Call</a
          >
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .programmes-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 20% 12%,
        rgba(5, 204, 144, 0.1),
        transparent 30rem
      ),
      radial-gradient(
        circle at 78% 20%,
        rgba(124, 139, 255, 0.06),
        transparent 28rem
      );
  }

  .programmes-hero {
    position: relative;
    min-height: 82vh;
    padding: 8.75rem 0 4rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--ma-border);
  }

  .programmes-grid-bg {
    position: absolute;
    inset: 0;
    opacity: 0.13;
    background-image:
      linear-gradient(rgba(244, 241, 232, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 232, 0.04) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(
      ellipse 74% 70% at 58% 42%,
      black,
      transparent 84%
    );
  }

  .programmes-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }

  .programmes-copy h1 {
    max-width: 980px;
    margin-bottom: 1.3rem;
    color: #f4f1e8;
    font-size: 4.6rem;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .programmes-copy p {
    max-width: 760px;
    color: #d8d6ce;
    font-size: 1.12rem;
    line-height: 1.72;
  }

  .programmes-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .programme-card > span,
  .triage-card span {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--ma-mint);
    font-family: var(--ma-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .triage-section {
    background: rgba(11, 16, 26, 0.45);
    border-bottom: 1px solid var(--ma-border);
  }

  .triage-head {
    max-width: 820px;
  }

  .triage-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .triage-card {
    min-height: 235px;
    padding: 1.2rem;
    border: 1px solid var(--ma-border);
    background: var(--st-panel-glass);
    backdrop-filter: blur(6px);
    transition: border-color var(--ma-transition);
  }

  .triage-card:hover {
    border-color: rgba(5, 204, 144, 0.45);
  }

  .triage-card p {
    color: #f4f1e8;
    font-family: var(--ma-font-display);
    font-size: 1.12rem;
    line-height: 1.34;
  }

  .triage-card strong {
    display: inline-flex;
    margin-top: 1rem;
    color: var(--ma-mint);
    font-family: var(--ma-font-display);
  }

  .compare-section {
    background: transparent;
  }

  .compare-head {
    max-width: 820px;
  }

  .compare-head h2,
  .route-copy h2,
  .proof-inner h2 {
    letter-spacing: 0;
  }

  .programme-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .programme-card {
    position: relative;
    min-height: 100%;
    padding: 1.45rem;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--ma-border);
    background: var(--st-panel-glass);
    backdrop-filter: blur(6px);
    transition: border-color var(--ma-transition);
  }

  .programme-card:hover {
    border-color: rgba(5, 204, 144, 0.45);
  }

  .programme-card.featured {
    border-color: rgba(5, 204, 144, 0.5);
    background: linear-gradient(
      145deg,
      rgba(5, 204, 144, 0.1),
      rgba(11, 16, 26, 0.86)
    );
  }

  .programme-card h3 {
    margin-bottom: 0.85rem;
    color: #f4f1e8;
    font-size: 1.35rem;
    letter-spacing: 0;
  }

  .programme-card p,
  .programme-card dd {
    color: var(--ma-text-dim);
    line-height: 1.6;
  }

  .programme-card .programme-output {
    color: #f4f1e8;
    font-family: var(--ma-font-display);
    font-size: 1.08rem;
    line-height: 1.45;
  }

  .programme-card dl {
    display: grid;
    gap: 1rem;
    margin: 1.3rem 0;
  }

  .programme-card dt {
    margin-bottom: 0.25rem;
    color: #f4f1e8;
    font-family: var(--ma-font-display);
    font-size: 0.95rem;
  }

  .programme-card a {
    margin-top: auto;
    color: var(--ma-mint);
    font-family: var(--ma-font-display);
    font-weight: 600;
    text-decoration: none;
  }

  .route-section {
    border-top: 1px solid var(--ma-border);
    border-bottom: 1px solid var(--ma-border);
    background: linear-gradient(
      135deg,
      rgba(5, 204, 144, 0.07),
      rgba(124, 139, 255, 0.05)
    );
  }

  .route-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 3rem;
    align-items: start;
  }

  .route-copy p {
    margin-top: 1rem;
    color: #d8d6ce;
    font-size: 1.05rem;
    line-height: 1.68;
  }

  .route-link {
    display: inline-flex;
    margin-top: 1.3rem;
    color: var(--ma-mint);
    font-family: var(--ma-font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .programme-proof {
    padding: 6.5rem 0;
    background: radial-gradient(
      circle at 50% 12%,
      rgba(5, 204, 144, 0.1),
      transparent 24rem
    );
  }

  .proof-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 3rem;
    align-items: center;
  }

  .proof-copy p {
    max-width: 650px;
    margin-bottom: 1.5rem;
    color: #d8d6ce;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .proof-copy {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .proof-copy p {
    flex-basis: 100%;
  }

  @media (max-width: 980px) {
    .programmes-hero {
      min-height: auto;
      padding: 7rem 0 3.5rem;
    }

    .programmes-hero-grid,
    .triage-grid,
    .programme-grid,
    .route-grid,
    .proof-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .programmes-copy h1 {
      font-size: 2.72rem;
      line-height: 1;
    }

    .programmes-copy p,
    .route-copy p,
    .proof-copy p {
      font-size: 1rem;
    }

    .programmes-actions,
    .proof-copy {
      display: grid;
      justify-content: stretch;
      width: 100%;
    }

    .programmes-actions .ma-btn,
    .proof-copy .ma-btn {
      justify-content: center;
      width: 100%;
    }

    .route-steps article {
      grid-template-columns: 1fr;
    }
  }
</style>

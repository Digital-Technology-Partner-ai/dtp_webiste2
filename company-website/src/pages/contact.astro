---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const emailAddress = 'info@digitaltechnologypartner.ai';
const whatsappNumber = '+44 7769 386204';
const whatsappUrl = 'https://wa.me/447769386204';

const openers = [
  'We bought AI licences, but people still are not using them.',
  'I need to brief the board on AI and I have three weeks.',
  'Our quoting process is too slow and we need to fix it.',
  "We cannot see what AI tools our teams are already using.",
];

const emailHref = (subject: string) =>
  `mailto:${emailAddress}?subject=${encodeURIComponent(subject)}`;

const doors = [
  {
    title: 'A discovery call',
    body: 'Thirty minutes on your situation. No preparation needed, nothing to bring.',
    link: 'Send an email',
    href: `mailto:${emailAddress}`,
  },
  {
    title: 'A confidential conversation',
    body: "For leaders who'd rather think privately first. No CC list, nothing minuted, WhatsApp if you prefer.",
    link: 'WhatsApp directly',
    href: whatsappUrl,
  },
  {
    title: 'A specific build',
    body: "Bring the workflow. We'll bring the questions.",
    link: 'Send an email',
    href: `mailto:${emailAddress}`,
  },
];
---

<Layout
  title="Contact, what happens when you press send | Digital Technology Partner"
  description="Email or WhatsApp; a person reads it and replies within a working day. The first conversation is a conversation, not a pitch. Aberdeen and remote."
>
  <Header />
  <main>
    <section class="ma-hero">
      <div class="st-backdrop st-backdrop--right" aria-hidden="true">
        <img
          src="/images/studio/pcb-blackhole-2400.webp"
          srcset="/images/studio/pcb-blackhole-1280.webp 1280w, /images/studio/pcb-blackhole-2400.webp 2400w"
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="ma-grid-bg"></div>
      <div class="ma-scan-line"></div>
      <div class="ma-container ma-hero-content">
        <div class="ma-hero-tag">// what_happens_next</div>
        <h1>Here's exactly what happens when you press send.</h1>
        <p class="ma-hero-sub">
          A person reads it, usually the same day. You get a short, useful
          reply, not a sequence. And the first conversation is a conversation,
          not a pitch.
        </p>
        <div class="hero-actions">
          <a href={`mailto:${emailAddress}`} class="ma-btn ma-btn-mint"
            >Send an email</a
          >
          <a href={whatsappUrl} class="ma-btn ma-btn-outline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="ma-section one-sentence-section">
      <div class="ma-container one-sentence-inner">
        <div class="section-copy">
          <span class="ma-section-tag">// choose_one</span>
          <h2>See your problem? Click it and an email to DTP opens.</h2>
          <p>
            Read the four statements. Pick the one that sounds most like your
            situation. Your email app opens with DTP addressed and the subject
            already filled in. Send it as it is, or add one line of detail.
          </p>
        </div>
        <div class="opener-panel">
          <div class="opener-grid" aria-label="Example openers">
            {
              openers.map((opener) => (
                <a
                  class="opener-option"
                  href={emailHref(opener)}
                  aria-label={`Open an email to DTP with the subject: ${opener}`}
                >
                  <span>{opener}</span>
                  <span class="opener-option-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M4.75 6.75h14.5v10.5H4.75z" />
                      <path d="m5.25 7.25 6.75 5.5 6.75-5.5" />
                    </svg>
                  </span>
                </a>
              ))
            }
          </div>
          <p class="opener-fallback">
            If your email app does not open, copy {emailAddress} and paste the
            sentence you chose into the subject line.
          </p>
        </div>
      </div>
    </section>

    <section class="ma-section doors-section">
      <div class="ma-container">
        <div class="section-copy section-copy-wide">
          <span class="ma-section-tag">// pick_your_door</span>
          <h2>What kind of conversation do you need?</h2>
        </div>
        <div class="doors-grid">
          {
            doors.map((door) => (
              <article class="ma-card door-card">
                <div class="ma-card-line" />
                <h3>{door.title}</h3>
                <p>{door.body}</p>
                <a href={door.href} class="contact-text-link">
                  {door.link}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ma-section contact-section">
      <div class="ma-container">
        <div class="contact-layout">
          <div class="contact-left">
            <div class="ma-card contact-map-card">
              <div class="ma-card-line"></div>
              <span class="ma-section-tag">// our_office</span>
              <h3>Our Office</h3>
              <div class="map-placeholder">
                <div class="map-placeholder-inner">
                  <span class="map-icon">&#9906;</span>
                  <p>
                    111 Gallowgate, Aberdeen, AB25 1BU, Scotland, United Kingdom
                  </p>
                </div>
              </div>
              <div class="map-links">
                <a
                  href="https://maps.google.com/?q=111+Gallowgate,+Aberdeen+AB25+1BU"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ma-btn ma-btn-outline map-link-btn"
                >
                  Google Maps
                </a>
                <a
                  href="https://www.openstreetmap.org/?mlat=57.1497&mlon=-2.0943#map=16/57.1497/-2.0943"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ma-btn ma-btn-outline map-link-btn"
                >
                  OpenStreetMap
                </a>
              </div>
            </div>
          </div>

          <div class="contact-right">
            <div class="ma-card">
              <div class="ma-card-line"></div>
              <h3>Our Office</h3>
              <p class="contact-address">
                111 Gallowgate<br />Aberdeen<br />AB25 1BU<br />Scotland<br
                />United Kingdom
              </p>
            </div>

            <div class="contact-methods">
              <a
                href={`mailto:${emailAddress}`}
                class="ma-card contact-method-card"
              >
                <div class="ma-card-line"></div>
                <h4>Email</h4>
                <span class="contact-method-val">{emailAddress}</span>
              </a>
              <a href={whatsappUrl} class="ma-card contact-method-card">
                <div class="ma-card-line"></div>
                <h4>WhatsApp</h4>
                <span class="contact-method-val">{whatsappNumber}</span>
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="ma-cta">
      <div class="ma-container ma-cta-inner">
        <span class="ma-section-tag">// whenever_youre_ready</span>
        <h2>Still deciding? That's allowed.</h2>
        <p>
          Browse the case studies, read Insights, or start with the one week
          Readiness Sprint when the time is right. The door doesn't expire.
        </p>
        <div class="cta-actions">
          <a href="/case-studies/" class="ma-btn ma-btn-outline">Case studies</a
          >
          <a href="/insights/" class="ma-btn ma-btn-outline">Insights</a>
          <a
            href="/programmes/ai-adoption-readiness/"
            class="ma-btn ma-btn-mint"
          >
            AI Adoption Readiness
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .ma-hero {
    position: relative;
    min-height: 78vh;
    display: flex;
    align-items: center;
    padding: 11rem 0 6rem;
    overflow: hidden;
    border-bottom: 1px solid var(--ma-border);
  }

  .ma-hero-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
  }

  .ma-hero-tag {
    font-family: var(--ma-font-mono);
    font-size: 0.85rem;
    color: var(--ma-mint);
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }

  .ma-hero h1 {
    max-width: 760px;
    line-height: 1.05;
    margin-bottom: 1.5rem;
    letter-spacing: 0;
  }

  .ma-hero-sub {
    font-size: 1.1rem;
    color: var(--ma-text-dim);
    max-width: 660px;
    line-height: 1.7;
  }

  .hero-actions,
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .section-copy {
    max-width: 600px;
  }

  .section-copy-wide {
    max-width: 760px;
    margin-bottom: 2rem;
  }

  .section-copy h2,
  .ma-cta-inner h2 {
    color: var(--ma-white);
    letter-spacing: 0;
  }

  .section-copy p,
  .ma-cta-inner p {
    margin-top: 1rem;
    color: var(--ma-text-dim);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .one-sentence-section {
    background: rgba(11, 16, 26, 0.4);
    border-top: 1px solid var(--ma-border);
    border-bottom: 1px solid var(--ma-border);
  }

  .one-sentence-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 2rem;
    align-items: start;
  }

  .opener-grid {
    display: grid;
    gap: 1rem;
  }

  .opener-option {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 1rem 1.1rem;
    border-left: 2px solid rgba(5, 204, 144, 0.68);
    background: var(--st-panel-glass);
    color: var(--ma-text);
    font-family: var(--ma-font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    text-decoration: none;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .opener-option:hover,
  .opener-option:focus-visible {
    border-left-color: var(--ma-mint);
    background: rgba(5, 204, 144, 0.08);
    color: var(--ma-white);
    transform: translateX(3px);
  }

  .opener-option:focus-visible {
    outline: 2px solid rgba(5, 204, 144, 0.72);
    outline-offset: 3px;
  }

  .opener-option-mark {
    grid-column: 2;
    align-items: center;
    justify-content: center;
    color: var(--ma-mint);
    display: inline-flex;
    flex: 0 0 1.62rem;
    width: 1.62rem;
    height: 1.62rem;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .opener-option:hover .opener-option-mark,
  .opener-option:focus-visible .opener-option-mark {
    transform: scale(1.06);
  }

  .opener-option-mark svg {
    display: block;
    width: 1.62rem;
    height: 1.62rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .opener-fallback {
    margin-top: 0.85rem;
    color: var(--ma-text-dim);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .doors-section {
    background: transparent;
  }

  .doors-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .door-card {
    min-height: 230px;
  }

  .door-card h3 {
    margin-bottom: 0.75rem;
  }

  .door-card p {
    color: var(--ma-text-dim);
    line-height: 1.6;
  }

  .contact-text-link {
    display: inline-flex;
    margin-top: 1.2rem;
    color: var(--ma-mint);
    font-family: var(--ma-font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .contact-text-link:hover {
    text-decoration: underline;
  }

  .contact-section {
    border-top: 1px solid var(--ma-border);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .contact-left,
  .contact-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-map-card h3 {
    margin: 0.6rem 0 1rem;
  }

  .map-placeholder {
    background: var(--ma-surface-alt);
    border: 1px solid var(--ma-border);
    border-radius: var(--ma-radius);
    height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .map-placeholder-inner {
    text-align: center;
  }

  .map-icon {
    font-size: 2rem;
    color: var(--ma-mint);
    display: block;
    margin-bottom: 0.5rem;
  }

  .map-placeholder-inner p {
    font-size: 0.85rem;
    color: var(--ma-text-dim);
  }

  .map-links {
    display: flex;
    gap: 0.75rem;
  }

  .map-link-btn {
    font-size: 0.82rem;
    padding: 0.5rem 1rem;
  }

  .ma-card h3 {
    margin-bottom: 0.5rem;
  }

  .contact-address {
    font-size: 0.92rem;
    line-height: 1.8;
    color: var(--ma-text);
  }

  .contact-methods {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .contact-method-card {
    display: block;
    text-decoration: none;
  }

  .contact-method-card h4 {
    font-size: 0.85rem;
    color: var(--ma-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.35rem;
  }

  .contact-method-val {
    font-size: 0.85rem;
    color: var(--ma-mint);
    word-break: break-word;
  }

  .ma-cta {
    padding: 7rem 0;
    background: radial-gradient(
      circle at 50% 10%,
      rgba(5, 204, 144, 0.1),
      transparent 26rem
    );
    border-top: 1px solid var(--ma-border);
  }

  .ma-cta-inner {
    text-align: center;
    max-width: 760px;
  }

  .ma-cta-inner p {
    margin-right: auto;
    margin-left: auto;
    max-width: 640px;
  }

  .cta-actions {
    justify-content: center;
  }

  @media (max-width: 980px) {
    .one-sentence-inner,
    .contact-layout {
      grid-template-columns: 1fr;
    }

    .doors-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .ma-hero {
      padding: 8rem 0 4rem;
    }

    .ma-hero h1 {
      font-size: 2.42rem;
      line-height: 1.04;
    }

    .hero-actions,
    .cta-actions {
      display: grid;
      width: 100%;
      justify-content: stretch;
    }

    .hero-actions .ma-btn,
    .cta-actions .ma-btn {
      justify-content: center;
      width: 100%;
    }

    .contact-methods {
      grid-template-columns: 1fr;
    }

    .map-links {
      flex-direction: column;
    }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout
  title="DTP — LinkedIn Above Fold — Rapid Assessment"
  description="A DTP above-the-fold concept for promoting the AI Adoption Readiness Rapid Assessment."
>
  <Header />
  <main class="social-fold rapid-assessment">
    <section class="fold-hero">
      <div class="fold-mesh" aria-hidden="true"></div>
      <div class="ma-container fold-grid">
        <div class="fold-copy">
          <span class="fold-kicker">// linkedin_card.seed_01 / rapid_assessment</span>
          <h1>Your people are already using AI. Leadership is still waiting for the report.</h1>
          <p>Most organisations do not need another AI inspiration session. They need a fast operating picture: where AI is being used, where risk is forming, and which opportunities are ready to prove.</p>
          <div class="fold-actions">
            <a class="ma-btn ma-btn-mint" href="https://outlook.office.com/bookwithme/user/f0762b9af6a94ed2add9818a4f3ca4e5@digitaltechnologypartner.ai/meetingtype/qc2lOXjEdkO6GkMS_jZJrQ2?anonymous" target="_blank" rel="noopener noreferrer">Book a Discovery Call</a>
            <a class="ma-btn ma-btn-outline" href="/homepage-ai-readiness-board-briefing/">See AI Readiness route</a>
          </div>
        </div>

        <aside class="assessment-card" aria-label="AI adoption rapid assessment illustration">
          <div class="card-top">
            <div>
              <span>rapid_assessment.map</span>
              <b>Leadership signal view</b>
            </div>
            <i>48h</i>
          </div>
          <div class="signal-list">
            <div class="signal-row hot">
              <span>01</span>
              <strong>Unsanctioned use</strong>
              <em>visible</em>
            </div>
            <div class="signal-row">
              <span>02</span>
              <strong>High-value workflows</strong>
              <em>ranked</em>
            </div>
            <div class="signal-row warn">
              <span>03</span>
              <strong>Data readiness</strong>
              <em>patchy</em>
            </div>
            <div class="signal-row">
              <span>04</span>
              <strong>Next decision</strong>
              <em>prove</em>
            </div>
          </div>
          <div class="decision-line">
            <small>assessment output</small>
            <strong>Encourage, control, investigate, stop or prove.</strong>
          </div>
        </aside>
      </div>
    </section>
  </main>
</Layout>

<style>
  .social-fold { background: #050507; color: #EBEBEB; }
  .fold-hero { min-height: 100vh; position: relative; overflow: hidden; padding: 8.75rem 0 4.75rem; display: grid; align-items: center; }
  .fold-mesh { position: absolute; inset: 0; background: radial-gradient(ellipse 60% 55% at 76% 40%, rgba(5,204,144,.13), transparent 62%), radial-gradient(ellipse 45% 45% at 10% 75%, rgba(42,64,220,.08), transparent 62%); pointer-events: none; }
  .fold-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1.02fr .98fr; gap: 4.5rem; align-items: center; }
  .fold-kicker { display: block; font-family: var(--ma-font-mono); font-size: .74rem; letter-spacing: .06em; color: var(--ma-mint); margin-bottom: 1.7rem; }
  .fold-copy h1 { font-size: clamp(3.2rem, 6.45vw, 6.25rem); line-height: .93; letter-spacing: -.064em; max-width: 820px; }
  .fold-copy p { max-width: 620px; margin: 1.55rem 0 2.2rem; font-size: 1.18rem; line-height: 1.72; color: rgba(235,235,235,.78); }
  .fold-actions { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }

  .assessment-card { background: linear-gradient(155deg, #17172a 0%, #0d0d18 100%); border: 1px solid rgba(255,255,255,.11); border-radius: 22px; overflow: hidden; box-shadow: 0 34px 110px rgba(0,0,0,.52), inset 0 0 0 1px rgba(5,204,144,.05); }
  .card-top { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; padding: 1.35rem 1.5rem; background: rgba(255,255,255,.028); border-bottom: 1px solid rgba(255,255,255,.07); }
  .card-top span { display: block; font-family: var(--ma-font-mono); font-size: .7rem; color: var(--ma-mint); letter-spacing: .06em; margin-bottom: .35rem; }
  .card-top b { display: block; font-family: var(--ma-font-display); font-size: 1.1rem; color: var(--ma-white); }
  .card-top i { font-style: normal; font-family: var(--ma-font-mono); color: var(--ma-mint); border: 1px solid rgba(5,204,144,.26); background: rgba(5,204,144,.08); border-radius: 999px; padding: .32rem .65rem; font-size: .72rem; }
  .signal-list { display: grid; padding: .75rem; gap: .6rem; }
  .signal-row { display: grid; grid-template-columns: 2.7rem 1fr auto; align-items: center; gap: 1rem; padding: 1rem 1rem; border: 1px solid rgba(255,255,255,.075); background: rgba(255,255,255,.035); border-radius: 12px; }
  .signal-row span { font-family: var(--ma-font-mono); color: var(--ma-mint); font-size: .74rem; }
  .signal-row strong { color: var(--ma-white); font-size: 1.03rem; }
  .signal-row em { font-style: normal; font-family: var(--ma-font-mono); color: rgba(235,235,235,.62); font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; }
  .signal-row.hot { border-color: rgba(5,204,144,.25); background: rgba(5,204,144,.055); }
  .signal-row.warn { border-color: rgba(255,185,45,.22); }
  .signal-row.warn span { color: rgba(255,185,45,.9); }
  .decision-line { margin: .2rem 1.5rem 1.5rem; padding: 1.25rem; border-radius: 14px; border: 1px solid rgba(5,204,144,.3); background: rgba(5,204,144,.07); }
  .decision-line small { display: block; font-family: var(--ma-font-mono); font-size: .67rem; text-transform: uppercase; letter-spacing: .08em; color: var(--ma-mint); margin-bottom: .45rem; }
  .decision-line strong { font-family: var(--ma-font-display); font-size: 1.38rem; line-height: 1.22; color: var(--ma-white); }

  @media (max-width: 1000px) { .fold-grid { grid-template-columns: 1fr; } .fold-hero { padding-top: 9rem; } }
  @media (max-width: 640px) { .fold-copy h1 { font-size: clamp(3rem, 14vw, 4.4rem); } .signal-row { grid-template-columns: 2rem 1fr; } .signal-row em { grid-column: 2; } }
</style>

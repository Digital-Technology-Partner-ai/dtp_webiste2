---
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

const cases = [
  {
    id: 'travel-risk',
    sector: 'Global energy services',
    vignette:
      'A new trip is confirmed. The risk picture may have changed, and the paperwork still starts from scratch.',
    title: 'Up-to-date travel risk documentation in under 60 seconds.',
    summary:
      'A global energy services business needed one fast route from a new travel requirement to a current risk assessment, Journey Management Plan and approval documentation.',
    signal: 'outdated risk + document drag',
    route: 'Mobile-first travel workflow + live risk intelligence',
    outcomes: [
      'Under 60 seconds',
      'Up-to-date risk data',
      'Three approval-ready documents',
    ],
    proof:
      'The guided flow reuses traveller data and current destination intelligence to generate the travel request, risk assessment and Journey Management Plan on mobile or desktop in under 60 seconds.',
  },
  {
    id: 'quotation',
    sector: 'Manufacturing',
    vignette: 'Someone in the quoting team is measuring PDF drawings by hand.',
    title: 'Technical quotation workflows made faster and more reliable.',
    summary:
      'A protective coating business needed to reduce manual PDF drawing analysis and surface-area calculation effort during quotation preparation.',
    signal: 'manual quotation drag',
    route: 'Workflow automation + custom calculation system',
    outcomes: [
      'Hours to minutes',
      'Reduced calculation error risk',
      'Faster quote turnaround',
    ],
    proof:
      'AI-assisted document and calculation workflows reduced effort around technical quotation work.',
  },
  {
    id: 'maintenance',
    sector: 'Manufacturing operations',
    vignette:
      "The maintenance schedule lives in someone's head and on a whiteboard.",
    title:
      'Maintenance visibility brought into the tools engineers already use.',
    summary:
      'A production-floor team needed maintenance reminders, evidence capture and management visibility without forcing engineers into desktop systems.',
    signal: 'missed maintenance risk',
    route: 'Messaging-native operational agent',
    outcomes: [
      'Zero missed tasks',
      'Real-time visibility',
      'Low-friction adoption',
    ],
    proof:
      'A controlled agent kept maintenance work visible, accountable and closer to the production floor.',
  },
  {
    id: 'infrastructure',
    sector: 'Infrastructure analytics',
    vignette:
      "The project needed AI depth the team didn't have, and the client couldn't be allowed to see a seam.",
    title: 'Specialist AI delivery added to an existing client project.',
    summary:
      'A technology consultancy needed AI and machine-learning expertise for infrastructure analytics while retaining the client relationship.',
    signal: 'specialist capability gap',
    route: 'Technical partnership + AI/search architecture',
    outcomes: [
      'Expanded capability',
      'Accelerated delivery',
      'Enhanced client value',
    ],
    proof:
      'DTP provided technical depth as a trusted delivery partner inside an existing project team.',
    trust:
      "When another consultancy hires us inside their own client relationship, that's diligence done for you.",
  },
];

const lenses = [
  {
    id: 'travel-risk',
    label: 'Travel risk',
    value:
      'turn current destination intelligence into approval-ready documents in under 60 seconds',
  },
  {
    id: 'quotation',
    label: 'Quotation',
    value: 'turn complex documents into faster commercial decisions',
  },
  {
    id: 'maintenance',
    label: 'Maintenance',
    value: 'make operational work visible where teams already are',
  },
  {
    id: 'infrastructure',
    label: 'AI/search',
    value: 'add specialist intelligence to complex data products',
  },
];
---

<Layout
  title="Case Studies, four patterns from real operations | Digital Technology Partner"
  description="Travel risk, workflow drag, missed visibility and missing capability: four real engagements turned into working systems. The industry doesn't need to match. The pattern does."
>
  <Header />
  <main class="case-page">
    <section class="case-hero" aria-labelledby="case-title">
      <div class="case-grid"></div>
      <div class="ma-container case-hero-inner">
        <div class="case-copy" data-case-reveal>
          <span class="ma-section-tag">// your_problem_not_our_trophies</span>
          <h1 id="case-title">
            You're not looking for our logo wall. You're looking for your
            problem.
          </h1>
          <p>
            Four patterns from real operations: travel risk, workflow drag,
            missed visibility and specialist capability. Each became a working
            system. The industry doesn't need to match. The pattern does.
          </p>
          <div class="case-actions">
            <a class="ma-btn ma-btn-mint" href="/contact/"
              >Discuss a similar problem</a
            >
            <a class="ma-btn ma-btn-outline" href="/solutions/"
              >Explore solution routes</a
            >
          </div>
        </div>

        <aside
          class="proof-console"
          aria-label="Animated proof constellation"
          data-case-reveal
        >
          <div class="proof-console-top">
            <span>// how_we_solve</span>
          </div>
          <div class="proof-visual">
            <canvas id="proof-constellation-scene" aria-hidden="true"></canvas>
            <span class="proof-label proof-label-travel">signal</span>
            <span class="proof-label proof-label-workflow">evidence</span>
            <span class="proof-label proof-label-agent">prototype</span>
            <span class="proof-label proof-label-search">system</span>
          </div>
          <div class="proof-readout" aria-live="polite">
            <span id="proof-console-value"
              >Follow the signal, test the idea, then build what earns its
              place.</span
            >
          </div>
        </aside>
      </div>
    </section>

    <section class="ma-section lens-section">
      <div class="ma-container lens-strip" aria-label="Proof lenses">
        {
          lenses.map((lens) => (
            <button
              type="button"
              data-proof-lens={lens.id}
              class:list={[
                'lens-button',
                { active: lens.id === 'travel-risk' },
              ]}
              aria-pressed={lens.id === 'travel-risk' ? 'true' : 'false'}
            >
              <span>{lens.label}</span>
              <strong>{lens.value}</strong>
            </button>
          ))
        }
      </div>
    </section>

    <section class="ma-section case-stack-section">
      <div class="ma-container">
        <div class="case-stack-head" data-case-reveal>
          <span class="ma-section-tag">// four_patterns</span>
          <h2>Four patterns, told properly.</h2>
          <p>
            Four engagements told properly beat thirty logos told vaguely. Each
            one is a pattern you can test against your own operation.
          </p>
        </div>
        <div class="case-stack">
          {
            cases.map((item) => (
              <article class="case-panel" data-case-card data-case-id={item.id}>
                <div class="case-panel-meta">
                  <span>{item.sector}</span>
                  <strong>{item.signal}</strong>
                </div>
                <div class="case-panel-main">
                  <p class="case-vignette">{item.vignette}</p>
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                  <dl>
                    <div>
                      <dt>Route</dt>
                      <dd>{item.route}</dd>
                    </div>
                    <div>
                      <dt>Proof</dt>
                      <dd>{item.proof}</dd>
                    </div>
                  </dl>
                </div>
                <ul>
                  {item.outcomes.map((outcome) => (
                    <li>{outcome}</li>
                  ))}
                </ul>
                {item.trust && <p class="case-trust">{item.trust}</p>}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="case-cta">
      <div class="ma-container case-cta-inner" data-case-reveal>
        <span class="ma-section-tag">// which_pattern_is_yours</span>
        <h2>Recognise one of these patterns?</h2>
        <div class="pattern-match" aria-label="Case study pattern matching">
          <p>
            <strong>Travel risk built from stale information</strong><span
              >the travel risk pattern</span
            >
          </p>
          <p>
            <strong>Time lost to documents</strong><span
              >the quotation pattern</span
            >
          </p>
          <p>
            <strong>Work that goes invisible</strong><span
              >the agent pattern</span
            >
          </p>
          <p>
            <strong>Capability you don't have in-house</strong><span
              >the partnership pattern</span
            >
          </p>
        </div>
        <p>
          Bring us the symptom. DTP will help decide whether it needs Readiness,
          Foundry, Discovery or a focused proof of concept. And if you want the
          unglamorous detail, the gates, the dead ends, the decisions, ask.
          We'll walk you through any of these properly.
        </p>
        <div class="case-actions">
          <a class="ma-btn ma-btn-mint ma-btn-lg" href="/contact/"
            >Discuss a similar problem</a
          >
          <a class="ma-btn ma-btn-outline ma-btn-lg" href="/process/"
            >See the process</a
          >
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;
  const canvas = document.getElementById(
    'proof-constellation-scene'
  ) as HTMLCanvasElement | null;
  const gsapReady = import('gsap');
  const lensButtons = Array.from(
    document.querySelectorAll('[data-proof-lens]')
  ) as HTMLButtonElement[];

  const setProofLens = (button: HTMLButtonElement) => {
    lensButtons.forEach((item) => {
      const active = item === button;
      item.classList.toggle('active', active);
      item.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    document.dispatchEvent(
      new CustomEvent('proof-lens-focus', {
        detail: { id: button.dataset.proofLens },
      })
    );
  };

  lensButtons.forEach((button) => {
    button.addEventListener('pointerenter', () => setProofLens(button));
    button.addEventListener('focus', () => setProofLens(button));
    button.addEventListener('click', () => setProofLens(button));
  });

  if (canvas) {
    const [THREE, gsapModule] = await Promise.all([import('three'), gsapReady]);
    const { gsap } = gsapModule;
    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.6));
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 80);
    camera.position.set(0, 0.1, 8.4);
    const group = new THREE.Group();
    scene.add(group);

    const mint = new THREE.Color('#00e5a0');
    const blue = new THREE.Color('#7c8bff');
    const amber = new THREE.Color('#f4c84a');
    const ivory = new THREE.Color('#f4f1e8');
    const materials: THREE.Material[] = [];
    const geometries: THREE.BufferGeometry[] = [];
    const nodes: THREE.Mesh[] = [];
    const lines: THREE.Line[] = [];
    const focusState = {
      yaw: 0,
      pitch: -0.08,
      zoom: 8.1,
      particleOpacity: 0.82,
    };

    const points = {
      travelRisk: [0, 2.08, 0.1],
      quotation: [-2.35, 0.8, 0.05],
      maintenance: [2.15, 0.72, -0.08],
      infrastructure: [0, -1.75, 0.12],
      centre: [0, 0, 0],
    } as Record<string, [number, number, number]>;

    const focusMap = {
      'travel-risk': {
        node: 0,
        yaw: 0,
        pitch: -0.08,
        zoom: 8.1,
        particleOpacity: 0.82,
      },
      quotation: {
        node: 1,
        yaw: -0.18,
        pitch: -0.12,
        zoom: 8.1,
        particleOpacity: 0.74,
      },
      maintenance: {
        node: 2,
        yaw: 0.2,
        pitch: -0.18,
        zoom: 8.0,
        particleOpacity: 0.82,
      },
      infrastructure: {
        node: 3,
        yaw: 0.02,
        pitch: -0.32,
        zoom: 7.9,
        particleOpacity: 0.9,
      },
    } as const;

    const makeMaterial = (color: THREE.Color, opacity: number) => {
      const material = new THREE.MeshBasicMaterial({
        color,
        transparent: true,
        opacity,
        depthWrite: false,
      });
      materials.push(material);
      return material;
    };

    [
      points.travelRisk,
      points.quotation,
      points.maintenance,
      points.infrastructure,
      points.centre,
    ].forEach((point, index) => {
      const color =
        index === 0
          ? ivory
          : index === 1
            ? mint
            : index === 2
              ? amber
              : index === 3
                ? blue
                : ivory;
      const node = new THREE.Mesh(
        new THREE.SphereGeometry(index === 4 ? 0.11 : 0.09, 24, 24),
        makeMaterial(color, index === 4 ? 0.9 : 0.84)
      );
      node.position.set(...point);
      node.userData.focusScale = index === 0 ? 1.35 : index === 4 ? 1.1 : 0.95;
      group.add(node);
      nodes.push(node);

      const aura = new THREE.Mesh(
        new THREE.SphereGeometry(index === 4 ? 0.42 : 0.32, 24, 24),
        makeMaterial(color, index === 0 ? 0.13 : 0.07)
      );
      aura.position.set(...point);
      aura.userData.focusScale = index === 0 ? 1.2 : 0.9;
      group.add(aura);
      nodes.push(aura);
    });

    const createLine = (
      a: [number, number, number],
      b: [number, number, number],
      color: THREE.Color
    ) => {
      const geometry = new THREE.BufferGeometry().setFromPoints([
        new THREE.Vector3(...a),
        new THREE.Vector3(...b),
      ]);
      geometries.push(geometry);
      const material = new THREE.LineBasicMaterial({
        color,
        transparent: true,
        opacity: 0.24,
      });
      materials.push(material);
      const line = new THREE.Line(geometry, material);
      line.userData.focusOpacity = 0.24;
      group.add(line);
      lines.push(line);
    };
    createLine(points.centre, points.travelRisk, ivory);
    createLine(points.centre, points.quotation, mint);
    createLine(points.centre, points.maintenance, amber);
    createLine(points.centre, points.infrastructure, blue);
    createLine(points.quotation, points.maintenance, ivory);

    const particleCount = 700;
    const particlePositions = new Float32Array(particleCount * 3);
    const particleColors = new Float32Array(particleCount * 3);
    for (let i = 0; i < particleCount; i += 1) {
      const r = 0.5 + Math.random() * 3.3;
      const a = Math.random() * Math.PI * 2;
      particlePositions[i * 3] = Math.cos(a) * r;
      particlePositions[i * 3 + 1] = Math.sin(a) * r * 0.64;
      particlePositions[i * 3 + 2] = (Math.random() - 0.5) * 1.05;
      const color =
        i % 11 === 0 ? amber : i % 7 === 0 ? blue : i % 4 === 0 ? ivory : mint;
      particleColors[i * 3] = color.r;
      particleColors[i * 3 + 1] = color.g;
      particleColors[i * 3 + 2] = color.b;
    }
    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute(
      'position',
      new THREE.BufferAttribute(particlePositions, 3)
    );
    particleGeometry.setAttribute(
      'color',
      new THREE.BufferAttribute(particleColors, 3)
    );
    const particles = new THREE.Points(
      particleGeometry,
      new THREE.PointsMaterial({
        size: 0.023,
        vertexColors: true,
        transparent: true,
        opacity: 0.66,
        depthWrite: false,
      })
    );
    group.add(particles);

    const focusLens = (id: keyof typeof focusMap | string) => {
      const target =
        focusMap[id as keyof typeof focusMap] || focusMap['travel-risk'];
      gsap.to(focusState, {
        yaw: target.yaw,
        pitch: target.pitch,
        zoom: target.zoom,
        particleOpacity: target.particleOpacity,
        duration: reducedMotion ? 0 : 0.72,
        ease: 'power3.out',
      });
      nodes.forEach((node, index) => {
        const pair = Math.floor(index / 2);
        const active = pair === target.node;
        const centre = pair === 4;
        gsap.to(node.userData, {
          focusScale: active ? 1.45 : centre ? 1.08 : 0.92,
          duration: reducedMotion ? 0 : 0.45,
          ease: 'back.out(1.5)',
        });
      });
      lines.forEach((line, index) => {
        gsap.to(line.userData, {
          focusOpacity: index === target.node ? 0.56 : 0.2,
          duration: reducedMotion ? 0 : 0.38,
          ease: 'power2.out',
        });
      });
    };

    const onLens = (event: Event) => {
      const lensEvent = event as CustomEvent<{ id: keyof typeof focusMap }>;
      focusLens(lensEvent.detail.id);
    };
    document.addEventListener('proof-lens-focus', onLens as EventListener);
    focusLens('travel-risk');

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      renderer.setSize(
        Math.max(rect.width, 1),
        Math.max(rect.height, 1),
        false
      );
      camera.aspect = Math.max(rect.width, 1) / Math.max(rect.height, 1);
      camera.updateProjectionMatrix();
      group.scale.setScalar(window.innerWidth < 760 ? 0.76 : 1);
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    if (!reducedMotion) {
      gsap.from('[data-case-reveal]', {
        opacity: 0,
        y: 24,
        duration: 0.84,
        ease: 'power3.out',
        stagger: 0.12,
      });
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            gsap.to(entry.target, {
              opacity: 1,
              y: 0,
              duration: 0.66,
              ease: 'power3.out',
            });
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.18 }
      );
      document.querySelectorAll('[data-case-card]').forEach((element) => {
        gsap.set(element, { opacity: 0, y: 24 });
        observer.observe(element);
      });
    }

    const start = window.performance.now();
    let frame = 0;
    const render = () => {
      const t = (window.performance.now() - start) / 1000;
      if (!reducedMotion) {
        group.rotation.y += (focusState.yaw - group.rotation.y) * 0.025;
        group.rotation.x += (focusState.pitch - group.rotation.x) * 0.024;
        camera.position.z += (focusState.zoom - camera.position.z) * 0.035;
        particles.rotation.z -= 0.00065;
        (particles.material as THREE.PointsMaterial).opacity +=
          (focusState.particleOpacity -
            (particles.material as THREE.PointsMaterial).opacity) *
          0.04;
        nodes.forEach((node, index) => {
          node.scale.setScalar(
            (node.userData.focusScale ?? 1) +
              Math.sin(t * 1.55 + index * 0.4) * 0.045
          );
        });
        lines.forEach((line, index) => {
          const material = line.material as THREE.LineBasicMaterial;
          material.opacity =
            (line.userData.focusOpacity ?? 0.2) +
            Math.sin(t * 1.2 + index) * 0.024;
        });
      }
      renderer.render(scene, camera);
      frame = window.requestAnimationFrame(render);
    };
    render();

    document.addEventListener('astro:before-swap', () => {
      window.cancelAnimationFrame(frame);
      window.removeEventListener('resize', resize);
      document.removeEventListener('proof-lens-focus', onLens as EventListener);
      renderer.dispose();
      particleGeometry.dispose();
      geometries.forEach((geometry) => geometry.dispose());
      materials.forEach((material) => material.dispose());
    });
  }
</script>

<style>
  .case-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 16% 10%,
        rgba(5, 204, 144, 0.12),
        transparent 31rem
      ),
      radial-gradient(
        circle at 78% 18%,
        rgba(124, 139, 255, 0.1),
        transparent 30rem
      );
    color: var(--ma-text);
  }

  .case-hero {
    position: relative;
    min-height: 90vh;
    padding: 7.35rem 0 3.8rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid rgba(244, 241, 232, 0.1);
  }

  .case-grid {
    position: absolute;
    inset: 0;
    opacity: 0.13;
    background-image:
      linear-gradient(rgba(244, 241, 232, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 232, 0.035) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: radial-gradient(
      ellipse 78% 74% at 62% 46%,
      black,
      transparent 86%
    );
  }

  .case-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(420px, 0.78fr);
    gap: 3rem;
    align-items: center;
  }

  .case-copy h1 {
    max-width: 850px;
    margin-bottom: 1.3rem;
    color: #f4f1e8;
    font-size: clamp(2.95rem, 5vw, 4.7rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .case-copy p,
  .case-cta p {
    max-width: 690px;
    color: #d8d6ce;
    font-size: 1.1rem;
    line-height: 1.68;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .proof-console {
    position: relative;
    overflow: hidden;
    padding: 1.25rem;
    border: 1px solid rgba(244, 241, 232, 0.14);
    border-radius: var(--ma-radius);
    background:
      radial-gradient(
        circle at 48% 42%,
        rgba(5, 204, 144, 0.13),
        transparent 22rem
      ),
      linear-gradient(145deg, rgba(11, 16, 26, 0.86), rgba(4, 6, 9, 0.55));
    box-shadow: 0 34px 100px rgba(0, 0, 0, 0.32);
  }

  .proof-console-top,
  .proof-readout {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ma-text-dim);
    font-family: var(--ma-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .proof-console-top > span {
    color: var(--ma-mint);
  }

  .proof-visual {
    position: relative;
    min-height: 430px;
    margin: 0.45rem 0 0.9rem;
    overflow: hidden;
  }

  .proof-visual canvas {
    display: block;
    width: 100%;
    height: 430px;
  }

  .proof-label {
    position: absolute;
    z-index: 2;
    font-family: var(--ma-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .proof-label-travel {
    left: 50%;
    top: 12%;
    color: #f4f1e8;
    transform: translateX(-50%);
  }

  .proof-label-workflow {
    left: 12%;
    top: 28%;
    color: var(--ma-mint);
  }

  .proof-label-agent {
    right: 12%;
    top: 30%;
    color: #f4c84a;
  }

  .proof-label-search {
    left: 42%;
    bottom: 16%;
    color: #7c8bff;
  }

  .proof-readout {
    display: block;
    min-height: 56px;
    padding: 0.82rem;
    border: 1px solid rgba(244, 241, 232, 0.1);
    border-radius: var(--ma-radius);
    background: rgba(0, 0, 0, 0.36);
    color: #d8d6ce;
    line-height: 1.4;
  }

  .lens-section {
    padding-top: 2rem;
    padding-bottom: 2rem;
    background: rgba(11, 16, 26, 0.45);
    border-bottom: 1px solid var(--ma-border);
  }

  .lens-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .lens-button {
    display: grid;
    gap: 0.45rem;
    min-height: 118px;
    padding: 1rem;
    border: 1px solid rgba(244, 241, 232, 0.13);
    border-radius: var(--ma-radius);
    background: rgba(11, 16, 26, 0.78);
    color: #d8d6ce;
    cursor: pointer;
    text-align: left;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);

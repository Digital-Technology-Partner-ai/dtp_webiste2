// Homepage concept 1: Command Centre
// DTP homepage redesign exploration, AI readiness and leadership decision support.
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DTP homepage concept — Command Centre</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root{--bg:#050507;--panel:#111426;--panel2:#181b32;--text:#f2f2ee;--muted:#a8adbd;--dim:#676d7d;--mint:#05cc90;--line:rgba(5,204,144,.25);--line2:rgba(255,255,255,.1)}
    *{box-sizing:border-box} body{margin:0;background:radial-gradient(circle at 80% 10%,rgba(5,204,144,.16),transparent 32%),linear-gradient(180deg,#050507 0%,#090a10 56%,#050507 100%);color:var(--text);font-family:'IBM Plex Sans',system-ui,sans-serif;line-height:1.5} a{color:inherit;text-decoration:none}.mono{font-family:'IBM Plex Mono',monospace}.shell{max-width:1180px;margin:0 auto;padding:0 28px}.nav{position:sticky;top:0;z-index:3;background:rgba(5,5,7,.84);backdrop-filter:blur(18px);border-bottom:1px solid var(--line2)}.nav-inner{height:76px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;gap:12px;align-items:center;font-family:'Space Grotesk';font-weight:700}.brand-mark{width:32px;height:32px;border:1px solid var(--mint);display:grid;place-items:center;color:var(--mint)}.nav-links{display:flex;gap:24px;color:var(--muted);font-size:14px}.pill{border:1px solid var(--line);border-radius:999px;padding:9px 14px;color:var(--mint);background:rgba(5,204,144,.06)}
    .hero{min-height:780px;padding:92px 0 70px;position:relative;overflow:hidden}.hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:58px 58px;mask-image:linear-gradient(to bottom,black,transparent 82%)}.hero-grid{position:relative;display:grid;grid-template-columns:1.04fr .96fr;gap:48px;align-items:center}.kicker{color:var(--mint);font-family:'IBM Plex Mono';font-size:13px;letter-spacing:.08em;text-transform:uppercase}.hero h1{font-family:'Space Grotesk';font-size:clamp(54px,7.5vw,96px);line-height:.92;margin:18px 0 24px;letter-spacing:-.06em}.hero p.lead{font-size:22px;color:#c9ced8;max-width:650px;margin:0 0 32px}.actions{display:flex;gap:14px;flex-wrap:wrap}.btn{padding:15px 20px;border-radius:12px;border:1px solid var(--line2);font-weight:600}.btn.primary{background:var(--mint);color:#02130d;border-color:var(--mint)}.btn.secondary{background:rgba(255,255,255,.04)}.signal-board{background:linear-gradient(145deg,rgba(24,27,50,.94),rgba(11,13,25,.94));border:1px solid var(--line2);box-shadow:0 24px 90px rgba(0,0,0,.5);border-radius:28px;padding:24px;position:relative}.signal-board:after{content:"";position:absolute;inset:18px;border:1px solid rgba(5,204,144,.08);border-radius:20px;pointer-events:none}.board-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;color:var(--muted);font-size:13px}.status-dot{width:10px;height:10px;border-radius:50%;background:var(--mint);box-shadow:0 0 20px var(--mint)}.matrix{display:grid;gap:12px}.row{display:grid;grid-template-columns:120px 1fr 74px;gap:12px;align-items:center;padding:13px;border:1px solid rgba(255,255,255,.08);border-radius:14px;background:rgba(255,255,255,.035)}.bar{height:8px;border-radius:999px;background:#25283a;overflow:hidden}.bar span{display:block;height:100%;background:linear-gradient(90deg,var(--mint),rgba(5,204,144,.18))}.decision{margin-top:18px;padding:18px;border:1px solid var(--line);border-radius:18px;background:rgba(5,204,144,.055)}.decision strong{display:block;font-family:'Space Grotesk';font-size:22px;margin-bottom:6px}.section{padding:82px 0;border-top:1px solid var(--line2)}.section h2{font-family:'Space Grotesk';font-size:clamp(34px,4vw,58px);line-height:1;margin:10px 0 18px;letter-spacing:-.04em}.section-intro{max-width:720px;color:var(--muted);font-size:19px}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:34px}.card{background:rgba(17,20,38,.75);border:1px solid var(--line2);border-radius:22px;padding:24px;min-height:230px}.num{color:var(--mint);font-family:'IBM Plex Mono';font-size:13px}.card h3{font-family:'Space Grotesk';font-size:25px;margin:42px 0 12px}.card p{color:var(--muted);margin:0}.flow{display:grid;grid-template-columns:repeat(5,1fr);gap:0;margin-top:38px;border:1px solid var(--line2);border-radius:24px;overflow:hidden}.stage{padding:26px;min-height:180px;border-right:1px solid var(--line2);background:rgba(255,255,255,.025)}.stage:last-child{border-right:0}.stage span{font-family:'IBM Plex Mono';color:var(--mint);font-size:12px}.stage h3{font-family:'Space Grotesk';margin:18px 0 8px}.stage p{color:var(--muted);font-size:14px;margin:0}.cta{padding:90px 0 110px}.cta-box{border:1px solid var(--line);background:linear-gradient(135deg,rgba(5,204,144,.1),rgba(17,20,38,.8));border-radius:30px;padding:42px;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center}.cta h2{font-size:42px;margin:0 0 10px}.cta p{color:var(--muted);font-size:18px;margin:0}@media(max-width:900px){.hero-grid,.cta-box{grid-template-columns:1fr}.cards,.flow{grid-template-columns:1fr}.stage{border-right:0;border-bottom:1px solid var(--line2)}.nav-links{display:none}}
  </style>
</head>
<body>
  <nav class="nav"><div class="shell nav-inner"><a class="brand" href="/"><span class="brand-mark">D</span><span>Digital Technology Partner</span></a><div class="nav-links"><a href="#readiness">Readiness</a><a href="#work">Proof</a><a href="#process">Process</a><a class="pill" href="#conversation">Talk to us</a></div></div></nav>
  <main>
    <section class="hero"><div class="shell hero-grid"><div><div class="kicker">// AI leadership command centre</div><h1>Know where AI can help before you start building.</h1><p class="lead">We help leadership teams see what is really happening with AI inside the business, then turn the useful signals into practical pilots, safer systems and clearer decisions.</p><div class="actions"><a class="btn primary" href="#conversation">Start with an AI readiness conversation</a><a class="btn secondary" href="#process">See the route</a></div></div><div class="signal-board" aria-label="AI readiness command centre illustration"><div class="board-head"><span class="mono">readiness.scan / live</span><span class="status-dot"></span></div><div class="matrix"><div class="row"><span>Use cases</span><div class="bar"><span style="width:72%"></span></div><strong>Mapped</strong></div><div class="row"><span>Risk</span><div class="bar"><span style="width:46%"></span></div><strong>Visible</strong></div><div class="row"><span>Capability</span><div class="bar"><span style="width:58%"></span></div><strong>Uneven</strong></div><div class="row"><span>Data</span><div class="bar"><span style="width:38%"></span></div><strong>Patchy</strong></div></div><div class="decision"><strong>Leadership decision</strong><span>Encourage, control, investigate, stop, or build a focused proof of concept.</span></div></div></div></section>
    <section class="section" id="readiness"><div class="shell"><div class="kicker">// what we help with</div><h2>AI adoption is not mainly a tools problem.</h2><p class="section-intro">Most organisations already have experimentation. The harder question is whether leadership can see the value, risk, capability gaps and realistic next steps clearly enough to act.</p><div class="cards"><article class="card"><span class="num">01</span><h3>Readiness and adoption</h3><p>Find out where AI is already being used, where the pressure is building, and what needs leadership attention.</p></article><article class="card"><span class="num">02</span><h3>Proof of concept and MVP</h3><p>When the opportunity is clear enough, we build small working proofs that test real value before larger spend.</p></article><article class="card"><span class="num">03</span><h3>Operational systems</h3><p>We turn the useful work into repeatable systems, dashboards, agents and workflows that fit how teams actually operate.</p></article></div></div></section>
    <section class="section" id="process"><div class="shell"><div class="kicker">// route to value</div><h2>From uncertainty to evidence.</h2><div class="flow"><div class="stage"><span>01</span><h3>Snapshot</h3><p>Low-friction signal on where AI questions are emerging.</p></div><div class="stage"><span>02</span><h3>Diagnostic</h3><p>Evidence base leaders can trust before deciding what to do.</p></div><div class="stage"><span>03</span><h3>Advisory</h3><p>Interpretation, challenge and leadership playback.</p></div><div class="stage"><span>04</span><h3>Proof</h3><p>Build a narrow demonstrator where the case is strong enough.</p></div><div class="stage"><span>05</span><h3>Pilot</h3><p>Put the useful thing into controlled real use.</p></div></div></div></section>
    <section class="section" id="work"><div class="shell"><div class="kicker">// proof points</div><h2>We still build. We just refuse to build blindly.</h2><p class="section-intro">DTP works across AI readiness, operational automation, data flows, internal tools and MVP delivery. The point is not to admire AI. The point is to help the business make a better decision and then implement the parts worth implementing.</p></div></section>
    <section class="cta" id="conversation"><div class="shell"><div class="cta-box"><div><h2>Want a clearer view of AI adoption inside the business?</h2><p>Start with a short conversation. No hard sell, no fake maturity model, no magic robot theatre.</p></div><a class="btn primary" href="https://outlook.office.com/bookwithme/user/f0762b9af6a94ed2add9818a4f3ca4e5@digitaltechnologypartner.ai/meetingtype/qc2lOXjEdkO6GkMS_jZJrQ2?anonymous" target="_blank" rel="noopener noreferrer">Book a discovery call</a></div></div></section>
  </main>
</body>
</html>

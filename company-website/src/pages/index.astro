    <link rel="stylesheet" href="/route-depth-tunnel.css?v=20260614-all-equator" />
    <style>
      .ui-header .brand,
      .ui-header .brand:link,
      .ui-header .brand:visited,
      .ui-header .brand:hover,
      .ui-header .brand:active {
        display: inline-flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 14px !important;
        color: #f2f1ec !important;
        text-decoration: none !important;
      }

      .ui-header .brand img {
        display: block !important;
        height: 32px !important;
        width: auto !important;
      }

      .ui-header .brand-wordmark {
        display: block !important;
        color: #f2f1ec !important;
        font-family: "Space Grotesk", "Helvetica Neue", Arial, sans-serif !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        line-height: 1 !important;
        letter-spacing: 0.01em !important;
        text-decoration: none !important;
        transform: none !important;
        white-space: nowrap !important;
      }

      @media (max-width: 760px) {
        .ui-header .brand { gap: 10px !important; }
        .ui-header .brand img { height: 26px !important; }
        .ui-header .brand-wordmark { font-size: 11px !important; }
      }

      @media (hover: hover) and (pointer: fine) {
        body.gallery-cursor-ready,
        body.gallery-cursor-ready a,
        body.gallery-cursor-ready button,
        body.gallery-cursor-ready #scene,
        body.gallery-cursor-ready .ring-item {
          cursor: none !important;
        }

        .gallery-cursor,
        .gallery-cursor-ring {
          position: fixed;
          top: 0;
          left: 0;
          z-index: 99999;
          border-radius: 50%;
          pointer-events: none;
          opacity: 0;
          mix-blend-mode: difference;
        }

        .gallery-cursor {
          width: 6px;
          height: 6px;
          margin: -3px 0 0 -3px;
          background: #f2f1ec;
        }

        .gallery-cursor-ring {
          width: 34px;
          height: 34px;
          margin: -17px 0 0 -17px;
          border: 1px solid rgba(242, 241, 236, 0.5);
          transition:
            width 220ms ease,
            height 220ms ease,
            margin 220ms ease,
            border-color 220ms ease;
        }

        .gallery-cursor-ring.is-hover {
          width: 56px;
          height: 56px;
          margin: -28px 0 0 -28px;
          border-color: rgba(5, 204, 144, 0.9);
        }
      }
    </style>
    <script type="importmap">
      { "imports": { "three": "/ecosystem/libs/three.module.js" } }
    </script>
  </head>
  <body>
    <canvas id="scene"></canvas>

    <div class="vignette"></div>
    <div class="scanlines"></div>

    <header class="ui-header">
      <a class="brand" href="/" aria-label="Digital Technology Partner">
        <img src="/ecosystem/img/dtp-logo-white.png" alt="" />
        <span class="brand-wordmark">Digital Technology Partner</span>
      </a>
      <div class="header-right">

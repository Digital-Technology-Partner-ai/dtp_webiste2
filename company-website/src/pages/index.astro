const ringItems = [
  { label: 'HOME', id: 'home' },
  { label: 'WHY DTP', id: 'why-dtp' },
  { label: 'PROGRAMMES', id: 'programmes' },
  { label: 'SOLUTIONS', id: 'solutions' },
  { label: 'CASE STUDIES', id: 'case-studies' },
  { label: 'INSIGHTS', id: 'insights' },
  { label: 'CONTACT', id: 'contact' },
];

const ecosystemAssetVersion = '20260612-dtp-ecosystem-restore-4';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Explore Digital Technology Partner inside the original DTP Phantom Gallery ecosystem." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <title>Digital Technology Partner - Ecosystem</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`/ecosystem/css/style.css?v=${ecosystemAssetVersion}`} />
    <script type="importmap">
      { "imports": { "three": "/ecosystem/libs/three.module.js" } }
    </script>
  </head>
  <body>
    <canvas id="scene"></canvas>

    <div class="vignette"></div>
    <div class="scanlines"></div>

    <header class="ui-header">
      <a class="brand" href="/">
        <img src="/ecosystem/img/dtp-logo-white.png" alt="Digital Technology Partner" />
      </a>
      <div class="header-right">
        <span class="status-line"><i class="status-dot"></i>ECOSYSTEM&nbsp;ONLINE</span>
        <button class="menu-btn" id="menuBtn" aria-label="menu">
          <span>INDEX</span><i></i><i></i>
        </button>
      </div>
    </header>

    <div class="ui-footer">
      <p class="tagline">PEOPLE&nbsp;&middot;&nbsp;TECHNOLOGY&nbsp;&middot;&nbsp;DATA&nbsp;&middot;&nbsp;AI&nbsp;&middot;&nbsp;LEARNING<br />ONE&nbsp;CONNECTED&nbsp;ECOSYSTEM</p>
      <p class="hint"><span class="hint-dot"></span>DRAG TO EXPLORE</p>
    </div>

    <nav class="ring-nav" id="ringNav" aria-label="ecosystem navigation"></nav>

    <div class="node-panel" id="nodePanel">
      <span class="np-index"></span>
      <span class="np-title"></span>
      <span class="np-desc"></span>
      <span class="np-enter">ENTER &rsaquo;</span>
    </div>

    <div class="menu-overlay" id="menuOverlay">
      <div class="menu-head">
        <span class="menu-title">ECOSYSTEM INDEX</span>
        <button class="menu-close" id="menuClose">CLOSE &times;</button>
      </div>
      <ul class="menu-list" id="menuList"></ul>
    </div>

    <div class="loader" id="loader">
      <img class="loader-logo" src="/ecosystem/img/dtp-logo-white.png" alt="Digital Technology Partner" />
      <div class="loader-bar"><i id="loaderBar"></i></div>
      <span class="loader-status">INITIALISING ECOSYSTEM</span>
    </div>

    <script type="application/json" id="ecosystem-destinations" set:html={JSON.stringify(destinations)}></script>
    <script type="application/json" id="ecosystem-ring-items" set:html={JSON.stringify(ringItems)}></script>
    <script is:inline src="/ecosystem/libs/gsap.min.js"></script>
    <script is:inline type="module" src={`/ecosystem/js/main.js?v=${ecosystemAssetVersion}`}></script>
  </body>
</html>

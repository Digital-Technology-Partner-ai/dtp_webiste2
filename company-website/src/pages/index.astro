---
const destinations = [
  {
    id: 'home',
    title: 'HOME',
    route: '/home/',
    band: 'upper',
    desc: 'The landing narrative for AI that works.',
    intro: 'Digital Technology Partner helps leadership teams move from AI uncertainty to practical, governed systems that create measurable operational value.',
    blocks: [
      ['Connected ecosystem', 'Readiness, leadership confidence, practical solutions, delivery control and proof, mapped into one navigable experience.'],
      ['Practical AI', 'No theatre, no hype loop. We focus on systems that improve the work your organisation already needs to do.'],
      ['Clear next step', 'Start with the part of the ecosystem that matches your decision: assess, build, prove or talk.'],
    ],
  },
  {
    id: 'why-dtp',
    title: 'WHY DTP',
    route: '/why-dtp/',
    band: 'upper',
    desc: 'Risk, governance and delivery confidence.',
    intro: 'Why DTP exists, how we work, and why leaders use us as a practical partner for AI and digital systems.',
    blocks: [
      ['Trusted delivery', 'Clear ownership, senior involvement and practical governance from the first conversation.'],
      ['Business-first technology', 'We start with operational value and work backwards into the systems, data and adoption needed.'],
      ['Human-approved AI', 'AI systems are designed with controls, escalation and accountability built in.'],
    ],
  },
  {
    id: 'programmes',
    title: 'PROGRAMMES',
    route: '/programmes/',
    band: 'upper',
    desc: 'Assessment, foundry work and leadership coaching.',
    intro: 'Focused programmes for leaders who need to understand, prioritise and safely move AI from interest to action.',
    blocks: [
      ['AI Readiness', 'A fast, evidence-led view of where AI is helping, risky or blocked today.'],
      ['AI Foundry', 'A working group format for shaping high-value opportunities before build spend.'],
      ['Leadership AI', 'Private coaching for senior decision-makers navigating AI and technology change.'],
    ],
  },
  {
    id: 'solutions',
    title: 'SOLUTIONS',
    route: '/solutions/',
    band: 'upper',
    desc: 'Business systems, agents and automation.',
    intro: 'The practical systems DTP designs and builds: workflow automation, reporting, AI agents, bespoke AI and business applications.',
    blocks: [
      ['Operations automation', 'Remove manual steps, reduce errors and turn repeat work into controlled workflows.'],
      ['AI agents', 'Design human-approved agents that handle useful tasks inside real business constraints.'],
      ['Bespoke systems', 'Build the right digital layer around your processes, data and decision points.'],
    ],
  },
  {
    id: 'process',
    title: 'PROCESS',
    route: '/process/',
    band: 'upper',
    desc: 'How delivery stays controlled.',
    intro: 'A staged path from discovery to launch, with decision points that keep risk visible and investment controlled.',
    blocks: [
      ['Discovery', 'Understand the work, constraints, systems and value case before anything is built.'],
      ['PoC to pilot', 'Prove the risky assumptions early, then test in a controlled real-world environment.'],
      ['Launch', 'Move into production with support, monitoring and improvement rhythms.'],
    ],
  },
  {
    id: 'case-studies',
    title: 'CASE STUDIES',
    route: '/case-studies/',
    band: 'lower',
    desc: 'Evidence from real client outcomes.',
    intro: 'Proof from operations, manufacturing and technical systems where AI and digital delivery created practical value.',
    blocks: [
      ['Manufacturing', 'AI-assisted document and calculation workflows reduced quotation preparation time.'],
      ['Operations', 'Messaging-native maintenance coordination prevented missed production floor tasks.'],
      ['Infrastructure', 'Technical AI/ML delivery supported analytics, search and conversational interfaces.'],
    ],
  },
  {
    id: 'insights',
    title: 'INSIGHTS',
    route: '/insights/',
    band: 'lower',
    desc: 'Signal on AI adoption and implementation.',
    intro: 'Practical thinking on AI adoption, agents, governance and the conditions that make implementation work.',
    blocks: [
      ['Signal over noise', 'What matters in the current AI wave, and what is mostly distraction.'],
      ['Implementation lessons', 'Patterns from live work: where pilots fail, where governance helps, and how teams adopt.'],
      ['Leadership context', 'A sharper view for decision-makers shaping technology investment.'],
    ],
  },
  {
    id: 'ai-readiness',
    title: 'AI READINESS',
    route: '/programmes/ai-adoption-readiness/',
    band: 'lower',
    desc: 'A one-week adoption and risk view.',
    intro: 'A focused sprint to understand current AI use, adoption risk, opportunity and the next sensible leadership decisions.',
    blocks: [
      ['Current state', 'Map how AI is already being used across the organisation.'],
      ['Risk and readiness', 'Separate unmanaged risk from genuine opportunity.'],
      ['Action plan', 'Leave with a practical decision path rather than another generic AI deck.'],
    ],
  },
  {
    id: 'ai-foundry',
    title: 'AI FOUNDRY',
    route: '/programmes/ai-foundry/',
    band: 'lower',
    desc: 'Opportunity discovery with working groups.',
    intro: 'A practical format for teams that need to turn scattered AI ideas into evidence-led, prioritised work.',
    blocks: [
      ['Discover', 'Surface useful opportunities from real operational pain points.'],
      ['Shape', 'Clarify data, workflow, adoption and governance requirements.'],
      ['Prioritise', 'Decide what has earned a prototype, pilot or stop decision.'],
    ],
  },
  {
    id: 'leadership-ai',
    title: 'LEADERSHIP AI',
    route: '/programmes/leadership-ai-coaching/',
    band: 'lower',
    desc: 'Private AI support for senior leaders.',
    intro: 'Discreet coaching for decision-makers who need confidence, language and judgement around AI and digital change.',
    blocks: [
      ['Fluency', 'Understand the concepts without being buried in vendor noise.'],
      ['Judgement', 'Know what questions to ask before approving AI investment.'],
      ['Confidence', 'Use AI personally and strategically with more control.'],
    ],

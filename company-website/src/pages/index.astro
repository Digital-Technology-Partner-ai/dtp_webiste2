  {
    id: 'contact',
    title: 'CONTACT',
    route: '/contact/',
    band: 'lower',
    desc: 'Start the conversation.',
    intro: 'Book a call or route your enquiry by the decision you need to make.',
    blocks: [
      ['Discovery call', 'Bring a problem, an ambition or a half-formed idea.'],
      ['Fit check', 'We will be direct about whether DTP is the right partner.'],
      ['Next route', 'Leave with a clear suggested path through the ecosystem.'],
    ],
  },

---
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

const trustSignals = [
  {
    label: 'Pillar 1',
    title: 'Business first',
    text: "We start with the work, not the tool. The useful question is rarely which model; it's where decisions are weak, where workflow drag lives, and where a system would create measurable value.",
  },
  {
    label: 'Pillar 2',
    title: 'Controlled delivery',
    text: 'Small commitments before large ones. Evidence before scale. Discovery, PoC, MVP, Pilot and Launch mean nobody bets the programme on a beautiful promise.',
  },
  {
    label: 'Pillar 3',
    title: 'Governance aware',
    text: 'Permissions, data boundaries, review points and human oversight are design inputs, not paperwork added at the end.',
  },
  {
    label: 'Pillar 4',
    title: 'Technical translation',
    text: 'We speak board, and we speak build, so what leadership intends is what actually ships.',
  },
];

const operatingModel = [
  {
    code: '1',
    title: 'See the operating reality',
    text: 'Map current work, data, tools, adoption signals and the decision leadership actually needs to make.',
  },
  {
    code: '2',
    title: 'Choose the narrowest useful route',
    text: 'Small enough to prove, meaningful enough to change a real workflow.',
  },
  {
    code: '3',
    title: 'Build with controls visible',
    text: 'Permissions, reviews, audit trails and support responsibilities on the table before the system goes live.',
  },
  {
    code: '4',
    title: 'Measure what changed',
    text: 'Reduced effort, faster decisions, fewer missed tasks, safer adoption.',
  },
];

const proofPoints = [
  {
    title: '40% faster quotation preparation',
    text: 'AI-assisted document and calculation workflows in manufacturing operations.',
  },
  {
    title: 'Zero missed maintenance tasks',
    text: 'a messaging-native agent coordinating production-floor work.',
  },
  {
    title: 'Controlled technical delivery',
    text: 'AI/ML architecture, vector search and conversational systems in production.',
  },
];

const checklistItems = [
  {
    question: '"What\'s the smallest commitment you\'ll accept?"',
    answer: 'Ours is a one-week readiness review.',
    href: '/programmes/ai-adoption-readiness/',
  },
  {
    question: '"What happens if the proof of concept fails?"',
    answer: "It ends there, with the evidence. That's what the gate is for.",
  },
  {
    question: '"Who owns the pilot, and what\'s the number?"',
    answer: 'No build starts without a named owner and a measurable target.',
  },
  {
    question: '"Where does our data live, and who can see it?"',
    answer:
      'Boundaries, permissions and audit are designed in from day one, in-tenant where it matters.',
  },
  {
    question: '"Show us something running."',
    answer: 'Live systems in real operations.',
    href: '/case-studies/',
  },
  {
    question: '"Who actually does the work?"',
    answer: 'The people you meet. No leveraged pyramid.',
  },
];

const trustModes = [
  { id: 'workflow', label: 'Workflow', value: 'where work actually happens' },
  {
    id: 'governance',
    label: 'Governance',
    value: 'where permission and risk are controlled',
  },
  {
    id: 'delivery',
    label: 'Delivery',
    value: 'where evidence earns the next gate',
  },
];
---

<Layout
  title="Why DTP: Good AI delivery feels calm. That's not an accident."
  description="Why leadership teams choose Digital Technology Partner: stage-gated delivery, governance designed in, and six questions to ask any AI partner, including us."
>
  <Header />
  <main class="why-page">
    <section class="why-hero" aria-labelledby="why-title">
      <canvas id="trust-field-scene" class="trust-field" aria-hidden="true"
      ></canvas>
      <div class="why-grid"></div>
      <div class="ma-container why-hero-inner">
        <div class="why-copy" data-why-reveal>
          <span class="ma-section-tag">// the_feeling</span>
          <h1 id="why-title">
            Good AI delivery feels calm. That's not an accident.
          </h1>
          <p>
            Calm is what it sounds like when the complexity is being held:
            workflow, governance, data and delivery managed as one controlled
            system. DTP exists to hold it.
          </p>
          <div class="why-actions">
            <a class="ma-btn ma-btn-mint" href="/contact/">
              Talk through your situation
            </a>
            <a class="ma-btn ma-btn-outline" href="/process/"
              >See how delivery is controlled</a
            >
          </div>
        </div>

        <aside
          class="trust-console st-brackets"
          aria-label="DTP trust model"
          data-why-reveal
        >
          <div class="trust-console-top">
            <span>trust model</span>
            <strong>Clarity → Control → Useful systems</strong>
          </div>
          <div class="trust-console-core">
            {
              trustModes.map((mode) => (
                <button
                  type="button"
                  data-trust-mode={mode.id}
                  data-trust-value={mode.value}
                  aria-pressed={mode.id === 'workflow' ? 'true' : 'false'}
                  class:list={[
                    'trust-mode',
                    { active: mode.id === 'workflow' },
                  ]}
                >
                  <span>{mode.label}</span>
                  <strong>{mode.value}</strong>
                </button>
              ))
            }
          </div>
          <div class="trust-readout" aria-live="polite">
            <span>current focus</span>
            <strong id="trust-readout-value">where work actually happens</strong
            >
          </div>
        </aside>
      </div>
    </section>

    <section class="ma-section trust-signal-section">
      <div class="ma-container trust-signal-grid">
        <div class="trust-section-copy" data-why-reveal>
          <span class="ma-section-tag">// what_the_calm_is_made_of</span>
          <h2>What the calm is made of.</h2>
        </div>
        <div class="trust-signal-stack">
          {
            trustSignals.map((signal) => (
              <article class="trust-signal-card" data-why-card>
                <span>{signal.label}</span>
                <h3>{signal.title}</h3>
                <p>{signal.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ma-section failure-section">
      <div class="st-backdrop st-backdrop--band" aria-hidden="true">
        <img
          src="/images/studio/synapse-2400.webp"
          srcset="/images/studio/synapse-1280.webp 1280w, /images/studio/synapse-2400.webp 2400w"
          sizes="100vw"
          alt=""
          loading="lazy"
        />
      </div>
      <div class="ma-container failure-inner" data-why-reveal>
        <span class="ma-section-tag">// designed_against_failure</span>
        <h2>Most AI projects don't fail loudly. They dissolve.</h2>
        <p>
          The pilot that never had an owner or a number. The licences that
          quietly became an expensive search box. The compliance freeze that
          locked the best tools out while quieter rivals shipped. We've seen the
          autopsies, so every DTP engagement is designed against them: every
          build has a named owner and a measurable target, every rollout starts
          with the workflow rather than the licence, and governance is
          architected in so security can say yes safely instead of no
          permanently.
        </p>
      </div>
    </section>

    <section class="ma-section operating-section">
      <div class="ma-container">
        <div class="operating-head" data-why-reveal>
          <span class="ma-section-tag">// the_method</span>
          <h2>
            Deliberately stage-gated, so each stage makes the next decision
            easier.
          </h2>
        </div>
        <div class="operating-path" aria-label="DTP operating model">
          {
            operatingModel.map((item) => (
              <article data-why-card>
                <span>{item.code}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
        <p class="operating-outro">
          Any stage can end the work honourably. That is a feature, not a
          failure.
        </p>
      </div>
    </section>

    <section class="ma-section checklist-section">
      <div class="ma-container">
        <div class="checklist-head" data-why-reveal>
          <span class="ma-section-tag"
            >// six_questions_to_ask_any_ai_partner</span
          >
          <h2>Six questions to ask any AI partner. Including us.</h2>
        </div>
        <div class="checklist-grid">
          {
            checklistItems.map((item, index) => (
              <article class="checklist-card" data-why-card>
                <span>{index + 1}</span>
                <h3>{item.question}</h3>
                <p>
                  {item.answer}
                  {item.href && (
                    <>
                      {' '}
                      <a href={item.href}>→</a>
                    </>
                  )}
                </p>
              </article>
            ))
          }
        </div>
        <p class="checklist-outro" data-why-reveal>
          Ask all six of everyone you're considering. The answers tell you more
          than any deck.
        </p>
      </div>
    </section>

    <section class="ma-section proof-band">
      <div class="ma-container proof-band-grid">
        <div data-why-reveal>
          <span class="ma-section-tag">// proof_layer</span>
          <h2>Proof belongs near the point of doubt.</h2>
        </div>
        <div class="proof-lines">
          {
            proofPoints.map((point) => (
              <p data-why-card>
                <strong>{point.title}</strong>: {point.text}
              </p>
            ))
          }
          <a class="proof-link" href="/case-studies/">See the case studies</a>
        </div>
      </div>
    </section>

    <section class="ma-section founder-section">
      <div class="ma-container founder-inner" data-why-reveal>
        <span class="ma-section-tag">// a_note_from_the_founder</span>
        <h2>Why this firm exists.</h2>
        <p>
          I've spent the lots of time talking with CEOs and leadership across
          the piece about AI. The same conversation kept repeating: smart
          leaders, real pressure, no map. The technology has stopped being the
          hard part: people, change and culture are. DTP is built for that part:
          the unglamorous work of making AI operational, governed and worth the
          money.
        </p>
        <strong>Steve Shearman, Founder, Digital Technology Partner</strong>
      </div>
    </section>

    <section class="why-cta">
      <div class="ma-container why-cta-inner" data-why-reveal>
        <span class="ma-section-tag">// start_with_the_right_question</span>
        <h2>
          Bring the uncertainty. We'll help turn it into a controlled next step.
        </h2>
        <div class="why-actions">
          <a class="ma-btn ma-btn-mint ma-btn-lg" href="/contact/">
            Talk through your situation
          </a>
          <a
            class="ma-btn ma-btn-outline ma-btn-lg"
            href="/programmes/ai-adoption-readiness/"
          >
            Start with Readiness
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;
  const canvas = document.getElementById(
    'trust-field-scene'
  ) as HTMLCanvasElement | null;
  const gsapReady = import('gsap');
  const trustButtons = Array.from(
    document.querySelectorAll('[data-trust-mode]')
  ) as HTMLButtonElement[];
  const readout = document.getElementById('trust-readout-value');

  const setTrustMode = async (button: HTMLButtonElement) => {
    trustButtons.forEach((item) => {
      const active = item === button;
      item.classList.toggle('active', active);
      item.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    if (readout) {
      if (reducedMotion) {
        readout.textContent = button.dataset.trustValue || '';
      } else {
        const { gsap } = await gsapReady;
        gsap.to(readout, {
          opacity: 0,
          y: 6,
          duration: 0.14,
          ease: 'power2.out',
          onComplete: () => {
            readout.textContent = button.dataset.trustValue || '';
            gsap.to(readout, {
              opacity: 1,
              y: 0,
              duration: 0.26,
              ease: 'power3.out',
            });
          },
        });
      }
    }

    document.dispatchEvent(
      new CustomEvent('trust-field-mode', {
        detail: { id: button.dataset.trustMode },
      })
    );
  };

  trustButtons.forEach((button) => {
    button.addEventListener('pointerenter', () => void setTrustMode(button));
    button.addEventListener('focus', () => void setTrustMode(button));
    button.addEventListener('click', () => void setTrustMode(button));
  });

  if (canvas) {
    const [THREE, gsapModule] = await Promise.all([import('three'), gsapReady]);
    const { gsap } = gsapModule;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.6));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 80);
    camera.position.set(0, 0.08, 8.6);

    const group = new THREE.Group();
    scene.add(group);

    const mint = new THREE.Color('#00e5a0');
    const blue = new THREE.Color('#7c8bff');
    const ivory = new THREE.Color('#f4f1e8');
    const amber = new THREE.Color('#f4c84a');
    const materials: THREE.Material[] = [];
    const nodeMeshes: THREE.Mesh[] = [];
    const lines: THREE.Line[] = [];
    const focusState = { yaw: -0.12, pitch: -0.2, zoom: 8.6, intensity: 0.72 };

    const positions = [
      [0, 0, 0],
      [-2.9, 1.05, 0.16],
      [2.55, 1.28, -0.12],
      [-2.1, -1.42, 0.2],
      [2.35, -1.15, 0.16],
      [0.1, 2.22, -0.24],
      [0, -2.4, -0.12],
    ] as Array<[number, number, number]>;

    const modeTargets = {
      workflow: {
        node: 1,
        yaw: -0.18,
        pitch: -0.16,
        zoom: 8.35,
        intensity: 0.78,
      },
      governance: {
        node: 4,
        yaw: 0.2,
        pitch: -0.28,
        zoom: 8.05,
        intensity: 0.88,
      },
      delivery: {
        node: 5,
        yaw: 0.02,
        pitch: -0.08,
        zoom: 8.15,
        intensity: 0.94,
      },
    } as const;

    const createNodeMaterial = (color: THREE.Color, opacity: number) => {
      const material = new THREE.MeshBasicMaterial({
        color,
        transparent: true,
        opacity,
        depthWrite: false,
      });
      materials.push(material);
      return material;
    };

    positions.forEach((position, index) => {
      const color =
        index === 0
          ? mint
          : index % 3 === 0
            ? amber
            : index % 2 === 0
              ? blue
              : ivory;
      const core = new THREE.Mesh(
        new THREE.SphereGeometry(index === 0 ? 0.13 : 0.075, 24, 24),
        createNodeMaterial(color, index === 0 ? 1 : 0.86)
      );
      core.position.set(...position);
      core.userData.focusScale = index === 0 ? 1.2 : 1;
      group.add(core);
      nodeMeshes.push(core);

      const aura = new THREE.Mesh(
        new THREE.SphereGeometry(index === 0 ? 0.54 : 0.34, 24, 24),
        createNodeMaterial(color, index === 0 ? 0.12 : 0.07)
      );
      aura.position.set(...position);
      aura.userData.focusScale = index === 0 ? 1.05 : 0.9;
      group.add(aura);
      nodeMeshes.push(aura);
    });

    const createLine = (
      a: [number, number, number],
      b: [number, number, number],
      color = mint
    ) => {
      const material = new THREE.LineBasicMaterial({
        color,
        transparent: true,
        opacity: 0.18,
      });
      materials.push(material);
      const line = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(...a),
          new THREE.Vector3(...b),
        ]),
        material
      );
      line.userData.focusOpacity = 0.18;
      group.add(line);
      lines.push(line);
      return line.geometry;
    };

    const geometries: THREE.BufferGeometry[] = [];
    positions.slice(1).forEach((position, index) => {
      geometries.push(
        createLine(positions[0], position, index % 2 === 0 ? mint : ivory)
      );
    });
    geometries.push(createLine(positions[1], positions[4], blue));
    geometries.push(createLine(positions[2], positions[3], amber));
    geometries.push(createLine(positions[5], positions[6], mint));

    const particleCount = 860;
    const particlePositions = new Float32Array(particleCount * 3);
    const particleColors = new Float32Array(particleCount * 3);
    for (let i = 0; i < particleCount; i += 1) {
      const r = 0.8 + Math.random() * 3.8;
      const a = Math.random() * Math.PI * 2;
      const z = (Math.random() - 0.5) * 1.3;
      particlePositions[i * 3] = Math.cos(a) * r;
      particlePositions[i * 3 + 1] = Math.sin(a) * r * 0.64;
      particlePositions[i * 3 + 2] = z;

      const color =
        i % 13 === 0 ? amber : i % 7 === 0 ? blue : i % 5 === 0 ? ivory : mint;
      particleColors[i * 3] = color.r;
      particleColors[i * 3 + 1] = color.g;
      particleColors[i * 3 + 2] = color.b;
    }

    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute(
      'position',
      new THREE.BufferAttribute(particlePositions, 3)
    );
    particleGeometry.setAttribute(
      'color',
      new THREE.BufferAttribute(particleColors, 3)
    );
    const particles = new THREE.Points(
      particleGeometry,
      new THREE.PointsMaterial({
        size: 0.021,
        vertexColors: true,
        transparent: true,
        opacity: 0.66,
        depthWrite: false,
      })
    );
    group.add(particles);

    const rings = [1.25, 2.25, 3.25].map((radius, index) => {
      const material = new THREE.MeshBasicMaterial({
        color: index === 1 ? blue : mint,
        transparent: true,
        opacity: index === 1 ? 0.08 : 0.12,
        side: THREE.DoubleSide,
        depthWrite: false,
      });
      materials.push(material);
      const ring = new THREE.Mesh(
        new THREE.TorusGeometry(radius, 0.007, 12, 180),
        material
      );
      ring.rotation.x = Math.PI / 2 + index * 0.18;
      ring.rotation.y = index * 0.22;
      group.add(ring);
      return ring;
    });

    const focusField = (id: keyof typeof modeTargets | string) => {
      const target =
        modeTargets[id as keyof typeof modeTargets] || modeTargets.workflow;
      gsap.to(focusState, {
        yaw: target.yaw,
        pitch: target.pitch,
        zoom: target.zoom,
        intensity: target.intensity,
        duration: reducedMotion ? 0 : 0.72,
        ease: 'power3.out',
      });

      nodeMeshes.forEach((node, index) => {
        const pairIndex = Math.floor(index / 2);
        const isCore = pairIndex === 0;
        const isTarget = pairIndex === target.node;
        gsap.to(node.userData, {
          focusScale: isTarget ? 1.52 : isCore ? 1.18 : 0.94,
          duration: reducedMotion ? 0 : 0.48,
          ease: 'back.out(1.5)',
        });
      });

      lines.forEach((line, index) => {
        gsap.to(line.userData, {
          focusOpacity:
            index === target.node - 1 ? 0.54 : index < 6 ? 0.2 : 0.13,
          duration: reducedMotion ? 0 : 0.4,
          ease: 'power2.out',
        });
      });
    };

    const onMode = (event: Event) => {
      const modeEvent = event as CustomEvent<{ id: keyof typeof modeTargets }>;
      focusField(modeEvent.detail.id);
    };
    document.addEventListener('trust-field-mode', onMode as EventListener);
    focusField('workflow');

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const width = Math.max(rect.width, 1);
      const height = Math.max(rect.height, 1);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      group.scale.setScalar(window.innerWidth < 760 ? 0.7 : 1);
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    const pointer = { x: 0, y: 0 };
    const onPointerMove = (event: PointerEvent) => {
      pointer.x = (event.clientX / window.innerWidth - 0.5) * 0.16;
      pointer.y = (event.clientY / window.innerHeight - 0.5) * 0.12;
    };
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    if (!reducedMotion) {
      gsap.from('[data-why-reveal]', {
        opacity: 0,
        y: 24,
        duration: 0.84,
        ease: 'power3.out',
        stagger: 0.12,
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            gsap.to(entry.target, {
              opacity: 1,
              y: 0,
              duration: 0.66,
              ease: 'power3.out',
            });
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.18 }
      );

      document.querySelectorAll('[data-why-card]').forEach((element) => {
        gsap.set(element, { opacity: 0, y: 24 });
        observer.observe(element);
      });
    }

    const start = window.performance.now();
    let frame = 0;
    const render = () => {
      const t = (window.performance.now() - start) / 1000;
      if (!reducedMotion) {
        group.rotation.y +=
          (focusState.yaw + pointer.x - group.rotation.y) * 0.025;
        group.rotation.x +=
          (focusState.pitch + pointer.y - group.rotation.x) * 0.024;
        camera.position.z += (focusState.zoom - camera.position.z) * 0.035;
        particles.rotation.z -= 0.00065;
        particles.rotation.y += 0.00038;
        (particles.material as THREE.PointsMaterial).opacity +=
          (focusState.intensity -
            (particles.material as THREE.PointsMaterial).opacity) *
          0.035;
        rings.forEach((ring, index) => {
          ring.rotation.z = t * (0.045 + index * 0.018);
        });
        nodeMeshes.forEach((node, index) => {
          const pulse = Math.sin(t * 1.55 + index * 0.42) * 0.045;
          node.scale.setScalar((node.userData.focusScale ?? 1) + pulse);
        });
        lines.forEach((line, index) => {
          const material = line.material as THREE.LineBasicMaterial;
          material.opacity =
            (line.userData.focusOpacity ?? 0.18) +
            Math.sin(t * 1.2 + index) * 0.025;
        });
      }
      renderer.render(scene, camera);
      frame = window.requestAnimationFrame(render);
    };
    render();

    document.addEventListener('astro:before-swap', () => {
      window.cancelAnimationFrame(frame);
      window.removeEventListener('resize', resize);
      window.removeEventListener('pointermove', onPointerMove);
      document.removeEventListener('trust-field-mode', onMode as EventListener);
      renderer.dispose();
      geometries.forEach((geometry) => geometry.dispose());
      particleGeometry.dispose();
      materials.forEach((material) => material.dispose());
    });
  }
</script>

<style>
  .why-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 18% 14%,
        rgba(5, 204, 144, 0.1),
        transparent 30rem
      ),
      radial-gradient(
        circle at 82% 18%,
        rgba(124, 139, 255, 0.07),
        transparent 30rem
      );
    color: var(--ma-text);
  }

  .why-hero {
    position: relative;
    min-height: 92vh;
    padding: 7.5rem 0 4rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid rgba(244, 241, 232, 0.1);
  }

  .trust-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.82;
  }

  .why-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.12;
    background-image:
      linear-gradient(rgba(244, 241, 232, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 232, 0.04) 1px, transparent 1px);
    background-size: 74px 74px;
    mask-image: radial-gradient(
      ellipse 78% 70% at 62% 45%,
      black,
      transparent 86%
    );
  }

  .why-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;

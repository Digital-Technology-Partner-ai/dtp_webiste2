---
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

const bookingUrl =
  'https://outlook.office.com/bookwithme/user/f0762b9af6a94ed2add9818a4f3ca4e5@digitaltechnologypartner.ai/meetingtype/qc2lOXjEdkO6GkMS_jZJrQ2?anonymous';

const trustSignals = [
  {
    label: 'Business first',
    title: 'We start with the work, not the tool.',
    text: 'The useful question is rarely which AI model to use. It is where decisions are weak, where workflow drag lives and where a system would create measurable value.',
  },
  {
    label: 'Controlled delivery',
    title: 'Small commitments before large ones.',
    text: 'Discovery, PoC, MVP, Pilot and Launch create evidence before scale, so leaders do not need to bet the full programme on a beautiful promise.',
  },
  {
    label: 'Governance aware',
    title: 'Risk is designed into the route.',
    text: 'Permissions, data boundaries, review points, escalation paths and human oversight are treated as core design inputs from the start.',
  },
  {
    label: 'Technical translation',
    title: 'Senior judgement without theatre.',
    text: 'DTP connects board-level intent to practical architecture, workflow detail and the reality of building with people, data and systems already in place.',
  },
];

const operatingModel = [
  {
    code: '01',
    title: 'See the operating reality',
    text: 'Map current work, data, tools, adoption signals, blockers and the decision leadership needs to make.',
  },
  {
    code: '02',
    title: 'Choose the narrowest useful route',
    text: 'Shape a first step that is small enough to prove, but meaningful enough to change a real workflow.',
  },
  {
    code: '03',
    title: 'Build with controls visible',
    text: 'Make permissions, reviews, audit trails and support responsibilities visible before the system becomes operational.',
  },
  {
    code: '04',
    title: 'Measure what changed',
    text: 'Focus on reduced effort, faster decisions, fewer missed tasks, better visibility and safer adoption.',
  },
];

const proofPoints = [
  'AI-assisted quotation and document workflows can reduce effort around technical preparation work.',
  'Messaging-native operational agents can keep production floor tasks visible and accountable.',
  'Custom AI and search systems can be shaped around security, context and practical use rather than generic demos.',
];

const trustModes = [
  { id: 'workflow', label: 'Workflow', value: 'where work actually happens' },
  { id: 'governance', label: 'Governance', value: 'where permission and risk are controlled' },
  { id: 'delivery', label: 'Delivery', value: 'where evidence earns the next gate' },
];
---

<Layout
  title="Why DTP - Digital Technology Partner"
  description="Why Digital Technology Partner is a practical, low-risk partner for AI adoption, business automation and digital systems delivery."
>
  <Header />
  <main class="why-page">
    <section class="why-hero" aria-labelledby="why-title">
      <canvas id="trust-field-scene" class="trust-field" aria-hidden="true"></canvas>
      <div class="why-grid"></div>
      <div class="ma-container why-hero-inner">
        <div class="why-copy" data-why-reveal>
          <span class="ma-section-tag">// command_centre</span>
          <h1 id="why-title">Practical AI and digital systems, delivered with control.</h1>
          <p>
            DTP helps leaders move from AI noise to governed, useful implementation. We
            connect business work, people, data and systems so technology earns its place.
          </p>
          <div class="why-actions">
            <a class="ma-btn ma-btn-mint" href={bookingUrl} target="_blank" rel="noopener noreferrer">
              Talk through your situation
            </a>
            <a class="ma-btn ma-btn-outline" href="/process/">See how delivery is controlled</a>
          </div>
        </div>

        <aside class="trust-console" aria-label="DTP trust model" data-why-reveal>
          <div class="trust-console-top">
            <span>trust model</span>
            <strong>Clarity -> Control -> Useful systems</strong>
          </div>
          <div class="trust-console-core">
            {trustModes.map((mode) => (
              <button
                type="button"
                data-trust-mode={mode.id}
                data-trust-value={mode.value}
                aria-pressed={mode.id === 'workflow' ? 'true' : 'false'}
                class:list={['trust-mode', { active: mode.id === 'workflow' }]}
              >
                <span>{mode.label}</span>
                <strong>{mode.value}</strong>
              </button>
            ))}
          </div>
          <div class="trust-readout" aria-live="polite">
            <span>current focus</span>
            <strong id="trust-readout-value">where work actually happens</strong>
          </div>
        </aside>
      </div>
    </section>

    <section class="ma-section trust-signal-section">
      <div class="ma-container trust-signal-grid">
        <div class="trust-section-copy" data-why-reveal>
          <span class="ma-section-tag">// why_organisations_choose_dtp</span>
          <h2>Good AI delivery feels calm because the complexity is being held.</h2>
        </div>
        <div class="trust-signal-stack">
          {trustSignals.map((signal) => (
            <article class="trust-signal-card" data-why-card>
              <span>{signal.label}</span>
              <h3>{signal.title}</h3>
              <p>{signal.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ma-section operating-section">
      <div class="ma-container">
        <div class="operating-head" data-why-reveal>
          <span class="ma-section-tag">// operating_model</span>
          <h2>The DTP method is deliberately stage-gated.</h2>
          <p>
            Each stage should make the next decision easier. That means fewer vague promises,
            fewer stranded pilots and a clearer route from intent to operational value.
          </p>
        </div>
        <div class="operating-path" aria-label="DTP operating model">
          {operatingModel.map((item) => (
            <article data-why-card>
              <span>{item.code}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ma-section proof-band">
      <div class="ma-container proof-band-grid">
        <div data-why-reveal>
          <span class="ma-section-tag">// practical_evidence</span>
          <h2>Proof belongs near the point of doubt.</h2>
          <p>
            The buying question is not whether AI can look impressive. It is whether useful
            systems can be delivered safely around real operations.
          </p>
        </div>
        <div class="proof-lines">
          {proofPoints.map((point) => (
            <p data-why-card>{point}</p>
          ))}
        </div>
      </div>
    </section>

    <section class="why-cta">
      <div class="ma-container why-cta-inner" data-why-reveal>
        <span class="ma-section-tag">// start_with_the_right_question</span>
        <h2>Bring the uncertainty. We will help turn it into a controlled next step.</h2>
        <div class="why-actions">
          <a class="ma-btn ma-btn-mint ma-btn-lg" href={bookingUrl} target="_blank" rel="noopener noreferrer">
            Talk through your situation
          </a>
          <a class="ma-btn ma-btn-outline ma-btn-lg" href="/programmes/ai-adoption-readiness/">
            Start with readiness
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.getElementById('trust-field-scene') as HTMLCanvasElement | null;
  const gsapReady = import('gsap');
  const trustButtons = Array.from(document.querySelectorAll('[data-trust-mode]')) as HTMLButtonElement[];
  const readout = document.getElementById('trust-readout-value');

  const setTrustMode = async (button: HTMLButtonElement) => {
    trustButtons.forEach((item) => {
      const active = item === button;
      item.classList.toggle('active', active);
      item.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    if (readout) {
      if (reducedMotion) {
        readout.textContent = button.dataset.trustValue || '';
      } else {
        const { gsap } = await gsapReady;
        gsap.to(readout, {
          opacity: 0,
          y: 6,
          duration: 0.14,
          ease: 'power2.out',
          onComplete: () => {
            readout.textContent = button.dataset.trustValue || '';
            gsap.to(readout, { opacity: 1, y: 0, duration: 0.26, ease: 'power3.out' });
          },
        });
      }
    }

    document.dispatchEvent(new CustomEvent('trust-field-mode', { detail: { id: button.dataset.trustMode } }));
  };

  trustButtons.forEach((button) => {
    button.addEventListener('pointerenter', () => void setTrustMode(button));
    button.addEventListener('focus', () => void setTrustMode(button));
    button.addEventListener('click', () => void setTrustMode(button));
  });

  if (canvas) {
    const [THREE, gsapModule] = await Promise.all([import('three'), gsapReady]);
    const { gsap } = gsapModule;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.6));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 80);
    camera.position.set(0, 0.08, 8.6);

    const group = new THREE.Group();
    scene.add(group);

    const mint = new THREE.Color('#00e5a0');
    const blue = new THREE.Color('#7c8bff');
    const ivory = new THREE.Color('#f4f1e8');
    const amber = new THREE.Color('#f4c84a');
    const materials: THREE.Material[] = [];
    const nodeMeshes: THREE.Mesh[] = [];
    const lines: THREE.Line[] = [];
    const focusState = { yaw: -0.12, pitch: -0.2, zoom: 8.6, intensity: 0.72 };

    const positions = [
      [0, 0, 0],
      [-2.9, 1.05, 0.16],
      [2.55, 1.28, -0.12],
      [-2.1, -1.42, 0.2],
      [2.35, -1.15, 0.16],
      [0.1, 2.22, -0.24],
      [0, -2.4, -0.12],
    ] as Array<[number, number, number]>;

    const modeTargets = {
      workflow: { node: 1, yaw: -0.18, pitch: -0.16, zoom: 8.35, intensity: 0.78 },
      governance: { node: 4, yaw: 0.2, pitch: -0.28, zoom: 8.05, intensity: 0.88 },
      delivery: { node: 5, yaw: 0.02, pitch: -0.08, zoom: 8.15, intensity: 0.94 },
    } as const;

    const createNodeMaterial = (color: THREE.Color, opacity: number) => {
      const material = new THREE.MeshBasicMaterial({
        color,
        transparent: true,
        opacity,
        depthWrite: false,
      });
      materials.push(material);
      return material;
    };

    positions.forEach((position, index) => {
      const color = index === 0 ? mint : index % 3 === 0 ? amber : index % 2 === 0 ? blue : ivory;
      const core = new THREE.Mesh(
        new THREE.SphereGeometry(index === 0 ? 0.13 : 0.075, 24, 24),
        createNodeMaterial(color, index === 0 ? 1 : 0.86)
      );
      core.position.set(...position);
      core.userData.focusScale = index === 0 ? 1.2 : 1;
      group.add(core);
      nodeMeshes.push(core);

      const aura = new THREE.Mesh(
        new THREE.SphereGeometry(index === 0 ? 0.54 : 0.34, 24, 24),
        createNodeMaterial(color, index === 0 ? 0.12 : 0.07)
      );
      aura.position.set(...position);
      aura.userData.focusScale = index === 0 ? 1.05 : 0.9;
      group.add(aura);
      nodeMeshes.push(aura);
    });

    const createLine = (a: [number, number, number], b: [number, number, number], color = mint) => {
      const material = new THREE.LineBasicMaterial({
        color,
        transparent: true,
        opacity: 0.18,
      });
      materials.push(material);
      const line = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(...a), new THREE.Vector3(...b)]),
        material
      );
      line.userData.focusOpacity = 0.18;
      group.add(line);
      lines.push(line);
      return line.geometry;
    };

    const geometries: THREE.BufferGeometry[] = [];
    positions.slice(1).forEach((position, index) => {
      geometries.push(createLine(positions[0], position, index % 2 === 0 ? mint : ivory));
    });
    geometries.push(createLine(positions[1], positions[4], blue));
    geometries.push(createLine(positions[2], positions[3], amber));
    geometries.push(createLine(positions[5], positions[6], mint));

    const particleCount = 860;
    const particlePositions = new Float32Array(particleCount * 3);
    const particleColors = new Float32Array(particleCount * 3);
    for (let i = 0; i < particleCount; i += 1) {
      const r = 0.8 + Math.random() * 3.8;
      const a = Math.random() * Math.PI * 2;
      const z = (Math.random() - 0.5) * 1.3;
      particlePositions[i * 3] = Math.cos(a) * r;
      particlePositions[i * 3 + 1] = Math.sin(a) * r * 0.64;
      particlePositions[i * 3 + 2] = z;

      const color = i % 13 === 0 ? amber : i % 7 === 0 ? blue : i % 5 === 0 ? ivory : mint;
      particleColors[i * 3] = color.r;
      particleColors[i * 3 + 1] = color.g;
      particleColors[i * 3 + 2] = color.b;
    }

    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
    particleGeometry.setAttribute('color', new THREE.BufferAttribute(particleColors, 3));
    const particles = new THREE.Points(
      particleGeometry,
      new THREE.PointsMaterial({
        size: 0.021,
        vertexColors: true,
        transparent: true,
        opacity: 0.66,
        depthWrite: false,
      })
    );
    group.add(particles);

    const rings = [1.25, 2.25, 3.25].map((radius, index) => {
      const material = new THREE.MeshBasicMaterial({
        color: index === 1 ? blue : mint,
        transparent: true,
        opacity: index === 1 ? 0.08 : 0.12,
        side: THREE.DoubleSide,
        depthWrite: false,
      });
      materials.push(material);
      const ring = new THREE.Mesh(new THREE.TorusGeometry(radius, 0.007, 12, 180), material);
      ring.rotation.x = Math.PI / 2 + index * 0.18;
      ring.rotation.y = index * 0.22;
      group.add(ring);
      return ring;
    });

    const focusField = (id: keyof typeof modeTargets | string) => {
      const target = modeTargets[id as keyof typeof modeTargets] || modeTargets.workflow;
      gsap.to(focusState, {
        yaw: target.yaw,
        pitch: target.pitch,
        zoom: target.zoom,
        intensity: target.intensity,
        duration: reducedMotion ? 0 : 0.72,
        ease: 'power3.out',
      });

      nodeMeshes.forEach((node, index) => {
        const pairIndex = Math.floor(index / 2);
        const isCore = pairIndex === 0;
        const isTarget = pairIndex === target.node;
        gsap.to(node.userData, {
          focusScale: isTarget ? 1.52 : isCore ? 1.18 : 0.94,
          duration: reducedMotion ? 0 : 0.48,
          ease: 'back.out(1.5)',
        });
      });

      lines.forEach((line, index) => {
        gsap.to(line.userData, {
          focusOpacity: index === target.node - 1 ? 0.54 : index < 6 ? 0.2 : 0.13,
          duration: reducedMotion ? 0 : 0.4,
          ease: 'power2.out',
        });
      });
    };

    const onMode = (event: Event) => {
      const modeEvent = event as CustomEvent<{ id: keyof typeof modeTargets }>;
      focusField(modeEvent.detail.id);
    };
    document.addEventListener('trust-field-mode', onMode as EventListener);
    focusField('workflow');

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const width = Math.max(rect.width, 1);
      const height = Math.max(rect.height, 1);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      group.scale.setScalar(window.innerWidth < 760 ? 0.7 : 1);
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    const pointer = { x: 0, y: 0 };
    const onPointerMove = (event: PointerEvent) => {
      pointer.x = (event.clientX / window.innerWidth - 0.5) * 0.16;
      pointer.y = (event.clientY / window.innerHeight - 0.5) * 0.12;
    };
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    if (!reducedMotion) {
      gsap.from('[data-why-reveal]', {
        opacity: 0,
        y: 24,
        duration: 0.84,
        ease: 'power3.out',
        stagger: 0.12,
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            gsap.to(entry.target, {
              opacity: 1,
              y: 0,
              duration: 0.66,
              ease: 'power3.out',
            });
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.18 }
      );

      document.querySelectorAll('[data-why-card]').forEach((element) => {
        gsap.set(element, { opacity: 0, y: 24 });
        observer.observe(element);
      });
    }

    const start = window.performance.now();
    let frame = 0;
    const render = () => {
      const t = (window.performance.now() - start) / 1000;
      if (!reducedMotion) {
        group.rotation.y += (focusState.yaw + pointer.x - group.rotation.y) * 0.025;
        group.rotation.x += (focusState.pitch + pointer.y - group.rotation.x) * 0.024;
        camera.position.z += (focusState.zoom - camera.position.z) * 0.035;
        particles.rotation.z -= 0.00065;
        particles.rotation.y += 0.00038;
        (particles.material as THREE.PointsMaterial).opacity +=
          (focusState.intensity - (particles.material as THREE.PointsMaterial).opacity) * 0.035;
        rings.forEach((ring, index) => {
          ring.rotation.z = t * (0.045 + index * 0.018);
        });
        nodeMeshes.forEach((node, index) => {
          const pulse = Math.sin(t * 1.55 + index * 0.42) * 0.045;
          node.scale.setScalar((node.userData.focusScale ?? 1) + pulse);
        });
        lines.forEach((line, index) => {
          const material = line.material as THREE.LineBasicMaterial;
          material.opacity = (line.userData.focusOpacity ?? 0.18) + Math.sin(t * 1.2 + index) * 0.025;
        });
      }
      renderer.render(scene, camera);
      frame = window.requestAnimationFrame(render);
    };
    render();

    document.addEventListener('astro:before-swap', () => {
      window.cancelAnimationFrame(frame);
      window.removeEventListener('resize', resize);
      window.removeEventListener('pointermove', onPointerMove);
      document.removeEventListener('trust-field-mode', onMode as EventListener);
      renderer.dispose();
      geometries.forEach((geometry) => geometry.dispose());
      particleGeometry.dispose();
      materials.forEach((material) => material.dispose());
    });
  }
</script>

<style>
  .why-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 18% 14%, rgba(0, 229, 160, 0.12), transparent 30rem),
      radial-gradient(circle at 82% 18%, rgba(124, 139, 255, 0.1), transparent 30rem),
      linear-gradient(135deg, #000 0%, #080812 56%, #000 100%);
    color: var(--ma-text);
  }

  .why-hero {
    position: relative;
    min-height: 92vh;
    padding: 7.5rem 0 4rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid rgba(244, 241, 232, 0.1);
  }

  .trust-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.82;
  }

  .why-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.12;
    background-image:
      linear-gradient(rgba(244, 241, 232, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 241, 232, 0.04) 1px, transparent 1px);
    background-size: 74px 74px;
    mask-image: radial-gradient(ellipse 78% 70% at 62% 45%, black, transparent 86%);
  }

  .why-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(360px, 0.58fr);
    gap: 4rem;
    align-items: end;
  }

  .why-copy h1 {
    max-width: 840px;
    margin-bottom: 1.3rem;
    color: #f4f1e8;
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .why-copy p {
    max-width: 690px;
    color: #d8d6ce;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .why-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .trust-console {
    position: relative;
    overflow: hidden;
    padding: 1.2rem;
    border: 1px solid rgba(244, 241, 232, 0.14);
    border-radius: var(--ma-radius);
    background:
      radial-gradient(circle at 30% 18%, rgba(0, 229, 160, 0.12), transparent 16rem),
      rgba(5, 5, 9, 0.68);
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.34);
    backdrop-filter: blur(14px);
  }

  .trust-console::before {
    content: '';
    position: absolute;
    inset: 1rem;
    border: 1px solid rgba(0, 229, 160, 0.08);
    border-radius: 6px;
    pointer-events: none;
  }

  .trust-console-top {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.35rem;
    margin-bottom: 1rem;
    color: var(--ma-text-dim);
    font-family: var(--ma-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .trust-console-top strong,
  .trust-readout strong {
    color: var(--ma-mint);
    font-weight: 500;
  }

  .trust-console-core {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.7rem;
  }

  .trust-mode {
    display: grid;
    gap: 0.35rem;
    min-height: 82px;
    padding: 0.9rem;
    border: 1px solid rgba(244, 241, 232, 0.12);
    border-radius: var(--ma-radius);
    background: rgba(17, 17, 34, 0.6);
    color: #d8d6ce;
    cursor: pointer;
    text-align: left;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .trust-mode span {
    color: #f4f1e8;
    font-family: var(--ma-font-display);
    font-size: 1rem;
    font-weight: 700;
  }

  .trust-mode strong {
    color: var(--ma-text-dim);
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .trust-mode:hover,
  .trust-mode:focus-visible,
  .trust-mode.active {
    border-color: rgba(0, 229, 160, 0.62);
    background: rgba(0, 229, 160, 0.1);
    transform: translateX(4px);
    outline: none;
  }

  .trust-readout {
    position: relative;
    z-index: 1;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(244, 241, 232, 0.12);
    font-family: var(--ma-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .trust-readout span {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--ma-text-dim);
  }

  .trust-signal-section {
    background: rgba(17, 17, 34, 0.52);
    border-bottom: 1px solid var(--ma-border);
  }

  .trust-signal-grid,
  .proof-band-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 4rem;
    align-items: start;
  }

  .trust-section-copy {
    position: sticky;
    top: 7rem;
  }

  .trust-section-copy h2,
  .operating-head h2,
  .proof-band h2,
  .why-cta h2 {
    color: #f4f1e8;
    letter-spacing: 0;
  }

  .trust-signal-stack {
    display: grid;
    gap: 1rem;
  }

